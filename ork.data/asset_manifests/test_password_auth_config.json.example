{
  "comment": "Example configuration for password-protected asset downloads",
  "namespaces": {
    "secure_namespace": {
      "encryption_key": "${ORK_SECURE_ENC_KEY}",
      "remote_location": "secure_cdn"
    }
  },
  "locations": {
    "secure_cdn": {
      "comment": "This location requires password authentication",
      "url": "https://secure-cdn.example.com",
      "api_key_read": "<PasswordAuthentication>",
      "api_key_write": "<PasswordAuthentication>",
      "disable_cert_check": false
    },
    "public_cdn": {
      "comment": "This location uses normal API key from environment",
      "url": "https://public-cdn.example.com",
      "api_key_read": "${ORK_PUBLIC_API_KEY}",
      "api_key_write": "${ORK_PUBLIC_API_KEY}",
      "disable_cert_check": false
    },
    "mixed_auth": {
      "comment": "Password for downloads, env var for uploads",
      "url": "https://mixed-cdn.example.com",
      "api_key_read": "<PasswordAuthentication>",
      "api_key_write": "${ORK_UPLOAD_API_KEY}",
      "disable_cert_check": false
    }
  },
  "destinations": {
    "secure_namespace": "<stage>/secure"
  }
}