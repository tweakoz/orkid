       "properties": {
        "gens": [
         {
          "object": {
           "class": "ImplicitSdfGenData",
           "uuid": "a82e8e17-0f70-4b05-8a4c-70157c0b86d5",
           "properties": {
            "background": 26.844738006591797,
            "bbox_max": [
             6.0,
             10.399999618530273,
             6.0
            ],
            "bbox_min": [
             -6.0,
             -10.399999618530273,
             -6.0
            ],
            "grid_name": "sdf",
            "params": {
             "a": "float:0.250000",
             "ex": "float:6.000000",
             "ez": "float:6.000000",
             "t": "float:0.800000"
            },
            "shader": "\n// Per-voxel world-space position.\nvec3f@pp = getvoxelpws();\nfloat@xx = vec3f@pp.x;\nfloat@yy = vec3f@pp.y;\nfloat@zz = vec3f@pp.z;\n\n// Signed gap to the saddle surface y = a*x*z.\nfloat@sgn = float@yy - f$a * float@xx * float@zz;\n\n// Tangent-plane distance: |F| / |grad F|. grad(y - a*x*z) = (-a*z, 1, -a*x).\nfloat@gx = f$a * float@zz;\nfloat@gz = f$a * float@xx;\nfloat@gm = sqrt(1.0 + float@gx*float@gx + float@gz*float@gz);\nfloat@slab = abs(float@sgn / float@gm) - f$t * 0.5;\n\n// Clip the saddle to a finite (x, z) extent \u2014 box intersection.\nfloat@bx = abs(float@xx) - f$ex;\nfloat@bz = abs(float@zz) - f$ez;\nfloat@box = max(float@bx, float@bz);\n\n// SDF = max(slab, box). Negative inside both \u2192 solid; positive elsewhere.\nf@sdf = max(float@slab, float@box);\n",
            "voxel_size": 0.05000000074505806,
            "asset_name": "saddle_sdf"
           }
          }
