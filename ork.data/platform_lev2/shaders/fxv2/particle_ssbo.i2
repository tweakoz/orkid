///////////////////////////////////////////////////////////////
// particle_ssbo.i2 — the SSBO particle VERTEX machinery, factored out of
// particle_comshader.i2 so GENERATED freestyle-particle shaders (the
// FreestyleParticleMaterial shader_path override / HyperSyn fragment DSL)
// can import the storage block + vfaces + vertex shaders WITHOUT pulling
// in the stock techniques (duplicate technique names). particle.fxv2
// imports this BEFORE particle_comshader.i2 (same concatenation order
// as when this text lived at the top of that file).
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// Particle data structure in SSBO
// Using vec4 for alignment safety
///////////////////////////////////////////////////////////////
storage_interface storage_particles (descriptor_set 0) {
  buffer layout(std430) particles {
    vec4 camRightSize;             // 0:  xyz=camRight (sprites) / camPos (streaks), .w unused
    vec4 camUpCount;               // 16: xyz=camUp, w=numParticles (as float)
    vec4 materialParams;           // 32: x=gradient_phase (GradientAtlasMaterial only), yzw=reserved
    vec4 particleData[262144];     // 48: pos.xyz, size (per particle)
    vec4 particleData2[262144];    //     vel.xyz, length (per particle, for streaks)
    vec4 particleData3[262144];    //     age, random, aux.x, aux.y (per particle)
    vec4 gradientLUT[256];         //     256-entry gradient ramp (RGBA), written per-frame by
                                   //     the renderer; the VS samples it by unit_age into frg_clr.
                                   //     White for non-gradient materials (frg_clr pass-through).
  };
}

///////////////////////////////////////////////////////////////
// SINGLE-PASS STEREO per-view state. Declared here rather than imported because
// this file's shaders do not pull stdtools.i2; the LAYOUT must stay identical to
// the ublk_stereo declared there — it is the same buffer, written by the one
// production writer (PBRMaterial::writeStereoBlock).
///////////////////////////////////////////////////////////////
uniform_block ublk_stereo (descriptor_set 0) {
  mat4 spvr_vp[2];
  mat4 spvr_inv_vp[2];
  vec4 spvr_eyepos[2];
}

///////////////////////////////////////////////////////////////
// Vertex interface for SSBO-based sprite rendering
///////////////////////////////////////////////////////////////
vertex_interface vface_sprite_ssbo
  : ublk_vtx
  : storage_particles {
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;  // x=age, y=random, z=aux.x, w=aux.y
  }
}

vertex_interface vface_sprite_ssbo_ST
  : ublk_vtx
  : ublk_stereo
  : storage_particles {
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;
  }
}

///////////////////////////////////////////////////////////////
// Vertex interface for SSBO-based streak rendering
///////////////////////////////////////////////////////////////
vertex_interface vface_streak_ssbo
  : ublk_vtx
  : storage_particles {
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;  // x=age, y=random, z=aux.x, w=aux.y
  }
}

vertex_interface vface_streak_ssbo_ST
  : ublk_vtx
  : ublk_stereo
  : storage_particles {
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;
  }
}

///////////////////////////////////////////////////////////////
// The particle vertex GEOMETRY, factored out of the vertex stages so the mono and
// single-pass-stereo stages differ in exactly ONE line — the clip transform. Keeping
// the billboard/streak construction in one place is what makes that claim checkable:
// a stereo variant that drifted from its mono twin would be a per-eye geometry
// difference, which is the one thing an eye-for-eye parity gate cannot distinguish
// from a genuine bug.
///////////////////////////////////////////////////////////////
typeblock typ_ptc_ssbo_vtx {
  struct PtcVtx {
    vec3 wpos;
    vec4 clr;
    vec2 uv0;
    vec4 uv1;
  };
}

libblock lib_ptc_ssbo_vtx : typ_ptc_ssbo_vtx {

  PtcVtx computeSpriteVtx() {
    PtcVtx rval;

  // 6 vertices per particle (2 triangles)
  int particleIdx = gl_VertexIndex / 6;
  int cornerIdx = gl_VertexIndex % 6;

  // Read camera vectors from SSBO
  vec3 camRight = camRightSize.xyz;
  vec3 camUp = camUpCount.xyz;

  // Read particle data from SSBO
  vec4 pd1 = particleData[particleIdx];   // pos.xyz, size
  vec4 pd3 = particleData3[particleIdx];  // age, random, aux.x, aux.y

  vec3 pos = pd1.xyz;
  float size = pd1.w;
  float age = pd3.x;
  float random = pd3.y;
  // aux.x gets the per-frame gradient_phase added in so the fragment can
  // sample the atlas with a single fract() — keeps the frag shader trivial.
  vec2 aux_xy = vec2(pd3.z + materialParams.x, pd3.w);

  // Billboard corner offsets (2 triangles = 6 vertices)
  // Triangle 1: 0,1,2  Triangle 2: 3,4,5 (same as 0,2,3)
  const vec2 offsets[6] = vec2[6](
    vec2(-1.0, -1.0),  // 0: bottom-left
    vec2( 1.0, -1.0),  // 1: bottom-right
    vec2( 1.0,  1.0),  // 2: top-right
    vec2(-1.0, -1.0),  // 3: bottom-left (same as 0)
    vec2( 1.0,  1.0),  // 4: top-right (same as 2)
    vec2(-1.0,  1.0)   // 5: top-left
  );

  const vec2 uvs[6] = vec2[6](
    vec2(0.0, 0.0),
    vec2(1.0, 0.0),
    vec2(1.0, 1.0),
    vec2(0.0, 0.0),
    vec2(1.0, 1.0),
    vec2(0.0, 1.0)
  );

  vec2 offset = offsets[cornerIdx];

  // Compute billboard position using camera vectors
  vec3 worldPos = pos + offset.x * camRight * size + offset.y * camUp * size;
    rval.wpos = worldPos;
    rval.clr  = gradientLUT[clamp(int(age * 256.0), 0, 255)]; // gradient ramp (white if none)
    rval.uv0  = uvs[cornerIdx];
    rval.uv1  = vec4(age, random, aux_xy);
    return rval;
  }

  PtcVtx computeStreakVtx() {
    PtcVtx rval;

  // 6 vertices per particle (2 triangles)
  int particleIdx = gl_VertexIndex / 6;
  int cornerIdx = gl_VertexIndex % 6;

  // Read camera position and up from SSBO
  vec3 camPos = camRightSize.xyz;  // For streaks: camPos stored here
  vec3 camUp = camUpCount.xyz;

  // Read particle data from SSBO
  vec4 pd1 = particleData[particleIdx];   // pos.xyz, width
  vec4 pd2 = particleData2[particleIdx];  // vel.xyz, length
  vec4 pd3 = particleData3[particleIdx];  // age, random, aux.x, aux.y

  vec3 pos = pd1.xyz;
  float width = pd1.w;
  vec3 vel = pd2.xyz;
  float len = pd2.w;
  float age = pd3.x;
  float random = pd3.y;
  // aux.x gets the per-frame gradient_phase added in so the fragment can
  // sample the atlas with a single fract() — keeps the frag shader trivial.
  vec2 aux_xy = vec2(pd3.z + materialParams.x, pd3.w);

  // Compute streak quad corners
  // Streak goes from pos (head) to pos - vel*length (tail)
  // Use raw velocity (not normalized) to match GL behavior where streak length
  // depends on velocity magnitude: tailPos = pos - vel * len
  vec3 tailPos = pos - vel * len;

  // Cross product with view direction to get camera-facing side
  vec3 velDir = normalize(vel);
  vec3 viewDir = normalize(pos - camPos);
  vec3 side = normalize(cross(velDir, viewDir)) * width;

  // Fallback if velDir parallel to viewDir
  if (length(side) < 0.001) {
    side = normalize(cross(velDir, camUp)) * width;
  }

  // 4 corners: head+side, head-side, tail-side, tail+side
  // Triangle 1: 0,1,2  Triangle 2: 0,2,3
  vec3 corners[4];
  corners[0] = pos + side;      // head right
  corners[1] = pos - side;      // head left
  corners[2] = tailPos - side;  // tail left
  corners[3] = tailPos + side;  // tail right

  const int indices[6] = int[6](0, 1, 2, 0, 2, 3);
  const vec2 uvs[4] = vec2[4](
    vec2(1.0, 0.0),  // head right
    vec2(0.0, 0.0),  // head left
    vec2(0.0, 1.0),  // tail left
    vec2(1.0, 1.0)   // tail right
  );

  int idx = indices[cornerIdx];
  vec3 worldPos = corners[idx];
    rval.wpos = worldPos;
    rval.clr  = gradientLUT[clamp(int(age * 256.0), 0, 255)];
    rval.uv0  = uvs[idx];
    rval.uv1  = vec4(age, random, aux_xy);
    return rval;
  }
}

///////////////////////////////////////////////////////////////
// Sprite vertex shader - billboards using SSBO data
///////////////////////////////////////////////////////////////
vertex_shader vs_sprite_ssbo : vface_sprite_ssbo : lib_ptc_ssbo_vtx {
  PtcVtx pv  = computeSpriteVtx();
  gl_Position = MatMVP * vec4(pv.wpos, 1.0);
  frg_clr = pv.clr;
  frg_uv0 = pv.uv0;
  frg_uv1 = pv.uv1;
}

///////////////////////////////////////////////////////////////
// ...and its SINGLE-PASS STEREO twin. MatMVP is per-DRAW (VP*M) and ublk_stereo is
// per-FRAME view state with no model in it, so the product is formed here from the
// per-view vp and the draw's own model matrix. Index-select on the multiview view
// selector, never a branch.
///////////////////////////////////////////////////////////////
vertex_shader vs_sprite_ssbo_ST : vface_sprite_ssbo_ST : lib_ptc_ssbo_vtx {
  PtcVtx pv  = computeSpriteVtx();
  gl_Position = (spvr_vp[ofx_viewIndex] * MatM) * vec4(pv.wpos, 1.0);
  frg_clr = pv.clr;
  frg_uv0 = pv.uv0;
  frg_uv1 = pv.uv1;
}

///////////////////////////////////////////////////////////////
// Streak vertex shader - velocity-aligned quads using SSBO data
///////////////////////////////////////////////////////////////
vertex_shader vs_streak_ssbo : vface_streak_ssbo : lib_ptc_ssbo_vtx {
  PtcVtx pv  = computeStreakVtx();
  gl_Position = MatMVP * vec4(pv.wpos, 1.0);
  frg_clr = pv.clr;
  frg_uv0 = pv.uv0;
  frg_uv1 = pv.uv1;
}

///////////////////////////////////////////////////////////////
vertex_shader vs_streak_ssbo_ST : vface_streak_ssbo_ST : lib_ptc_ssbo_vtx {
  PtcVtx pv  = computeStreakVtx();
  gl_Position = (spvr_vp[ofx_viewIndex] * MatM) * vec4(pv.wpos, 1.0);
  frg_clr = pv.clr;
  frg_uv0 = pv.uv0;
  frg_uv1 = pv.uv1;
}
