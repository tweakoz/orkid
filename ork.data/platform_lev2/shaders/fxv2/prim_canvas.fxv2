///////////////////////////////////////////////////////////////
// PrimCanvas shader - GPU-accelerated canvas widget
///////////////////////////////////////////////////////////////

fxconfig fxcfg_default {
  glsl_version = "450";
  import "prim_canvas.i2";
}

///////////////////////////////////////////////////////////////
// Techniques
///////////////////////////////////////////////////////////////

technique tek_canvas_solid {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_canvas_quad;
    fragment_shader = fs_canvas_solid;
    state_block     = sb_canvas_blend;
  }
}

technique tek_canvas_tex {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_canvas_quad;
    fragment_shader = fs_canvas_tex;
    state_block     = sb_canvas_blend;
  }
}

///////////////////////////////////////////////////////////////
// Vertex-based techniques (tristrip, trilist)
///////////////////////////////////////////////////////////////

technique tek_canvas_vtx_solid {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_canvas_vertex;
    fragment_shader = fs_canvas_solid;
    state_block     = sb_canvas_blend;
  }
}

technique tek_canvas_vtx_tex {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_canvas_vertex;
    fragment_shader = fs_canvas_tex;
    state_block     = sb_canvas_blend;
  }
}

///////////////////////////////////////////////////////////////
// Sprite instancing techniques
///////////////////////////////////////////////////////////////

technique tek_sprite_solid {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_quad;
    fragment_shader = fs_canvas_solid;
    state_block     = sb_canvas_blend;
  }
}

technique tek_sprite_tex {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_quad;
    fragment_shader = fs_canvas_tex;
    state_block     = sb_canvas_blend;
  }
}
