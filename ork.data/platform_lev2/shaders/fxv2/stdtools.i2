///////////////////////////////////////////////////////////////

uniform_block ublk_std_matrices (descriptor_set 0) {
  mat4 m;
  mat4 v;
  mat4 p;
  mat4 mv;
  mat4 vp;
  mat4 mvp;
  mat3 mrot;
  //
  mat4 inv_v;
  mat4 inv_p;
  mat4 inv_vp;
  //
  // model-view INVERSE-TRANSPOSE (normal matrix, object->view). Bound per-draw in
  // material_pbr_pipeline.cpp::createBasicStateLambda(). mvit_rot is its 3x3 — the
  // one used for normals (view-space normal = normalize(mvit_rot * object_normal));
  // the full mat4 is kept for callers that transform more than a direction. Appended
  // at the END so existing std140 offsets are unchanged.
  mat4 mvit;
  mat3 mvit_rot;
}
//
///////////////////////////////////////////////////////////////
uniform_set uset_std_viewport {
  vec2 ViewportSize;    // target size
  vec2 InvViewportSize; // inverse target size
}
///////////////////////////////////////////////////////////////
uniform_block ublk_std_viewport (descriptor_set 0) {
  vec2 ViewportSize;    // target size
  vec2 InvViewportSize; // inverse target size
}
///////////////////////////////////////////////////////////////
// deprecated texture-based instancing (keeping for reference)
sampler_set sset_std_instancing(descriptor_set 0) {
  sampler2D InstanceMatrices;
  sampler2D InstanceColors;
  usampler2D InstanceIds;
}
///////////////////////////////////////////////////////////////
// SSBO-based instancing. The fixed array sizes here ARE the layout contract with
// InstancedDrawable::k_max_instances / k_ssbo_offset_* (drawable.h) — the two MUST
// agree or the colors/pickids reads land at the wrong byte offsets (a 1Mi-vs-128Ki
// divergence here made every instanced-model draw read instance_color = 0 -> BLACK).
// matrices/colors are fixed-size so their std430 offsets match the C++; only the
// LAST member may be a size-less runtime array in std430 (the bound SSBO sizes it).
storage_interface storage_instancing (descriptor_set 0) {
  buffer layout(std430) instances {
    mat4 _instance_matrices[131072];  // 64B * 128Ki = 8388608  (offset 0)
    vec4 _instance_colors[131072];    // 16B * 128Ki = 2097152  (offset 8388608)
    uvec2 _instance_pickids[];        // runtime array          (offset 10485760)
  };
}
///////////////////////////////////////////////////////////////
uniform_set uset_std_filtering {
  float FilterRadius;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_std_filtering (descriptor_set 0) {
  float FilterRadius;
}
///////////////////////////////////////////////////////////////
uniform_set uset_std_pick {
  uint obj_pickID;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_std_depth(descriptor_set 0) {
  vec2 Zndc2eye;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_std_pbr(descriptor_set 0) {
  //////////////////////////////
  vec3 AmbientLevel;          // 0x00
  vec3 EyePostion;            // 0x10  (mono; the multiview variant redirects it per view)
  vec4 ModColor;              // 0x20 — POST-multiplicative output tint
  vec4 ModAlbedo;             // 0x30 — per-material albedo multiplier
  //////////////////////////////
  float MetallicFactor;       // 0x40
  float RoughnessFactor;      // 0x44
  float RoughnessPower;       // 0x48
  float SkyboxLevel;          // 0x4c
  float SpecularLevel;        // 0x50
  float DiffuseLevel;         // 0x54
  float EnvironmentMipBias;   // 0x58
  float EnvironmentMipScale;  // 0x5c
  float RoughnessLevels;      // 0x60
  float SpecularMipBias;      // 0x64
  float DepthFogDistance;     // 0x68
  float DepthFogPower;        // 0x6c
  //////////////////////////////
  vec4 AuxA;                  // 0x70
  vec4 AuxB;                  // 0x80
  //////////////////////////////
  float AlphaCutoff;          // 0x90
  // procedural-refilter crossfade: 0 = the outgoing (Prev) IBL only, 1 = the
  // newly published one. Pinned at 1 outside a fade window, where the binder
  // also aliases the Prev samplers onto the current maps.
  float EnvBlendWeight;       // 0x94
  // procedural-capture PRE-SCALE, already inverted (see lib_env_decode).
  float EnvCaptureScaleInv;   // 0x98
  // AMBIENT gate: 1 = EnvSH below carries this frame's sky, 0 = the binder had
  // no projection to give (and said so out loud on the C++ side). There is no
  // other ambient source to fall back to, so a 0 here IS the absence of
  // ambient light, never a quiet switch to a second path.
  float EnvSHValid;           // 0x9c
  // The sky's nine L2 coefficients, RADIANCE integrals, already decoded and
  // already crossfaded on the CPU (see lib_env_sh). Procedural probe or
  // authored map — one pipeline, one seam (CommonStuff::envSHCoeffs).
  vec4 EnvSH[9];              // 0xa0 .. 0x130
  // DIRECT DIFFUSE BRDF selector — an ordinal into lib_brdf::diffuseBRDF
  // (0 lambert / 1 oren-nayar / 2 burley), NOT a crc. Appended at the END so
  // every std140 offset above is unchanged. Bound on every PBR draw by
  // createBasicStateLambda, from CommonStuff::_diffuseBrdfModel.
  int DiffuseBrdfModel;       // 0x1e0
}

///////////////////////////////////////////////////////////////
// CAPTURE PRE-SCALE decode (procedural sky IBL).
//
// A moonless night sky is ~1e-5 of a day sky, and both the equirect snapshot
// and the prefiltered radiance maps are RGBA16F — whose minimum NORMAL is
// 6.1e-5. Night energy therefore flushed to EXACTLY zero somewhere between the
// capture and the shaded fragment, which is what made shadowed surfaces black
// at night. So the snapshot is written at a known GAIN
// (SkyAtmosphereData::_iblCaptureScale, folded into the snapshot's exposure
// bind in HillaireSky::renderEquirectSnapshot) and divided back out here.
//
// ONE encode seam, ONE decode seam, by construction: the encode is a single
// C++ bind and every read of MapSpecularEnv (and its Prev twin) comes back
// through this one function, so the factor can neither
// double-apply nor be forgotten at a site. The binder pins EnvCaptureScaleInv
// at 1.0 whenever the bound maps are NOT the procedural set — baked scenes and
// the procedural warm-up window are bit-unchanged.
//
// NOT for the reflection-probe cubes: those are captured through a different
// path that never sees the gain.
///////////////////////////////////////////////////////////////
libblock lib_env_decode : ublk_std_pbr {
  vec3 env_decodeCapture(vec3 radiance) {
    return radiance * EnvCaptureScaleInv;
  }
}

///////////////////////////////////////////////////////////////
// SKY SH PROBE — diffuse irradiance from nine L2 coefficients.
//
// EnvSH holds RADIANCE integrals L_i = integral L(d) Y_i(d) dw over the sky
// snapshot (ProbeSHProjector, same basis and same order as probe_sh.h). The
// COSINE CONVOLUTION is the per-band factor Ahat_l / pi applied here:
//   Ahat_0 = pi, Ahat_1 = 2pi/3, Ahat_2 = pi/4
// and the whole thing is divided by pi because what the shading code wants is
// an average incident RADIANCE (E/pi), which is what the prefiltered diffuse
// map delivered and what gets multiplied by base color with no 1/pi of its own.
// So the band weights collapse to 1, 2/3, 1/4.
//
// This is the ONLY convolution in the diffuse path now: the GGX-importance
// lobe the prefiltered equirect map was built with (an approximation of a
// clamped cosine, read at a coarse mip) does not exist any more — not on the
// procedural path, not on the authored one, and not in the bake.
//
// The clamp is not cosmetic. A truncated L2 series of a high-contrast sky rings
// negative away from the bright lobe, and a negative irradiance would subtract
// light from whatever else lit the fragment.
///////////////////////////////////////////////////////////////
libblock lib_env_sh : ublk_std_pbr {
  vec3 env_shIrradiance(vec3 n) {
    vec3 acc = EnvSH[0].xyz * 0.2820948;
    acc += (EnvSH[1].xyz * (0.4886025 * n.y)
          + EnvSH[2].xyz * (0.4886025 * n.z)
          + EnvSH[3].xyz * (0.4886025 * n.x)) * 0.6666667;
    acc += (EnvSH[4].xyz * (1.0925484 * n.x * n.y)
          + EnvSH[5].xyz * (1.0925484 * n.y * n.z)
          + EnvSH[6].xyz * (0.3153916 * (3.0 * n.z * n.z - 1.0))
          + EnvSH[7].xyz * (1.0925484 * n.x * n.z)
          + EnvSH[8].xyz * (0.5462742 * (n.x * n.x - n.y * n.y))) * 0.25;
    return max(acc, vec3(0.0));
  }
}

///////////////////////////////////////////////////////////////
// PBR2 Phase 2 — glTF KHR-extension lobe uniforms.
//
// One UBO per extension. Each lobe's libblock inherits ONLY its own
// UBO, so layout drift in one extension can't affect another (the bug
// that bit diffuse_transmission_color when everything was crammed into
// a single block). Within each UBO: strict std140 order — vec4 first,
// floats second, ints last. Colors use vec4 (.rgb in shader; alpha
// unused) to dodge vec3 alignment ambiguity entirely.
///////////////////////////////////////////////////////////////
// Cross-lobe state — currently just the probe-capture gate. Lobes that
// need it (transmission, volume) inherit ublk_pbr_state.
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_state(descriptor_set 0) {
  int rendering_probe;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_transmission(descriptor_set 0) {
  float transmission_factor;
  // P3.D — separate roughness for the refracted env sample. When
  // has_transmission_roughness is 0, the lobe falls back to surf.roughness
  // (glTF spec behavior). When set, surf.transmission_roughness drives
  // the mip level of env_cube_spec_wbias independently of the BRDF roughness.
  float transmission_roughness;
  int   has_transmission;
  int   has_transmission_roughness;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_ior(descriptor_set 0) {
  float ior_value;
  int   has_ior;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_volume(descriptor_set 0) {
  vec4  attenuation_color;
  float volume_thickness_factor;
  float attenuation_distance;
  int   has_volume;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_diffuse_transmission(descriptor_set 0) {
  vec4  diffuse_transmission_color;
  float diffuse_transmission_factor;
  int   has_diffuse_transmission;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_specular(descriptor_set 0) {
  vec4  specular_color;
  float specular_factor;
  int   has_specular;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_clearcoat(descriptor_set 0) {
  float clearcoat_factor;
  float clearcoat_roughness;
  int   has_clearcoat;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_sheen(descriptor_set 0) {
  vec4  sheen_color;
  float sheen_factor;
  float sheen_roughness;
  int   has_sheen;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_pbr_iridescence(descriptor_set 0) {
  float iridescence_factor;
  int   has_iridescence;
}
///////////////////////////////////////////////////////////////
// PBR2 Phase 3 (P3.D) — KHR_materials_subsurface (in-flight).
// Per-channel radius drives the SSSS blur kernel scale (mm; skin ~ (1.4,
// 0.5, 0.3)). factor blends the blurred diffuse back with the raw diffuse
// at SSSS-composite time. has_subsurface is the gate.
uniform_block ublk_pbr_subsurface(descriptor_set 0) {
  vec4  subsurface_color;    // .rgb tint; .a unused
  vec4  subsurface_radius;   // .rgb per-channel radius; .a unused
  float subsurface_factor;
  int   has_subsurface;
}
///////////////////////////////////////////////////////////////
sampler_set sset_std_lighting (descriptor_set 0) {
  sampler2DArray LightMapArray;            
  sampler2DArray light_cookie_colors;      
  sampler2DArray light_cookie_depths;      
  sampler2D MapDepth;           
  sampler2D MapLinearDepth;     
}
///////////////////////////////////////////////////////////////
sampler_set sset_std_pbr(descriptor_set 0) {
  //////////////////////////////
  sampler2DArray CNMREA; // slices: albedo, normal,mtlruf,emission,AO
  samplerCube reflectionPROBE;
  samplerCube RadiancePROBE;
  sampler2D MapBrdfIntegration; 
  sampler2DArray MapSpecularEnv; // 1 slice per roughness level
  // The OUTGOING specular set while a procedural refilter crossfades
  // (EnvBlendWeight ramps from 0 to 1 across the window). Outside a fade the
  // binder aliases this to the one above, so sampling it is never a special
  // case. There is no diffuse twin: the ambient is nine coefficients whose
  // crossfade is resolved on the CPU (EnvSH below).
  sampler2DArray MapSpecularEnvPrev;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_std_lighting (descriptor_set 0) {
  //////////////////////////////
  vec3 LightMapColors[8];
  //////////////////////////////
  int point_light_count;
  int spot_light_count;
  int has_reflection_probe;
}

///////////////////////////////////////////////////////////////
// SKYLIGHT lane A — dynamic directional sun + cascade shadow state.
// REAL single-buffer UBO (ub_vtx_boneblock bind pattern): written once per
// frame by the forward prologue (_update_sun_cascades, std140 offsets
// hand-mirrored there), bound per-draw in the forward lighting lambda.
// has_sun (sun_dir.w) gates ALL sun work — sunless scenes take a no-op
// branch before any sampling (byte-identity contract).
uniform_block ublk_sun (descriptor_set 0) {
  mat4 sun_shadow_matrix[5];  // per-cascade proj*view (storage 5; runtime 2..5)
  // PER-BAND SCALAR TABLES COME IN vec4 PAIRS. A vec4 holds four of them and the
  // ladder reserves five, so every such table is a base vec4 (bands 0..3) plus a
  // _hi vec4 whose .x is band 4. Read them through lib_sun_air's
  // _sun_band_value(lo, hi, i) — indexing either half directly is how the two
  // sides drift. (float[5] was the alternative and std140 pads it to 80 bytes.)
  vec4 sun_split_distances;   // per-band SELECT radius (world meters from the anchor below), bands 0..3
  vec4 sun_split_distances_hi;// ... band 4 in x
  vec4 sun_dir;               // xyz = sunlight travel direction, w = has_sun
  vec4 sun_color;             // rgb = color, w = intensity
  vec4 sun_shadow_params;     // x = constant depth bias in WORLD METRES (the evaluator divides it by
                              // the band's own fitted depth range — one slack distance for every band,
                              // which an ndc constant cannot be), y = pcf radius(texels),
                              // z = cascade count, w = texel size(uv)
  vec4 sun_cascade_basis;     // xyz = BAND ANCHOR (viewer position the world bands were fit around,
                              // mono prologue cam). NOTHING here may carry an orientation — the bands
                              // are view-independent and a turn must stay free.
  vec4 sun_cascade_texel;     // bands 0..3 1/dim. PER-BAND RESOLUTION (S2b): the array is one allocation
                              // at the near band's dim (= sun_shadow_params.w) and an outer band is
                              // rendered into the top-left dim² corner of its slice, so that band's uv
                              // scale is sun_shadow_params.w/sun_cascade_texel[i] and its WORLD texel
                              // size derives from sun_cascade_texel[i]. All of them equal
                              // sun_shadow_params.w = every band full dim = the shipped path, scale 1.
                              // (This vec4 sits where sun_cascade_basis[1] was reserved.)
  vec4 sun_cascade_texel_hi;  // ... band 4's 1/dim in x
  // DIRECTIONAL COOKIE (cloud shadows). Cookies were spot-only; the sun needs one
  // because a cloud deck occludes the whole world, not a cone, and it sits far
  // outside any cascade. The cookie is a TRANSMITTANCE map in the light's own
  // plane: matrix takes a WORLD position to cookie uv, params.x arms it (0 =
  // absent -> the branch never samples and the frame is byte-identical), params.y
  // scales its strength, params.z is the sample lod (softness lives here).
  mat4 sun_cookie_matrix;
  vec4 sun_cookie_params;     // x = enable, y = strength, z = GROUND lod, w = extinction tau (Beer-Lambert)
  // SNAPSHOT FLIP CROSSFADE (S2a). A cascade snapshot is double-buffered as two
  // SLICE RANGES of the one depth array; on a flip the shader computes the
  // shadow FACTOR from both the outgoing and incoming snapshot and lerps them
  // (depth values themselves cannot be blended). The previous snapshot needs
  // its own fit to be sampled at all — its matrices, its select radii and the
  // anchor they were fit around. APPENDED, so every offset above is unchanged.
  //
  // sun_shadow_fade.x == 0 (the shipped default, and every frame outside a
  // fade window) makes the prev half unreachable: one branch, no sampling.
  //
  // MEMBER ORDER IS LOAD-BEARING: the mat4 ARRAY goes LAST. The offset the
  // engine's block reflection assigns to whatever FOLLOWS a mat4[] is rounded
  // up to 64 (the element size), which plain std140 does not do — a member
  // placed after this array lands at an offset the host writes and the shader
  // reads differently, and the symptom is silently-wrong data with no error
  // (measured: the prev-snapshot split radii read as zero -> every band test
  // failed -> the whole crossfade sampled as unshadowed). With the array last
  // there is nothing after it and both rules agree on every member.
  vec4 sun_split_distances_prev;
  vec4 sun_split_distances_prev_hi; // ... band 4 in x
  vec4 sun_cascade_basis_prev; // xyz = the PREVIOUS snapshot's band anchor
  vec4 sun_shadow_fade;        // x = prev weight (0=current only), y = current slice base,
                               // z = prev slice base, w = unused
  // SKY BACKGROUND LUMINANCE — the measured mean of the published environment
  // (RadianceMaps::_measuredLuminance, decoded). A SKY quantity, and it rides
  // this block because this is the per-frame skylight state every forward draw
  // already binds. It is deliberately NOT a function of whatever body owns the
  // sun slot above: after the night caster handoff that slot carries the MOON,
  // and anything that reads "is it night" off it is keyed to the wrong body.
  // Written on EVERY path of the prologue write, sunless ones included.
  vec4 sky_ambient;           // x = background luminance, yzw = unused
  // HOW MUCH OF EACH SHADOW FACTOR THE AMBIENT/IBL TERM TAKES. A shadow factor
  // scales the DIRECT beam; whether the sky term goes with it depends on the
  // solid angle the occluder covers. A CLOUD covers a broad wedge of sky, so
  // its cookie must pull the env term down or it is invisible in a frame the
  // env term dominates. A TREE covers the sun disc, so the cascade must not
  // (an asserted invariant — the shadow-attribution gate). Applied to BOTH env
  // channels as mix(1, 1 - coverage, weight) for the cloud (the sky grades with
  // how much of the dome the deck takes) and mix(1, factor, weight) for the
  // cascade.
  vec4 sun_shadow_ibl_weights; // x = cloud cookie -> IBL, y = cascade -> IBL, zw = unused
  mat4 sun_shadow_matrix_prev[5];

}
///////////////////////////////////////////////////////////////
sampler_set sset_sun (descriptor_set 0) {
  sampler2DArray sun_shadow_map; // Z32F cascade depth array (dedicated, not the spot cookie array;
                                 // 2 sets of RUNTIME-BAND-COUNT slices when a flip crossfade or an
                                 // amortized snapshot is armed — the set base arrives in
                                 // sun_shadow_fade.yz, never assumed from the storage ceiling)
  sampler2D sun_cookie;          // A = cloud OCCLUSION toward the sun (0 = unoccluded;
                                 // transmittance is 1-a). RGB is the decks' own radiance,
                                 // carried only so the map is legible in a dump.
}
///////////////////////////////////////////////////////////////
storage_interface storage_fwd_lighting (descriptor_set 0) {
  buffer layout(std430) lights {
    vec4 _lightcolor[64];    // 1024 : 1024 
    vec4 _lightsizbias[64];  // 1024 : 2048
    vec4 _lightpos[64];      // 1024 : 3072
    mat4 _shadowmatrix[64];  // 4096 : 7168
    uint _lightTexSlice[64]; // 256  : 7424
  };
}
///////////////////////////////////////////////////////////////
uniform_block ublk_deferred_lighting(descriptor_set 0) {
  vec4 LightColorD[256];   // 4096   : 4096
  mat4 LightMatrix[256];   // 163384 : 167480
  mat4 ShadowMatrix[256];  // 163384 : 330864
  float LightRadius[256];  // 1024   : 331888
}
///////////////////////////////////////////////////////////////
vertex_interface vif_PC {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
  }
  outputs {
    vec4 frg_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_PC : vif_PC {
  outputs {
    layout(location = 0) vec4 out_clr;
    layout(location = 1) vec4 out_diffuse;   // P3.B sentinel
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_PT {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv0;
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_PTT {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
    vec2 uv1 : TEXCOORD1;
  }
  outputs {
    vec2 frg_uv0;
    vec2 frg_uv1;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_T : vif_PT : ublock_frg {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_min_T : vif_PT {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_skybox : vif_PC : ublk_std_matrices : uset_std_pbr : sset_std_pbr {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
libblock lib_pbr_vtx_instanced : ublk_std_matrices : storage_instancing {
  void vs_instanced(vec4 pos, vec3 nrm, vec3 bin) {
    ////////////////////////////////
    // fetch per-instance data from SSBO
    ////////////////////////////////
    mat4 instance_matrix = _instance_matrices[gl_InstanceIndex];
    vec4 instance_color  = _instance_colors[gl_InstanceIndex];
    ////////////////////////////////
    mat3 instance_rot = mat3(instance_matrix);
    vec4 cpos         = mv * (instance_matrix * pos);
    vec3 wnormal      = normalize(instance_rot * nrm);
    vec3 wbitangent   = normalize(instance_rot * bin);
    vec3 wtangent     = cross(wbitangent, wnormal);
    frg_wpos    = m * (instance_matrix * pos);
    frg_uv0     = uv0 * vec2(1, -1);
    frg_tbn     = mat3(wtangent, wbitangent, wnormal);
    frg_camz    = wnormal.xyz;
    frg_camdist = -cpos.z;
    frg_clr     = instance_color;
  }
} // lib_pbr_vtx_instanced
///////////////////////////////////////////////////////////////
libblock lib_pbr_vtx_instanced_vc : ublk_std_matrices : storage_instancing {
  void vs_instanced_vc(vec4 pos, vec3 nrm, vec3 bin, vec4 vclr) {
    mat4 instance_matrix = _instance_matrices[gl_InstanceIndex];
    vec4 instance_color  = _instance_colors[gl_InstanceIndex];
    mat3 instance_rot = mat3(instance_matrix);
    vec4 cpos         = mv * (instance_matrix * pos);
    vec3 wnormal      = normalize(instance_rot * nrm);
    vec3 wbitangent   = normalize(instance_rot * bin);
    vec3 wtangent     = cross(wbitangent, wnormal);
    frg_wpos    = m * (instance_matrix * pos);
    frg_uv0     = vec2(0, 0);
    frg_tbn     = mat3(wtangent, wbitangent, wnormal);
    frg_camz    = wnormal.xyz;
    frg_camdist = -cpos.z;
    frg_clr     = vclr * instance_color;
  }
} // lib_pbr_vtx_instanced_vc
///////////////////////////////////////////////////////////////
// MATRICES-ONLY instancing: a SEPARATE single-array block so the buffer is fully dynamic
// (count-sized) — std430 allows one runtime array per block, so matrices get their own block,
// no colors / pickids. Per-instance color is dropped (frg_clr = white); the material's baseColor
// shows through. Used by drawables that only need per-instance transforms (e.g. terrain scatter).
storage_interface storage_inst_mtx (descriptor_set 0) {
  buffer layout(std430) inst_mtx { mat4 _instance_matrices[]; };   // runtime array -> count-sized
}
libblock lib_pbr_vtx_instanced_mtxonly : ublk_std_matrices : storage_inst_mtx {
  void vs_instanced_mtxonly(vec4 pos, vec3 nrm, vec3 bin) {
    mat4 instance_matrix = _instance_matrices[gl_InstanceIndex];
    mat3 instance_rot = mat3(instance_matrix);
    vec4 cpos         = mv * (instance_matrix * pos);
    vec3 wnormal      = normalize(instance_rot * nrm);
    vec3 wbitangent   = normalize(instance_rot * bin);
    vec3 wtangent     = cross(wbitangent, wnormal);
    frg_wpos    = m * (instance_matrix * pos);
    frg_uv0     = uv0 * vec2(1, -1);
    frg_tbn     = mat3(wtangent, wbitangent, wnormal);
    frg_camz    = wnormal.xyz;
    frg_camdist = -cpos.z;
    frg_clr     = vec4(1.0);   // no per-instance color -> material baseColor shows through
  }
} // lib_pbr_vtx_instanced_mtxonly
///////////////////////////////////////////////////////////////
// cache-probe2 1781278793
