///////////////////////////////////////////////////////////////
// Uniforms
///////////////////////////////////////////////////////////////

uniform_block ublk_vtx (descriptor_set 0) {
  mat4 MatM;
  mat4 MatV;
  mat4 MatP;
  mat4 MatVP;
  mat4 MatIV;
  mat4 MatIVP;
  mat4 MatMV;
  mat4 MatMVP;
  mat4 MatAux;
  vec4 modcolor;
  vec4 User0;
  vec4 User1;
  vec4 User2;
  vec4 User3;
  float Time;
  vec4 NoiseShift;
  vec4 NoiseFreq;
  vec4 NoiseAmp;
  vec2 Rtg_InvDim;
}

uniform_block ublk_frg (descriptor_set 0) {
  vec4 modcolor;
  vec4 User0;
  float ColorFactor;
  float AlphaFactor;
}

sampler_set sset_frg (descriptor_set 0) {
  sampler2D ColorMap;
  sampler2D GradientMap;
  sampler3D VolumeMap;
}

uniform_set compute_unis {
    //layout (binding = 1, r32ui) uimage2D img_depthclusters;
    vec3 xxx;
}

///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
  // DepthTest=LEQUALS;
  // DepthMask=true;
  // CullTest=PASS_FRONT;
}
///////////////////////////////////////////////////////////////
state_block sb_lerpblend : sb_default {
  BlendMode = ADDITIVE;
}
///////////////////////////////////////////////////////////////
state_block sb_additive : sb_default {
  BlendMode = ADDITIVE;
}
///////////////////////////////////////////////////////////////
state_block sb_alpadd : sb_default {
  BlendMode = ALPHA_ADDITIVE;
}

///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////

fragment_interface fface_minimal : ublk_frg : sset_frg {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;  // x=age, y=random, z=aux.x, w=aux.y
  }
  outputs {
    vec4 out_clr;
  }
}
fragment_interface fface_psys : ublk_frg : sset_frg {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;  // x=age, y=random, z=aux.x, w=aux.y
  }
  outputs {
    layout(location = 0) vec4 out_clr;
    //layout(location = 1) vec4 out_normal_mdl;
    //layout(location = 2) vec4 out_rufmtl;
  }
}

///////////////////////////////////////////////////////////////
vertex_interface vface_bill : ublk_vtx {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
    vec2 uv1 : TEXCOORD1;
  }
  outputs {
    vec4 geo_clr; // NOT an array
    vec2 geo_uv0; // NOT an array
    vec2 geo_uv1; // NOT an array
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_flat : fface_psys {
  float unit_age = frg_uv1.x;
  vec3 C  = modcolor.xyz*(1.0-unit_age);
  out_clr = vec4(C, modcolor.w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modclr : fface_psys {
  out_clr        = modcolor;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fragclr : fface_minimal {
  out_clr        = frg_clr;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modtex : fface_psys {
  vec4 texc      = texture(ColorMap, frg_uv0.xy);
  out_clr        = texc * modcolor;
  if (out_clr.a == 0.0)
    discard;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_grad : fface_psys {
  float unit_age = clamp(frg_uv1.x, 0.0, 255.0/256.0);
  vec4 gmap = texture(GradientMap, vec2(unit_age, 0.0));
  vec4 cmap = texture(ColorMap, frg_uv0.xy);
  out_clr.xyz = (gmap.xyz*cmap.xyz)*ColorFactor;
  out_clr.w = gmap.w*cmap.w*AlphaFactor;
}
///////////////////////////////////////////////////////////////
// Gradient-atlas: samples GradientMap (a 2D texture) at
//   X = unit_age (existing semantic)
//   Y = aux.x (per-particle, set by emitter via Aux.x = ...)
// fract() so callers can scroll outside [0,1] safely.
// ColorMap is the per-particle "cookie" (sprite shape) — same role as in
// ps_grad. Material binds it to .modulation_texture; if unbound the result
// is multiplied by whatever the default texture is.
fragment_shader ps_grad_atlas : fface_psys {
  float unit_age = clamp(frg_uv1.x, 0.0, 255.0/256.0);
  float aux_x = fract(frg_uv1.z);
  vec4 gmap = texture(GradientMap, vec2(unit_age, aux_x));
  vec4 cmap = texture(ColorMap, frg_uv0.xy);
  out_clr.xyz = (gmap.xyz * cmap.xyz) * ColorFactor;
  out_clr.w   = (gmap.w   * cmap.w  ) * AlphaFactor;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modtexclr : fface_psys {
  vec4 texc      = texture(ColorMap, frg_uv0.xy);
  float alp      = frg_clr.a*texc.a;
  if (alp == 0.0)
    discard;
  float unit_age = frg_uv1.x;
  out_clr        = texc*modcolor*(1.0-unit_age);
  out_clr.a      = alp;
}
///////////////////////////////////////////////////////////////
uniform_set uset_frg_grid {
  float GridDim;
}
///////////////////////////////////////////////////////////////
fragment_interface fface_psys_grid : ublk_frg : uset_frg_grid : sset_frg {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_uv1;  // x=age, y=random, z=aux.x, w=aux.y
  }
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modtexclr_grid : fface_psys_grid {
  float unit_age = frg_uv1.x;
  // select grid cell (0..GridDim*GridDim-1) from unit age
  int igridcell = int(unit_age*((GridDim*GridDim)-1.0));
  float fgridcell = float(igridcell);
  float fgridcellu = mod(fgridcell, GridDim);
  float fgridcellv = floor(fgridcell/GridDim);
  vec2 gridUV = vec2(fgridcellu/GridDim, fgridcellv/GridDim);
  gridUV += frg_uv0.xy/GridDim;

  vec4 texc = texture(ColorMap, gridUV);
  float alpha = length(texc.rgb);
  alpha *= pow(sin(unit_age*3.14159), 0.25);
  texc.w = alpha;

  out_clr = texc * modcolor;
}
///////////////////////////////////////////////////////////////
// FreestyleParticleMaterial stock fragment: flipbook cookie (the texgrid
// recipe) x gradient ramp over unit_age. Authored for PREMA (premultiplied)
// compositing: out.rgb adds, out.a occludes — gradient w ~ 0 = pure additive
// fire, w > 0 = absorptive smoke; ONE draw morphs fire into smoke per
// particle. Geometry-agnostic: paired with both sprite and streak VS.
fragment_shader ps_freestyle_ptc : fface_psys_grid {
  float unit_age = clamp(frg_uv1.x, 0.0, 255.0/256.0);
  // flipbook cell from unit age
  int igridcell = int(unit_age*((GridDim*GridDim)-1.0));
  float fgridcell = float(igridcell);
  vec2 gridUV = vec2(mod(fgridcell, GridDim)/GridDim, floor(fgridcell/GridDim)/GridDim);
  gridUV += frg_uv0.xy/GridDim;
  vec4 texc = texture(ColorMap, gridUV);
  // cookie opacity from sheet luminance (effect sheets are additive-style)
  float cookie_a = length(texc.rgb)*0.5773; // 1/sqrt(3)
  // ramp over life
  vec4 gmap = texture(GradientMap, vec2(unit_age, 0.0));
  out_clr.xyz = (gmap.xyz * texc.xyz) * ColorFactor * modcolor.xyz;
  out_clr.w   = clamp(gmap.w * cookie_a * AlphaFactor * modcolor.w, 0.0, 1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_volume : fface_psys {
  vec2 uv        = frg_uv0.xy;
  float w        = frg_uv1.x;
  vec3 uvw       = vec3(uv, w);
  vec4 TexInp0   = texture(VolumeMap, uvw).xyzw;
  out_clr        = TexInp0.bgra * modcolor * frg_clr.bgra;
}

