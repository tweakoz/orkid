import "pbrtools.i2";
///////////////////////////////////////////////////////////////
libblock lib_fwd_impl : lib_math //
    : lib_brdf                   //
    : lib_envmapping             //
    : ublk_frg_fwd_lighting      //
    : lib_def                    //
    : lib_ssao {                 //

  vec3 _forward_lighting_int(vec3 modcolor, vec3 eyepos) {
    return vec3(1);
  }
  LightCtx lcalc_forward(vec3 wpos, PbrData pbd, vec3 eyepos) {
    LightCtx plc;
    const vec3 metalbase = vec3(0.04);
    float metallic       = clamp(pbd._metallic, 0.02, 0.99);
    vec3 basecolor       = pbd._albedo;
    vec3 diffcolor       = mix(basecolor, vec3(0), metallic);
    vec3 speccolor       = mix(vec3(0.02), basecolor, metallic);
    /////////////////////////
    plc._viewdir   = normalize(eyepos - wpos);
    plc._metallic  = metallic; // pbd._metallic;
    plc._roughness = pbd._roughness;
    plc._normal    = pbd._wnrm;
    plc._F0        = mix(metalbase, basecolor, metallic);
    return plc;
  }
  vec3 plcalc_forward(LightCtx plc, PbrData pbd, float lightRadius) {
    float dist2light    = length(plc._lightdel);
    float atten         = 1.0 / max(.05, dist2light * dist2light); // prevent infinite light
    vec3 lightdir       = normalize(plc._lightdel);
    vec3 halfdir        = normalize(plc._viewdir + lightdir);
    float angularRadius = atan(lightRadius, dist2light);
    float ggx           = computeGGX(plc._normal, halfdir, plc._roughness + angularRadius); // Example adjustment

    // float ggx = computeGGX(plc._normal, halfdir, plc._roughness);
    float geo = geometrySmith(plc._normal, plc._viewdir, lightdir, plc._roughness);
    vec3 fres = fresnelSchlickRoughness(satdot(halfdir, plc._viewdir), plc._F0, plc._roughness);

    vec3 diffusel = vec3(1) - fres;
    diffusel *= (1 - plc._metallic);
    vec3 diffuse_term = (diffusel * pbd._albedo * INV_PI) * DiffuseLevel;

    vec3 numerator     = min(ggx * geo * SpecularLevel, 16) * fres;
    float denominator  = 4 * satdot(plc._normal, plc._viewdir) * satdot(plc._normal, lightdir) + EPSILON;
    float ndotl        = satdot(plc._normal, lightdir);
    vec3 specular_term = numerator / max(.0625, denominator);

    return (diffuse_term + specular_term) * atten * ndotl;
    // return lightdir*(atten*ndotl);
  }
  vec3 MRD(PbrData pbd) {
    float metallic_tex  = pbd._metallic;
    float roughness_tex = pbd._roughness;
    float metallic      = clamp(metallic_tex * MetallicFactor, 0.02, 0.99);
    float roughness     = roughness_tex * RoughnessFactor;
    roughness           = pow(roughness, RoughnessPower);
    float dialetric     = 1.0 - metallic;
    return vec3(metallic, roughness, dialetric);
  }

  vec3 pbrEnvironmentLightingXXX(PbrData pbd, vec3 eyepos) {

    vec3 out_color;

    vec3 wpos   = pbd._wpos;
    vec3 N      = pbd._wnrm;
    vec3 albedo = pbd._albedo;
    /////////////////////////
    vec3 metalbase  = vec3(0.04);
    vec3 mrd        = MRD(pbd);
    float metallic  = mrd.x;
    float roughness = mrd.y;
    float dialetric = mrd.z;
    /////////////////////////
    vec3 basecolor = albedo;
    vec3 diffcolor = mix(basecolor, vec3(0), metallic);
    /////////////////////////
    vec3 edir = normalize(wpos - eyepos);
    vec3 refl = normalize(reflect(edir, N));
    refl.x *= -1.0;
    refl.z *= -1.0;
    /////////////////////////
    float costheta = clamp(dot(N, edir), 0.01, 0.99);
    vec2 brdf      = textureLod(MapBrdfIntegration, vec2(costheta, roughness * 0.99), 0).rg;
    brdf           = clamp(brdf, vec2(0), vec2(1));
    /////////////////////////
    vec3 F0    = mix(metalbase, basecolor, metallic);
    vec3 G0    = mix(metalbase, basecolor, 1.0 - metallic);
    vec3 F     = fresnelSchlickRoughness(costheta, F0, roughness);
    vec3 invF  = (vec3(1) - F);
    vec3 diffn = N;
    /////////////////////////
    // ambient occlusion
    /////////////////////////
    //  filter sample ambocc
    /////////////////////////
    vec2 ssao_uv = (gl_FragCoord.xy) * InvViewportSize;
    float ambocc = texture(SSAOMap, ssao_uv).x;
    /////////////////////////
    float ambientshade = clamp(dot(N, -edir), 0, 1) * 0.3 + 0.7;
    vec3 ambient       = AmbientLevel * ambientshade * ambocc;
    vec3 diffuse_env   = env_equirectangular2(diffn, MapDiffuseEnv) * DiffuseLevel * SkyboxLevel;
    vec3 diffuse_light = ambient + diffuse_env;
    /////////////////////////
    vec3 diffuse = clamp(basecolor * diffuse_light * dialetric * ambocc, 0, 1);
    /////////////////////////
    // rotate refl by 180 degrees on y to get refl_probe_coord
    vec3 refl_probe_coord = vec3(-refl.x, refl.y, -refl.z);
    vec3 probe_REFL       = env_cube(reflectionPROBE, refl_probe_coord).xyz;
    /////////////////////////
    vec3 refl_equi = normalize(vec3(refl.x, -refl.y, refl.z));
    // Use normal for diffuse (Radiance)
    // vec3 diffuse_env = env_equirectangular(diffn, MapDiffuseEnv, 0);
    //  Use reflection with appropriate mip level for specular
    float rl      = roughness * roughness;
    rl            = pow(rl, 0.75);
    float slice   = rl * RoughnessLevels * 0.9;
    vec3 spec_env = env_equirectangular_spec_wbias(refl_equi, MapSpecularEnv, slice, 3.0);
    vec3 env      = spec_env + probe_REFL;
    env           = env * (1.0 + (pow(dialetric, 2.0)) * 0.33);

    vec3 specular_light = ambient + env;
    vec3 specularC      = specular_light * F0 * SpecularLevel;
    vec3 specularMask   = clamp(F * brdf.x + brdf.y, 0, 1);
    vec3 specular       = specularMask * specularC * 2.0; // * ambocc;
    /////////////////////////
    return saturateV((diffuse + specular) * SkyboxLevel);

  } // vec3 environmentLighting(){

  vec3 _sample_color_cookie(uint slice, float lod, vec2 uv) {
    return textureLod(light_cookie_colors, vec3(uv, slice), lod).xyz;
  }
  float _sample_depth_cookie(uint slice, vec2 uv) {
    return textureLod(light_cookie_depths, vec3(uv, slice), 0).x;
  }

  /////////////////////////////////////////////////////////

  vec3 _forward_lightingX(PbrData pbd, vec3 eyepos, vec3 emission, vec3 modcolor) {
    /////////////////////////
    // refl.x *= -1.0;
    /////////////////////////
    // light maps
    /////////////////////////
    vec3 light_maps = texture(LightMapArray, vec3(frg_uv0, 0)).xyz * LightMapColors[0];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 1)).xyz * LightMapColors[1];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 2)).xyz * LightMapColors[2];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 3)).xyz * LightMapColors[3];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 4)).xyz * LightMapColors[4];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 5)).xyz * LightMapColors[5];
    /////////////////////////
    // env lighting (HDRI)
    /////////////////////////
    vec3 env_lighting = pbrEnvironmentLightingXXX(pbd, eyepos);
    env_lighting += light_maps;
    /////////////////////////
    // dynamic lighting
    /////////////////////////
    const vec3 metalbase = vec3(0.04);
    vec3 mrd = MRD(pbd);
    float metallic  = mrd.x;
    float roughness = mrd.y;
    float dialetric = mrd.z;
    vec3 basecolor  = pbd._albedo;
    vec3 diffcolor  = mix(basecolor, vec3(0), metallic);
    vec3 F0    = mix(metalbase, basecolor, metallic);
    vec3 G0    = mix(metalbase, basecolor, 1.0 - metallic);
    vec3 edir = normalize(pbd._wpos - eyepos);
    vec3 refl = normalize(reflect(edir, pbd._wnrm));
    /////////////////////////
    vec3 spot_lighting = vec3(0, 0, 0);
    //
    for (int i = 0; i < spot_light_count; i++) {
      int j = i + point_light_count;
      /////////////////////
      uint light_tex_slice = _lightTexSlice[i];
      mat4 shmtx           = _shadowmatrix[i];
      vec3 lightcol        = _lightcolor[i].xyz;
      vec3 lightpos        = _lightpos[i].xyz;
      vec4 LSB             = _lightsizbias[i];
      float lightrange     = LSB.x;
      /////////////////////
      vec3 lightdel       = lightpos - pbd._wpos;
      vec4 light_hpos    = (shmtx)*vec4(pbd._wpos, 1);
      vec3 light_ndc     = (light_hpos.xyz / light_hpos.w);
      vec2 light_uv      = light_ndc.xy * 0.5 + vec2(0.5);
      float lightz       = light_ndc.z;
      float shadow_factor = 0.0;
      bool light_mask_x = (light_ndc.x > -1) && (light_ndc.x < 1);
      bool light_mask_y = (light_ndc.y > -1) && (light_ndc.y < 1);
      bool light_mask_z = (light_ndc.z > 0) && (light_ndc.z < 1);

      bool light_mask = light_mask_x && light_mask_y && light_mask_z;
      if (light_mask) {
        float bias             = LSB.y; // Increased bias to help with shadow acne
        
        // Percentage-Closer Filtering (PCF)
        int pcf_width_n         = -1;          // Size of the PCF kernel
        int pcf_width_p         = 1;           // Size of the PCF kernel
        int pcf_width           = (pcf_width_p-pcf_width_n) + 1; // Assuming symmetric kernel
        float pcf_filter_size = 1.0 / LSB.z; // Adjust based on your shadow map resolution

        for (int x = pcf_width_n; x <= pcf_width_p; x++) {
          for (int y = pcf_width_n; y <= pcf_width_p; y++) {
            vec2 pcf_uv     = light_uv + vec2(x, y) * pcf_filter_size;
            float pcf_depth_ndc = _sample_depth_cookie(light_tex_slice, pcf_uv);
            shadow_factor += (pcf_depth_ndc + bias) >= lightz ? 1.0 : 0.0;
          }
        }

        shadow_factor /= float(pcf_width*pcf_width);

      } else {        
        shadow_factor = 0.0;
      }
      ////////////////////////////////////////////////////////////
      // compute specular lightuv
      ////////////////////////////////////////////////////////////

      vec3 lightdir         = normalize(lightdel * -1);
      vec3 halfdir          = normalize(lightdir - normalize(eyepos - pbd._wpos));
      vec4 spec_hpos2      = (shmtx)*vec4(pbd._wpos + halfdir, 1);
      vec3 spec_ndc2       = (spec_hpos2.xyz / spec_hpos2.w);
      vec2 specular_lightuv = spec_ndc2.xy * 0.5 + vec2(0.5);

      bool bspec_mask = bool(spec_ndc2.x >= -1 && spec_ndc2.x < 1) && bool(spec_ndc2.y >= -1 && spec_ndc2.y < 1) &&
                            bool(spec_ndc2.z >= 0.0 && spec_ndc2.z <= 1);

      vec3 vspec_mask = vec3(float(bspec_mask));



      float spec_level            = 0; //pbd._roughness * 4;
      vec3 diffuse_lighttex  = _sample_color_cookie(light_tex_slice, 0, light_uv).xyz;
      vec3 specular_lighttex = _sample_color_cookie(light_tex_slice, spec_level, specular_lightuv).xyz; // specular WIP
      vec3 LN     = normalize(lightdel);
      float Ldist = length(lightdel);
      float NdotL = max(0.0, dot(pbd._wnrm, LN));  
      float spec_mix = (1.0 - pow(pbd._roughness, 1.0));
      vec3 diffuse  = pbd._albedo * diffuse_lighttex * NdotL; 
      vec3 lighttex = diffuse;
      lighttex += F0 * pbd._albedo * specular_lighttex * NdotL * vspec_mask * spec_mix;
      spot_lighting += (lightcol * lighttex / pow(Ldist, 2)) * shadow_factor;
  
    }
    //
    /////////////////////////
    return (env_lighting + emission + spot_lighting) * modcolor;
  }
  vec3 _forward_lightingZ(vec3 modcolor, vec3 albedo, vec3 ambrufmtl, vec3 emission, vec3 eyepos, vec3 normal, bool emissive) {
    PbrData pbr;
    pbr._emissive  = emissive;
    pbr._albedo    = albedo;
    pbr._metallic  = ambrufmtl.z;
    pbr._roughness = ambrufmtl.y;
    pbr._wpos      = frg_wpos.xyz;
    pbr._wnrm      = normal;
    pbr._fogZ      = 0.0;
    pbr._atmos     = 0.0;
    pbr._alpha     = 1.0;
    return _forward_lightingX(pbr, eyepos, emission, modcolor);
  }
}

///////////////////////////////////////////////////////////////
libblock lib_fwd     //
    : lib_fwd_impl { //
  /////////////////////////////////////////////////////////

  vec3 _forward_lighting(vec3 modcolor, vec3 eyepos) {
    vec2 uvinvy    = mod(frg_uv0.xy, 1); // TODO wrap in sampler addressing mode
    vec3 albedo    = texture(CNMREA, vec3(uvinvy, 0)).xyz;
    vec3 TN        = texture(CNMREA, vec3(uvinvy, 1)).xyz;
    vec3 ambrufmtl = texture(CNMREA, vec3(uvinvy, 2)).xyz;
    vec3 emission  = texture(CNMREA, vec3(uvinvy, 3)).xyz;
    vec3 N         = TN * 2.0 - vec3(1, 1, 1);
    bool emissive  = length(TN) < 0.1;
    vec3 normal    = normalize(frg_tbn * N);
    return _forward_lightingZ(modcolor, albedo, ambrufmtl, emission, eyepos, normal, emissive) * modcolor;
  }

  vec3 forward_lighting_mono(vec3 modcolor) {
    return _forward_lighting(modcolor, EyePostion);
  }

  vec3 forward_lighting_ntex(vec3 modcolor) {
    vec2 uvinvy    = mod(frg_uv0.xy, 1); // TODO wrap in sampler addressing mode
    vec3 albedo    = vec3(1,1,1);
    vec3 TN        = vec3(0.5,0.5,1);
    vec3 ambrufmtl = vec3(1,1,1);
    vec3 emission  = vec3(0,0,0);
    vec3 N         = TN * 2.0 - vec3(1, 1, 1);
    bool emissive  = false;
    vec3 normal    = normalize(frg_tbn * N);
    return _forward_lightingZ(modcolor, albedo, ambrufmtl, emission, EyePostion, normal, emissive) * modcolor;
  }
}
