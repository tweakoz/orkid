import "pbrtools.i2";
import "pbr_lobes.i2";
// DIRECT, not via pbrtools: pbrtools imports THIS file (circular) before it
// reaches skytools, so at the point fwdtools is sema'd lib_sky is not yet in
// the translatable cache and the `: lib_sky` inherit below would be dropped
// without a diagnostic.
import "skytools.i2";
// lib_sun_air — the march's per-step cascade taps, shared verbatim with the
// quarter-res shaft pass. Same direct-import reasoning as skytools above.
import "sunairtools.i2";
///////////////////////////////////////////////////////////////
// PBR2 Phase 3 (P3.C) — Forward pass output / variant matrix.
//
// All forward-pass fragment shaders declare BOTH outputs:
//   layout(location=0) vec4 out_color    — composed lit RGB + alpha
//   layout(location=1) vec4 out_diffuse  — diffuse irradiance only (RGB)
//
// Where the writes actually land depends on the bound RTG's attachment
// count; pipelines compile identically for every pass.
//
// | Pass                              | RTG attachments | target0          | target1            |
// |-----------------------------------|-----------------|------------------|--------------------|
// | Main forward (std_forward)        | 2 (RGBAxx × 2)  | spec+diff+lobes  | diffuse only (SSSS)|
// | Transparent layer (std_transparent)| 2              | spec+diff+lobes  | diffuse only       |
// | Probe bake (cube/SSAA/TAA RTGs)   | 1               | spec+diff+lobes  | dropped (no attach)|
// | Depth prepass                     | 0 (depth only)  | n/a              | n/a                |
// | Shadow caster                     | 0 (depth only)  | n/a              | n/a                |
// | Picking (ps_pick — separate iface)| 1 (uvec4 IDs)   | picking ID       | n/a (own iface)    |
//
// Vulkan tolerates the location=1 write going to a render pass with
// no attachment-1 — the write is silently dropped. This matches the
// correct semantic for probe bakes (cubemaps shouldn't carry SSSS-only
// diffuse — they want the composed lit color for IBL consumption).
//
// SSSS (P3.D) runs as a screen-space post-pass on the main forward
// output only; never on probe bakes. Pattern matches Filament's
// camera-tied screen-space convention.
//
// Future (deferred): split fragment_interface into MRT vs single-target
// flavors so the probe-bake pipelines are explicitly one-attachment.
// Bandwidth saving on N probes × 6 faces; correctness already fine.
///////////////////////////////////////////////////////////////
libblock lib_fwd_impl : lib_math //
    : lib_brdf                   //
    : lib_envmapping             //
    : lib_env_decode             // procedural-capture pre-scale (see stdtools)
    : lib_env_sh                 // sky SH probe -> diffuse irradiance (see stdtools)
    : ublk_frg_fwd_lighting      //
    : ublk_sun                   // SKYLIGHT lane A — sun + cascade state
    : sset_sun                   // SKYLIGHT lane A — cascade depth array
    : lib_def                    //
    : lib_ssao                   //
    : lib_sky                    // SKYLIGHT lane B — aerial-perspective seam
    : lib_sun_air                // the march's per-step cascade taps (shared with the shaft pass)
    : lib_pbr_lobes_all {        //

  vec3 _forward_lighting_int(vec3 modcolor, vec3 eyepos) {
    return vec3(1);
  }
  /////////////////////////////////////////////////////////
  // PBR2 Phase 3 (P3.A) — build the per-fragment surface descriptor
  // from PbrData + the per-extension UBOs that lib_pbr_lobes_all
  // already transitively imports. This is the "default sourcing"
  // path used by standard PbrMaterial; future node-graph codegen
  // (P3.F) will produce overrides between this call and forward_shading.
  //
  // After P3.A's full lobe migration, the per-extension UBOs are only
  // read here — lobes read from surf fields directly.
  /////////////////////////////////////////////////////////
  SurfaceFragment build_surface(PbrData pbd, vec3 emission) {
    SurfaceFragment surf;
    // Geometry
    surf.position_world         = pbd._wpos;
    surf.normal_world           = pbd._wnrm;
    surf.fog_z                  = pbd._fogZ;
    surf.atmos                  = pbd._atmos;
    // Base material
    surf.base_color             = pbd._albedo;
    surf.alpha                  = pbd._alpha;
    surf.emission               = emission;
    // BRDF core
    surf.metallic               = pbd._metallic;
    surf.roughness              = pbd._roughness;
    // Tangent frame — P3.E will source from vertex shader; zero for now.
    surf.tangent_world          = vec3(1, 0, 0);
    surf.anisotropic_tangent    = vec3(1, 0, 0);
    surf.anisotropic_strength   = 0.0;
    // Transmission / IOR / volume
    surf.ior                    = (has_ior != 0) ? ior_value : 1.5;
    surf.transmission_factor    = transmission_factor;
    // P3.D — transmission_roughness falls back to BRDF roughness when unset.
    surf.transmission_roughness = (has_transmission_roughness != 0)
                                    ? transmission_roughness : surf.roughness;
    surf.attenuation_color      = attenuation_color;
    surf.attenuation_distance   = attenuation_distance;
    surf.volume_thickness_factor = volume_thickness_factor;
    surf.has_transmission       = has_transmission;
    surf.has_transmission_roughness = has_transmission_roughness;
    surf.has_ior                = has_ior;
    surf.has_volume             = has_volume;
    // Sheen
    surf.sheen_color            = sheen_color;
    surf.sheen_factor           = sheen_factor;
    surf.sheen_roughness        = sheen_roughness;
    surf.has_sheen              = has_sheen;
    // Clearcoat — second normal not yet wired; reuse base normal.
    surf.clearcoat_normal_world = pbd._wnrm;
    surf.clearcoat_factor       = clearcoat_factor;
    surf.clearcoat_roughness    = clearcoat_roughness;
    surf.has_clearcoat          = has_clearcoat;
    // Specular ext
    surf.specular_color         = specular_color;
    surf.specular_factor        = specular_factor;
    surf.has_specular           = has_specular;
    // Iridescence
    surf.iridescence_factor     = iridescence_factor;
    surf.has_iridescence        = has_iridescence;
    // Diffuse transmission
    surf.diffuse_transmission_color  = diffuse_transmission_color;
    surf.diffuse_transmission_factor = diffuse_transmission_factor;
    surf.has_diffuse_transmission    = has_diffuse_transmission;
    // Subsurface (P3.D) — read from ublk_pbr_subsurface (the .a of the
    // vec4 color/radius fields is unused per glTF spec).
    surf.subsurface_color       = subsurface_color;
    surf.subsurface_radius      = subsurface_radius.rgb;
    surf.subsurface_factor      = subsurface_factor;
    surf.has_subsurface         = has_subsurface;
    // Engine-resolved (Filament PixelParams pattern)
    surf.diffuse_color          = pbd._albedo * (1.0 - pbd._metallic);
    surf.f0                     = mix(vec3(0.04), pbd._albedo, pbd._metallic);
    surf.linear_roughness       = pbd._roughness * pbd._roughness;
    return surf;
  }
  LightCtx lcalc_forward(vec3 wpos, PbrData pbd, vec3 eyepos) {
    LightCtx plc;
    const vec3 metalbase = vec3(0.04);
    float metallic       = clamp(pbd._metallic, 0.02, 0.99);
    vec3 basecolor       = pbd._albedo;
    vec3 diffcolor       = mix(basecolor, vec3(0), metallic);
    vec3 speccolor       = mix(vec3(0.02), basecolor, metallic);
    /////////////////////////
    plc._viewdir   = normalize(eyepos - wpos);
    plc._metallic  = metallic; // pbd._metallic;
    plc._roughness = pbd._roughness;
    plc._normal    = pbd._wnrm;
    plc._F0        = mix(metalbase, basecolor, metallic);
    return plc;
  }
  // P3.B — returns ShadingResult so callers can route diffuse and
  // specular to their respective channels. Identical math to the prior
  // single-return version; just keeps the terms separated.
  ShadingResult plcalc_forward(LightCtx plc, PbrData pbd, float lightRadius) {
    // Linear distance falloff: atten ramps from 1 at the source to 0 at
    // lightRadius. intensity and radius are independent controls.
    float dist_to_light = length(plc._lightdel);
    float r_ratio    = dist_to_light / max(lightRadius, 1e-4);
    float atten      = max(0.0, 1.0 - r_ratio);
    vec3 lightdir    = normalize(plc._lightdel);
    vec3 halfdir     = normalize(plc._viewdir + lightdir);
    float ggx        = computeGGX(plc._normal, halfdir, plc._roughness);
    float geo = geometrySmith(plc._normal, plc._viewdir, lightdir, plc._roughness);
    vec3 fres = fresnelSchlickRoughness(satdot(halfdir, plc._viewdir), plc._F0, plc._roughness);

    vec3 diffusel = vec3(1) - fres;
    diffusel *= (1 - plc._metallic);
    vec3 diffuse_term = diffuseBRDF(DiffuseBrdfModel, pbd._albedo, diffusel,
                                    plc._roughness, plc._normal, plc._viewdir, lightdir) * DiffuseLevel;

    vec3 numerator     = min(ggx * geo * SpecularLevel, 16) * fres;
    float denominator  = 4 * satdot(plc._normal, plc._viewdir) * satdot(plc._normal, lightdir) + EPSILON;
    float ndotl        = satdot(plc._normal, lightdir);
    vec3 specular_term = numerator / max(0.0625, denominator);

    ShadingResult r;
    r.diffuse  = diffuse_term  * atten * ndotl;
    r.specular = specular_term * atten * ndotl;
    return r;
  }
  vec3 MRD(PbrData pbd) {
    float metallic_tex  = pbd._metallic;
    float roughness_tex = pbd._roughness;
    float metallic      = clamp(metallic_tex * MetallicFactor, 0.02, 0.99);
    float roughness     = roughness_tex * RoughnessFactor;
    roughness           = pow(roughness, RoughnessPower);
    float dialetric     = 1.0 - metallic;
    return vec3(metallic, roughness, dialetric);
  }

  // Returns ShadingResult split into diffuse and specular env contributions.
  // Both leave here in HDR: this path feeds the same tone curve the analytic
  // punctual/sun paths do (plcalc_forward), and a ceiling applied here is
  // range the tone curve can never get back. The floors below are real —
  // a prefiltered/SH-reconstructed env sample can ring negative — but they
  // are floors only.
  // The SkyboxLevel multiply appears twice (once folded into diffuse_env,
  // once at the tail); it is load-bearing for the currently-tuned exposure.
  ShadingResult pbrEnvironmentLightingWithF0(PbrData pbd, vec3 eyepos, vec3 F0_override, float matAO) {

    vec3 out_color;

    vec3 wpos   = pbd._wpos;
    vec3 N      = pbd._wnrm;
    vec3 albedo = pbd._albedo;
    /////////////////////////
    vec3 metalbase  = vec3(0.04);
    vec3 mrd        = MRD(pbd);
    float metallic  = mrd.x;
    float roughness = mrd.y;
    float dialetric = mrd.z;
    /////////////////////////
    vec3 basecolor = albedo;
    vec3 diffcolor = mix(basecolor, vec3(0), metallic);
    /////////////////////////
    // FIXED: viewdir points FROM surface TO eye for correct BRDF evaluation
    vec3 viewdir = normalize(eyepos - wpos);
    vec3 refl = normalize(reflect(-viewdir, N));
    refl.x *= -1.0;
    refl.z *= -1.0;
    /////////////////////////
    float costheta = clamp(dot(N, viewdir), 0.01, 0.99);
    vec2 brdf      = textureLod(MapBrdfIntegration, vec2(costheta, roughness * 0.99), 0).rg;
    brdf           = clamp(brdf, vec2(0), vec2(1));
    /////////////////////////
    // F0_override comes from the modulatory lobe pass (P2.4 ior / P2.5
    // specular / P2.6 iridescence). When no modulatory lobes are active
    // it equals mix(0.04, albedo, metallic) — identical to pre-Phase-2.
    vec3 F0    = F0_override;
    vec3 G0    = mix(metalbase, basecolor, 1.0 - metallic);
    vec3 F     = fresnelSchlickRoughness(costheta, F0, roughness);
    vec3 invF  = (vec3(1) - F);
    vec3 diffn = N;
    /////////////////////////
    // ambient occlusion
    /////////////////////////
    //  filter sample ambocc
    /////////////////////////
    vec2 ssao_uv = (gl_FragCoord.xy) * InvViewportSize;
    // ambocc = screen-space SSAO × material/baked AO (matAO). matAO is 1.0 for every
    // material except those that route a real AO into ambrufmtl.x (ptex3d surface.ao),
    // so this is byte-identical for all existing forward materials.
    float ambocc = texture(SSAOMap, ssao_uv).x * matAO;
    /////////////////////////
    float ambientshade = clamp(dot(N, viewdir), 0, 1) * 0.3 + 0.7;
    vec3 ambient       = AmbientLevel * ambientshade * ambocc;
    // DIFFUSE AMBIENT SOURCE — ONE pipeline (owner ruling 10). Every sky
    // arrives as nine L2 coefficients, cosine-convolved here: the procedural
    // probe's, or the bound map set's own projection of its authored equirect.
    // Both are already decoded and already crossfaded (the blend is resolved
    // CPU-side by the same weight the maps fade on), so this reads the same
    // way whichever it is, and EnvSHValid==0 means the frame has no sky rather
    // than selecting some other source.
    // AND IT STAYS LAMBERT. DiffuseBrdfModel selects the ANALYTIC diffuse lobe
    // only (lib_brdf::diffuseBRDF, punctual + sun); the ambient term below is a
    // cosine-convolved SH irradiance, which is a Lambert integral by
    // construction. Matching it to Oren-Nayar or Burley means re-convolving the
    // probe against that lobe, not scaling this read — a deliberate asymmetry,
    // not an oversight.
    vec3 diffuse_irr   = env_shIrradiance(diffn) * EnvSHValid;
    vec3 diffuse_env   = diffuse_irr * DiffuseLevel * SkyboxLevel;
    vec3 diffuse_light = ambient + diffuse_env;
    /////////////////////////
    vec3 diffuse = max(basecolor * diffuse_light * dialetric * ambocc, vec3(0));
    /////////////////////////
    // Specular env source: when a reflection probe is active, use its
    // cubemap; otherwise sample the skybox specular IBL (MapSpecularEnv).
    // has_reflection_probe is set on the binding side (fwdnode_pipeline.cpp)
    // whenever a probe cube is bound instead of the black cube placeholder.
    //
    // NOTE: the probe cube here is RAW radiance (no GGX prefilter chain),
    // so rough surfaces will look mirror-sharp until a prefilter bake is
    // landed. This is intentional for the first-cut swap mechanism.
    /////////////////////////
    float mipLevel = (roughness * roughness) * (RoughnessLevels - 1.0);
    vec3 env;
    if (has_reflection_probe != 0) {
      // Probe path. Vulkan coordinate adjust matches the existing
      // env_cube(reflectionPROBE, ...) sampling convention.
      vec3 refl_probe_coord = vec3(-refl.x, refl.y, refl.z);
      env = textureLod(reflectionPROBE, refl_probe_coord, mipLevel).xyz;
    } else {
      vec3 refl_equi = normalize(vec3(refl.x, -refl.y, refl.z));
      vec3 env_new   = env_decodeCapture(env_equirectangular_spec_wbias(refl_equi, MapSpecularEnv, mipLevel, 3.0));
      vec3 env_prev  = env_decodeCapture(env_equirectangular_spec_wbias(refl_equi, MapSpecularEnvPrev, mipLevel, 3.0));
      env = mix(env_prev, env_new, EnvBlendWeight);
    }
    // FIXED: Removed dielectric boost for glTF 2.0 compliance (was: env * (1.0 + pow(dialetric,2) * 0.33))
    // Uncomment line below for artistic boost (non-physical):
    // env = env * (1.0 + (pow(dialetric, 2.0)) * 0.33);

    // AmbientLevel is a DIFFUSE floor: adding it here put a flat glow on mirrors
    // (metallic 1 / roughness 0 has no diffuse to carry it) that survived a
    // black night sky.
    vec3 specular_light = env;
    vec3 specularC      = specular_light * SpecularLevel;
    vec3 specularMask   = clamp(F * brdf.x + brdf.y, 0, 1);
    // FIXED: Removed *2.0 multiplier for glTF 2.0 energy conservation
    vec3 specular       = specularMask * specularC; // * ambocc;
    // Uncomment line below for artistic boost (non-physical):
    // specular = specularMask * specularC * 2.0;
    /////////////////////////
    // Return split. Apply SkyboxLevel; floor per-channel, no ceiling.
    ShadingResult r;
    r.diffuse  = max(diffuse  * SkyboxLevel, vec3(0));
    r.specular = max(specular * SkyboxLevel, vec3(0));
    return r;
  } // pbrEnvironmentLightingWithF0(){

  // Back-compat shim — original signature, computes default F0 from
  // albedo+metallic per glTF 2.0 base, then forwards. Returns the summed
  // diffuse+specular ShadingResult as vec3 for callers that don't care
  // about the split.
  vec3 pbrEnvironmentLightingXXX(PbrData pbd, vec3 eyepos) {
    vec3 metalbase = vec3(0.04);
    float metallic = clamp(pbd._metallic * MetallicFactor, 0.02, 0.99);
    vec3 F0_default = mix(metalbase, pbd._albedo, metallic);
    ShadingResult r = pbrEnvironmentLightingWithF0(pbd, eyepos, F0_default, 1.0);  // shim: no material AO
    return r.specular + r.diffuse;
  }

  vec3 _sample_color_cookie(uint slice, float lod, vec2 uv) {
    return textureLod(light_cookie_colors, vec3(uv, slice), lod).xyz;
  }
  float _sample_depth_cookie(uint slice, vec2 uv) {
    return textureLod(light_cookie_depths, vec3(uv, slice), 0).x;
  }

  /////////////////////////////////////////////////////////
  // SKYLIGHT lane A — sun cascade shadow factor.
  // Cascade selection by WORLD DISTANCE from the band anchor carried in
  // ublk_sun (sun_cascade_basis — the viewer position the bands were fit
  // around): the cascades are nested world spheres, so the test that matches
  // the CPU fit is radial, not a view depth. No camera orientation enters it,
  // which is what makes both eyes agree and a turn cost nothing. 3x3 PCF (extends the
  // spot shadow_factor pattern) with a per-fragment dither rotation of the
  // kernel (soft foliage dappling); all knobs from sun_shadow_params (A8).
  /////////////////////////////////////////////////////////
  // one BILINEAR-weighted depth comparison at uv (texture space): compare
  // the 4 surrounding texels and blend by the sub-texel fraction — hardware
  // sampler2DShadow PCF done by hand (shadlang has no comparison samplers).
  // Turns the staircased binary edge into a smooth gradient at 4 fetches/tap.
  // uv_hi > 0 = the band occupies only the [0,uv_hi+texel] corner of its slice
  // (per-band resolution, S2b) and every tap must stay inside it: the rest of
  // the slice holds the depth CLEAR, which reads as "nothing in front of the
  // receiver" and would unshadow the band's outer edge. uv_hi == 0 = full-slice
  // band, clamped by the sampler's own CLAMP address mode exactly as before.
  float _sun_tap_bilinear(vec2 uv, float slice, float refz, float bias, float uv_hi) {
    float texel = sun_shadow_params.w;
    if (uv_hi > 0.0)
      uv = clamp(uv, vec2(0.0), vec2(uv_hi));
    vec2 st   = uv / texel - 0.5;
    vec2 i0   = floor(st);
    vec2 f    = st - i0;
    vec2 uv00 = (i0 + 0.5) * texel;
    float c00 = ((textureLod(sun_shadow_map, vec3(uv00, slice), 0).x + bias) >= refz) ? 1.0 : 0.0;
    float c10 = ((textureLod(sun_shadow_map, vec3(uv00 + vec2(texel, 0.0), slice), 0).x + bias) >= refz) ? 1.0 : 0.0;
    float c01 = ((textureLod(sun_shadow_map, vec3(uv00 + vec2(0.0, texel), slice), 0).x + bias) >= refz) ? 1.0 : 0.0;
    float c11 = ((textureLod(sun_shadow_map, vec3(uv00 + vec2(texel, texel), slice), 0).x + bias) >= refz) ? 1.0 : 0.0;
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
  }

  /////////////////////////////////////////////////////////
  // SUN COOKIE — cloud shadows. The cookie's ALPHA carries cloud OCCLUSION
  // toward the sun (0 = unoccluded), authored by the cloud deck's own DSL
  // material and accumulated by the deck's own premultiplied blend, so the
  // extinction model lives in exactly one place (the one-term ruling); this
  // path only PROJECTS and FILTERS it, never re-derives it.
  //
  // EXTINCTION IS BEER-LAMBERT: transmittance = exp(-tau*a), with tau
  // (sun_cookie_params.w) the optical depth of one full reference cloud and a
  // the cookie's accumulated occlusion, so a=1 means one such cloud stands in
  // the beam. A LINEAR 1-a reads a visually solid deck as a half-open shutter;
  // the real direct beam through cumulus is gone. This is the SAME law and the
  // same tau the sun/moon disc uses (pbrtools.i2) — one beam cannot have two
  // transmittances. The 1x1 default texel's a=0 makes an un-armed cookie
  // neutral in the BYTES (exp(0)=1), not only in the branch below.
  //
  // Softness is deliberately the sampler's job: a lod bias (params.z) widens the
  // filter footprint, which is what turns a coverage silhouette into a penumbra
  // that scales with cloud altitude instead of a stencil edge. Outside the
  // cookie's extent the sun is unoccluded (clamp-to-1, not clamp-to-edge), so a
  // finite map never paints a hard shadow rectangle across the world.
  /////////////////////////////////////////////////////////
  // RETURNS BOTH THINGS ONE SAMPLE CARRIES: x = the beam's transmittance (the
  // Beer-Lambert law below, what the DIRECT term is multiplied by), y = the
  // COVERAGE that transmittance was derived from, scaled by the same strength
  // dial. They are not interchangeable: at the shipped optical depth
  // transmittance is near-binary (a=0.3 already kills 90% of the beam), which is
  // right for a disc that is or is not blocked and wrong for a SKY that is
  // partly covered — the sky term grades with how much of the dome the deck
  // takes, so it reads the coverage. One sample, two consumers.
  vec2 _sun_cookie_sample(vec3 wpos) {
    if (sun_cookie_params.x < 0.5)
      return vec2(1.0, 0.0); // no cookie armed — never sampled, byte-identical to no-cookie
    vec4 cpos = sun_cookie_matrix * vec4(wpos, 1.0);
    if (cpos.w <= 0.0)
      return vec2(1.0, 0.0);
    vec2 cuv = cpos.xy / cpos.w;
    if (cuv.x < 0.0 || cuv.x > 1.0 || cuv.y < 0.0 || cuv.y > 1.0)
      return vec2(1.0, 0.0); // beyond the projected deck footprint
    float a = textureLod(sun_cookie, cuv, sun_cookie_params.z).w;
    // STRENGTH RIDES IN THE EXPONENT, not as a blend toward 1. Beer-Lambert
    // composes multiplicatively, so the only physical place a "how much of this
    // deck is really there" dial can act is on the OPTICAL DEPTH; used as a mix
    // weight it becomes a hard transmittance FLOOR of 1-strength that no tau can
    // ever get under (at strength 0.85 the beam keeps 15% through solid cloud —
    // observed as a sun that would not go out). At strength 1 the two forms are
    // identical; below it this one is the one that extinguishes.
    // strength 0 still returns exactly exp(0) = 1: the path stays disarmed.
    float s = clamp(sun_cookie_params.y, 0.0, 1.0);
    return vec2(exp(-sun_cookie_params.w * s * a), s * a);
  }

  // ONE snapshot's shadow factor. `slice` is the depth-array slice the band
  // lives on — band index plus the snapshot's SET BASE, which is what makes
  // the double buffer free at the sampler (S2a).
  // `band_texel` is 1/dim for THIS band (the sun_cascade_texel pair). It equals
  // sun_shadow_params.w for a full-dim band, which makes uv_scale exactly 1.0
  // and every expression below identical to the uniform-dim path.
  //
  // `fast` selects the REDUCED FILTER (>0.5): one bilinear compare instead of
  // the blocker search plus the tent lattice — 4 texel fetches against up to 45.
  // It is a per-MATERIAL opt-in (ptex3d surface(shadow_filter=...)), never a
  // global quality dial, and it exists for surfaces whose own geometry is
  // higher-frequency than any shadow kernel can be: a grass carpet covering the
  // lower half of the frame carries blade-scale noise that hides the penumbra
  // the full evaluator spends 40 fetches computing. Everything ABOVE the branch
  // — the normal offset, the band uv, the slope-scaled bias — is shared, so a
  // reduced surface sits in the same shadow, only less softly filtered. Every
  // material that does not ask for it passes a literal 0.0 and the whole reduced
  // path folds away at compile time.
  float _sun_shadow_set_factor(vec3 wpos, float ndotl, mat4 shmtx, float slice, float band_texel, float fast) {
    // NORMAL-OFFSET (glancing-angle de-aliasing): push the receiver point
    // along the GEOMETRIC normal by ~the PCF kernel's reach in WORLD texels,
    // scaled by sin(theta), BEFORE projecting into light space. At grazing
    // incidence one screen pixel crosses many shadow texels and the raw
    // test staircases/acnes; the offset lifts the test off the razor.
    // Geometric normal from derivatives — the SHADED normal jitters with
    // the normal map per pixel and WARBLES the projected uv (observed).
    // World texel size falls out of the ortho matrix itself: the world→ndc
    // x row has length 2/ortho_width (per-cascade, no extra UBO traffic).
    vec3 dpdx = dFdx(wpos);
    vec3 dpdy = dFdy(wpos);
    vec3 gN = normalize(cross(dpdx, dpdy));
    vec3 sun_Ldir = normalize(-sun_dir.xyz);
    if (dot(gN, sun_Ldir) < 0.0)
      gN = -gN; // derivative-normal sign is winding-dependent; face the light
    float g_ndotl   = clamp(dot(gN, sun_Ldir), 0.0, 1.0);
    vec3 sh_row0    = vec3(shmtx[0].x, shmtx[1].x, shmtx[2].x);
    // the band's own dim, not the array's: length(sh_row0) is 2/ortho_width, so
    // this is ortho_width/dim_band — the world size of one texel of THIS band.
    float texel_ws  = (2.0 * band_texel) / max(length(sh_row0), 1e-6);
    // ...while a step of one texel in SLICE uv is 1/array_dim for every band
    // (the band's texels ARE array texels — the viewport is a pixel sub-rect),
    // so every uv step below keeps using sun_shadow_params.w unchanged.
    float uv_scale  = sun_shadow_params.w / max(band_texel, 1e-9);
    float uv_hi     = (uv_scale < 1.0) ? (uv_scale - sun_shadow_params.w) : 0.0;

    // DERIVATIVE-MATCHED filter radius (minification de-aliasing): at
    // distance one screen pixel spans MANY shadow texels — a fixed kernel
    // undersamples and shimmers (observed). Widen the filter to the pixel's
    // world footprint measured in shadow texels (what a mip lookup would
    // do; depth arrays don't mip). Cap keeps far shadows soft-not-melted.
    // pcf_dither (params.y) remains the MINIMUM radius knob.
    float wfoot      = max(length(dpdx), length(dpdy));
    float foot_tex   = wfoot / max(texel_ws, 1e-6);
    float radius_tex = clamp(max(sun_shadow_params.y, foot_tex), 0.25, 8.0);

    float sin_theta = sqrt(max(1.0 - g_ndotl * g_ndotl, 0.0));
    float kreach    = 1.0 + radius_tex; // offset covers the kernel reach
    vec3 wpos_noff  = wpos + gN * (texel_ws * kreach * sin_theta);

    vec4 hpos  = shmtx * vec4(wpos_noff, 1);
    vec3 ndc   = hpos.xyz / hpos.w;
    bool in_window = (abs(ndc.x) < 1.0) && (abs(ndc.y) < 1.0) && (ndc.z > 0.0) && (ndc.z < 1.0);
    if (!in_window)
      return 1.0;
    // v flipped: the raster path uses a negative VkViewport height (GL-style
    // NDC-y-up), so cascade content lands with ndc.y=+1 at texture row 0.
    // ...and scaled into the band's viewport corner (uv_scale 1 = the whole
    // slice = the uniform-dim rig). The viewport origin is the slice origin, so
    // there is no offset term — see the corner note on the render side.
    vec2 base_uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * uv_scale;
    // THE BIAS IS AUTHORED IN WORLD METRES and converted HERE, per band. An ndc
    // constant is not one slack distance but four: each band's ndc unit is its
    // OWN fitted depth range (hundreds of metres apart across the ladder), so a
    // value tight enough for band 0 erases every metre-scale caster in band 3 —
    // trunks and crowns onto the ground stop casting while a big high object
    // survives. depth_range_ws falls out of the ortho z row (length = 1/range),
    // so the conversion costs no UBO traffic and is exact for THIS band.
    vec3 sh_row2         = vec3(shmtx[0].z, shmtx[1].z, shmtx[2].z);
    float depth_range_ws = 1.0 / max(length(sh_row2), 1e-6);
    // slope-scaled bias: base knob grows with tan(theta), clamped (numeric guard)
    float tan_theta = sqrt(max(1.0 - ndotl * ndotl, 0.0)) / max(ndotl, 0.05);
    float bias  = (sun_shadow_params.x / depth_range_ws) * (1.0 + min(tan_theta, 4.0));

    // REDUCED FILTER (see the `fast` note on the signature): ONE bilinear
    // compare on the same uv, same bias, same normal offset. It keeps the
    // hardware's 2x2 interpolation, so the edge is still sub-texel graded
    // rather than binary — what it gives up is the contact-hardening penumbra
    // and the derivative-widened kernel, both of which are sub-blade detail on
    // the surfaces that ask for this.
    if (fast > 0.5)
      return _sun_tap_bilinear(base_uv, slice, ndc.z, bias, uv_hi);

    // PCSS CONTACT HARDENING: penumbra width grows with caster→receiver
    // separation (extended source). Sparse 3x3 blocker search; average the
    // depths in front of the receiver; separation in WORLD units falls out
    // of the ortho z row (length 1/depth_range, same trick as texel_ws).
    // No blockers in the window => fully lit, skip the whole filter.
    // Sun angular radius is a PHYSICAL constant (~0.267 deg, tan ~0.00466);
    // an ARTISTIC softness scale belongs on DirectionalLightData when the
    // lane-B sun model lands (ublk_sun has no free param slot today).
    // depth_range_ws is the one the bias conversion above already derived.
    float search_tex     = clamp(6.0 + foot_tex, 6.0, 12.0);
    float search_step    = sun_shadow_params.w * search_tex * 0.5;
    float blocker_sum = 0.0;
    float blocker_cnt = 0.0;
    for (int x = -1; x <= 1; x++) {
      for (int y = -1; y <= 1; y++) {
        vec2 s_uv = base_uv + vec2(float(x), float(y)) * search_step;
        if (uv_hi > 0.0)
          s_uv = clamp(s_uv, vec2(0.0), vec2(uv_hi)); // stay inside the band's viewport (S2b)
        float d = textureLod(sun_shadow_map, vec3(s_uv, slice), 0).x;
        if ((d + bias) < ndc.z) {
          blocker_sum += d;
          blocker_cnt += 1.0;
        }
      }
    }
    if (blocker_cnt < 0.5)
      return 1.0; // nothing in front of the receiver anywhere in the window
    float avg_blocker  = blocker_sum / blocker_cnt;
    float sep_ws       = (ndc.z - avg_blocker) * depth_range_ws;
    float penumbra_ws  = sep_ws * 0.00932; // 2*tan(sun angular radius)
    float penumbra_tex = penumbra_ws / max(texel_ws, 1e-6);
    radius_tex = clamp(max(radius_tex, penumbra_tex), 0.25, 12.0);

    float pcf_step = sun_shadow_params.w * radius_tex; // derivative+penumbra radius
    // FIXED tent-weighted 3x3 lattice of bilinear taps (~5x5 tent overall).
    // NO per-fragment rotation: random rotation on top of a SMOOTH bilinear
    // signal reads as crawling grain (observed) — it only paid off when the
    // taps were hard binary.
    float lit  = 0.0;
    float wsum = 0.0;
    for (int x = -1; x <= 1; x++) {
      for (int y = -1; y <= 1; y++) {
        float w = ((x == 0) ? 2.0 : 1.0) * ((y == 0) ? 2.0 : 1.0);
        vec2 offs = vec2(float(x), float(y)) * pcf_step;
        lit  += w * _sun_tap_bilinear(base_uv + offs, slice, ndc.z, bias, uv_hi);
        wsum += w;
      }
    }
    return lit / wsum;
  }

  /////////////////////////////////////////////////////////
  // SNAPSHOT FLIP CROSSFADE (S2a). A snapshot flip replaces every band's
  // matrices AND depth at once, which pops wherever the two fits disagree.
  // Both snapshots are resident (two slice ranges of one array), so the fix is
  // to shade BOTH and blend the FACTORS — depth cannot be interpolated, an
  // occlusion result can. Weight 1 = the outgoing snapshot, decayed to 0 over
  // the declared fade window.
  //
  // COST: the fade window is the only time the second evaluation happens; with
  // no fade armed (the default) sun_shadow_fade.x is 0 every frame and this
  // costs one scalar compare over the single-snapshot path.
  /////////////////////////////////////////////////////////
  //
  // `fast` is the per-material reduced-filter selector, threaded down from the
  // material's own call (see _sun_shadow_set_factor). BOTH snapshots of a
  // crossfade take the same value — one surface cannot be filtered two ways
  // inside one blend without the blend itself becoming the artifact.
  float _sun_shadow_factorQ(vec3 wpos, float ndotl, float fast) {
    int cascade_count = int(sun_shadow_params.z + 0.5);
    if (cascade_count <= 0)
      return 1.0; // unshadowed sun
    int cascade = _sun_select_band(wpos, sun_cascade_basis.xyz, sun_split_distances,
                                   sun_split_distances_hi, cascade_count);
    // beyond the outermost band — unshadowed by design
    float cur = (cascade < 0)
              ? 1.0
              : _sun_shadow_set_factor(wpos, ndotl, sun_shadow_matrix[cascade],
                                       float(cascade) + sun_shadow_fade.y,
                                       _sun_band_value(sun_cascade_texel, sun_cascade_texel_hi, cascade), fast);
    float fade_w = sun_shadow_fade.x;
    if (fade_w <= 0.0)
      return cur;
    // the outgoing snapshot was fit around its OWN anchor with its own radii,
    // so it re-selects its own band — a fragment can sit in different bands of
    // the two snapshots and both answers are right for their own maps.
    int pcascade = _sun_select_band(wpos, sun_cascade_basis_prev.xyz, sun_split_distances_prev,
                                    sun_split_distances_prev_hi, cascade_count);
    // the per-band texel table is shared with the current snapshot: a per-band
    // DIM change hard-swaps (no fade), so inside a window both were drawn at
    // the same viewports.
    float prev = (pcascade < 0)
               ? 1.0
               : _sun_shadow_set_factor(wpos, ndotl, sun_shadow_matrix_prev[pcascade],
                                        float(pcascade) + sun_shadow_fade.z,
                                        _sun_band_value(sun_cascade_texel, sun_cascade_texel_hi, pcascade), fast);
    return mix(cur, prev, fade_w);
  }
  float _sun_shadow_factor(vec3 wpos, float ndotl) {
    return _sun_shadow_factorQ(wpos, ndotl, 0.0); // the full evaluator, unchanged
  }

  /////////////////////////////////////////////////////////
  // SKY-HAZE SUN SHADOW — the per-step air occlusion the aerial-perspective
  // march integrates against (armed by SkyHazeInscatterTint.w) now lives in
  // lib_sun_air (sunairtools.i2), because the quarter-res shaft pass runs the
  // same taps and the two looks must not be able to drift apart.
  /////////////////////////////////////////////////////////
  /////////////////////////////////////////////////////////

  // P3.B — return ShadingResult so the fragment-out stage can route
  // diffuse to target1 (MRT) while the existing target0 keeps the
  // composed lit output (specular + diffuse). The previously summed
  // emission, light_maps, and lobe accumulators get routed:
  //   emission   → specular (self-emitted, NOT blurred by SSSS)
  //   light_maps → diffuse  (baked irradiance — SSSS blurs it)
  //   lobes      → see PbrLobeState._accumulator (lobes self-route)
  // modcolor applies to both channels uniformly.
  //
  // `shadow_fast` is the material's REDUCED SUN-FILTER opt-in, threaded through
  // untouched to _sun_shadow_factorQ. It is an ARGUMENT rather than a uniform
  // read so that the value is a compile-time literal for every material that
  // does not declare one: the reduced path then dead-codes out and their
  // generated fragment text is not touched at all.
  //
  // `envspec` is the material's ENVIRONMENT-SPECULAR gain. It scales the IBL
  // specular lobe ONLY — sun/point/spot speculars and every diffuse channel are
  // untouched, so it is not a gloss change, it is a "how much sky does this
  // surface mirror" control. It exists because the environment term has a floor
  // and no ceiling by design (see pbrEnvironmentLightingWithF0): a surface whose
  // shading normal is a poor stand-in for its real microgeometry — a flat
  // foliage card standing in for a leaf cluster — hits grazing Fresnel over
  // whole canopies and reflects the sky uniformly. The honest scope for that
  // correction is the MATERIAL, not the scene's SpecularIntensity and not a
  // global clamp.
  ShadingResult _forward_lightingQE(PbrData pbd, vec3 eyepos, vec3 emission, vec3 modcolor, float matAO, float shadow_fast, float shadow_amb, float envspec) {
    /////////////////////////
    // PBR2 Phase 3 (P3.A) — build the per-fragment surface descriptor.
    // Future node-graph codegen will override selected fields between
    // this point and forward_shading; for P3.A the default-build is the
    // only path. Lobes will read from `surf` once migrated; today they
    // still read from per-extension UBOs and this descriptor is parallel
    // (no behavior delta).
    /////////////////////////
    SurfaceFragment surf = build_surface(pbd, emission);
    /////////////////////////
    // refl.x *= -1.0;
    /////////////////////////
    // light maps
    /////////////////////////
    vec3 light_maps = texture(LightMapArray, vec3(frg_uv0, 0)).xyz * LightMapColors[0];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 1)).xyz * LightMapColors[1];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 2)).xyz * LightMapColors[2];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 3)).xyz * LightMapColors[3];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 4)).xyz * LightMapColors[4];
    light_maps      = light_maps + texture(LightMapArray, vec3(frg_uv0, 5)).xyz * LightMapColors[5];
    /////////////////////////
    // PBR2 Phase 2 — build the lobe state EARLY so modulatory lobes
    // (ior/specular/iridescence) can shift st._F0 BEFORE env_lighting
    // is computed from it. Additive lobes (sheen/clearcoat/diff_trans/
    // transmission/volume) run AFTER, populating st._accumulator and
    // debiting st._weight_remaining.
    /////////////////////////
    vec3  _mrd          = MRD(pbd);
    vec3  _V_dir        = normalize(eyepos - pbd._wpos);
    vec3  _R_dir        = normalize(reflect(-_V_dir, pbd._wnrm));
    vec3  _F0_base      = mix(vec3(0.04), pbd._albedo, _mrd.x);
    float _NdotV        = clamp(dot(pbd._wnrm, _V_dir), 0.0, 1.0);
    PbrLobeState st;
    st._F0               = _F0_base;
    st._F                = fresnelSchlickRoughness(_NdotV, _F0_base, _mrd.y);
    st._N                = pbd._wnrm;
    st._V                = _V_dir;
    st._R                = _R_dir;
    st._metallic         = _mrd.x;
    st._roughness        = _mrd.y;
    st._dialetric        = _mrd.z;
    st._accumulator.specular = vec3(0);
    st._accumulator.diffuse  = vec3(0);
    st._weight_remaining     = 1.0;
    // Modulatory lobes — mutate st._F0 (ior, specular) and st._F
    // (iridescence). Must precede pbrEnvironmentLightingWithF0 so the
    // front BRDF sees the modified Fresnel.
    st = eval_pbr_lobes_modulatory(st, surf, eyepos);
    /////////////////////////
    // env lighting (HDRI) — now uses post-modulatory F0. P3.B: keeps
    // diffuse and specular env terms separated for downstream MRT.
    /////////////////////////
    ShadingResult env_lighting = pbrEnvironmentLightingWithF0(pbd, eyepos, st._F0, matAO);
    env_lighting.specular      = env_lighting.specular * envspec;
    /////////////////////////
    // dynamic lighting
    /////////////////////////
    const vec3 metalbase = vec3(0.04);
    vec3 mrd = MRD(pbd);
    float metallic  = mrd.x;
    float roughness = mrd.y;
    float dialetric = mrd.z;
    vec3 basecolor  = pbd._albedo;
    vec3 diffcolor  = mix(basecolor, vec3(0), metallic);
    vec3 F0    = mix(metalbase, basecolor, metallic);
    vec3 G0    = mix(metalbase, basecolor, 1.0 - metallic);
    vec3 viewdir = normalize(eyepos - pbd._wpos);
    vec3 refl = normalize(reflect(-viewdir, pbd._wnrm));
    /////////////////////////
    // point lighting — P3.B: accumulate diffuse/specular separately.
    /////////////////////////
    LightCtx plc = lcalc_forward(pbd._wpos, pbd, eyepos);
    ShadingResult point_lighting;
    point_lighting.specular = vec3(0);
    point_lighting.diffuse  = vec3(0);
    for (int i = 0; i < point_light_count; i++) {
      plc._lightdel = _lightpos[i].xyz - pbd._wpos;
      vec3 LC       = _lightcolor[i].xyz * _lightcolor[i].w;
      float LR      = _lightsizbias[i].x;
      ShadingResult plr = plcalc_forward(plc, pbd, LR);
      point_lighting.specular += plr.specular * LC;
      point_lighting.diffuse  += plr.diffuse  * LC;
    }
    /////////////////////////
    // spot lighting (fwd)
    /////////////////////////
    ShadingResult spot_lighting;
    spot_lighting.specular = vec3(0);
    spot_lighting.diffuse  = vec3(0);
    //
    for (int i = 0; i < spot_light_count; i++) {
      int j = i + point_light_count;
      /////////////////////
      uint light_tex_slice = _lightTexSlice[j];
      mat4 shmtx           = _shadowmatrix[j];
      vec4 lightcol4       = _lightcolor[j];
      vec3 lightcol        = lightcol4.xyz * lightcol4.w;
      vec3 lightpos        = _lightpos[j].xyz;
      vec4 LSB             = _lightsizbias[j];
      float lightrange     = LSB.x;
      /////////////////////
      vec3 lightdel       = lightpos - pbd._wpos;
      vec4 light_hpos    = (shmtx)*vec4(pbd._wpos, 1);
      vec3 light_ndc     = (light_hpos.xyz / light_hpos.w);
      // v flipped: the depth raster path uses a negative VkViewport height
      // (GL-style NDC-y-up), so shadow content lands with ndc.y=+1 at texture
      // row 0 — match _sun_shadow_factor's flip or spot shadows are y-mirrored.
      vec2 light_uv      = vec2(light_ndc.x * 0.5 + 0.5, 0.5 - light_ndc.y * 0.5);
      float lightz       = light_ndc.z;
      float shadow_factor = 0.0;
      bool light_mask_x = (light_ndc.x > -1) && (light_ndc.x < 1);
      bool light_mask_y = (light_ndc.y > -1) && (light_ndc.y < 1);
      bool light_mask_z = (light_ndc.z > 0) && (light_ndc.z < 1);

      bool light_mask = light_mask_x && light_mask_y && light_mask_z;
      if (light_mask) {
        float bias             = LSB.y; // Increased bias to help with shadow acne
        
        // Percentage-Closer Filtering (PCF)
        int pcf_width_n         = -1;          // Size of the PCF kernel
        int pcf_width_p         = 1;           // Size of the PCF kernel
        int pcf_width           = (pcf_width_p-pcf_width_n) + 1; // Assuming symmetric kernel
        float pcf_filter_size = 1.0 / LSB.z; // Adjust based on your shadow map resolution

        for (int x = pcf_width_n; x <= pcf_width_p; x++) {
          for (int y = pcf_width_n; y <= pcf_width_p; y++) {
            vec2 pcf_uv     = light_uv + vec2(x, y) * pcf_filter_size;
            float pcf_depth_ndc = _sample_depth_cookie(light_tex_slice, pcf_uv);
            shadow_factor += (pcf_depth_ndc + bias) >= lightz ? 1.0 : 0.0;
          }
        }

        shadow_factor /= float(pcf_width*pcf_width);

      } else {
        shadow_factor = 0.0;
      }
      if (!light_mask) shadow_factor = 0.0;
      ////////////////////////////////////////////////////////////
      // Canonical PBR spotlight evaluation (Path A of the spot-PBR
      // refactor — matches plcalc_forward()'s point-light pattern but
      // with the cookie sampled at the SURFACE's projected UV, exactly
      // how UE5/HDRP/Filament/Frostbite do it.
      //
      // Cookie role: the cookie acts as the spotlight's spatial intensity
      // distribution at the surface (radiance pattern), NOT as a separate
      // reflection texture along R. Roughness is handled inside the GGX D
      // term (computeGGX), so the cookie does NOT need GGX-prefiltering —
      // sampling at mip 0 is correct.
      //
      // Result: the projector's bright/dark areas appear in BOTH diffuse
      // and specular contributions where the surface is lit; specular adds
      // a half-vector-aligned highlight whose lobe shape follows the
      // material's roughness (sharp for glossy, broad for rough). The
      // projector pattern is NOT visible inside reflections — that's an
      // SSR/probe concern, not punctual-light math.
      ////////////////////////////////////////////////////////////

      // ====================================================================
      // DEBUG STRIP — minimum viable spotlight specular indicator. ALL
      // attenuations factored out: no cookie, no F0, no metallic/roughness,
      // no GGX (avoids the r=0 div-by-zero issue), no distance falloff, no
      // NdotL outer cosine, no light color, no diffuse contribution.
      //
      // Output:
      //   WHITE pixel  → reflection vector points toward the spotlight,
      //                  i.e. you should see the projector reflected here.
      //   BLACK pixel  → no reflection geometry hit this pixel.
      //   BLACK outside spot frustum (shadow_factor gates).
      //
      // This isolates just the geometry: "does the surface's reflection
      // vector point at the spotlight?" If you see a bright spot on each
      // ball where the eye's reflection should land on the spotlight, the
      // basic math works and we can layer roughness / cookie / BRDF back
      // on top. If you still see only diffuse or nothing, the geometry is
      // wrong upstream and we need to look elsewhere.
      // ====================================================================
      // ====================================================================
      // DEBUG VIZ — show every quantity of interest, no thresholds, so we
      // can see what's happening pixel by pixel:
      //
      //   Red   = surface's own light_uv.x (already known to work for
      //           diffuse). Shows where shmtx projects wpos. If this isn't
      //           a smooth gradient inside the spotlight cone, shmtx is
      //           broken upstream.
      //   Green = sign(clip_dir.w) for R as a direction. 0.5 = neutral,
      //           1.0 = positive (R points "into" light forward),
      //           0.0 = negative (R points "back toward" lens).
      //   Blue  = sign(t_hit) — 1.0 if the ray-plane t is positive
      //           (meaning ray is heading forward toward the lens).
      //
      // Look for: SURFACES SHOULD BE BRIGHTER WHERE THE SPOTLIGHT IS
      // POINTING (red gradient gives a sanity check) and the ball points
      // that "should reflect" the spot should have non-trivial green/blue.
      //
      // After diagnosis we'll restore the actual masking logic.
      // ====================================================================
      vec3 viewdir = normalize(eyepos - pbd._wpos);
      vec3 R       = reflect(-viewdir, pbd._wnrm);

      vec4 clip_origin = shmtx * vec4(pbd._wpos, 1.0);
      vec4 clip_dir    = shmtx * vec4(R,         0.0);

      float denom_zw = clip_dir.z + clip_dir.w;
      float t_hit    = (abs(denom_zw) > 1e-6)
                     ? (-(clip_origin.z + clip_origin.w) / denom_zw)
                     : -1.0;

      // Direction-at-infinity projection of R through the spotlight matrix
      // gives us the cookie UV that the surface "sees" via reflection.
      //   dir_clip.w < 0  →  R points back toward the lens.
      //   cookie_uv      = dir_ndc.xy * 0.5 + 0.5  (in [0,1] when in cone)
      bool ray_to_lens = (clip_dir.w < 0.0);
      vec3 dir_ndc     = clip_dir.xyz / clip_dir.w;
      bool xy_in_cone  = (abs(dir_ndc.x) < 1.0) && (abs(dir_ndc.y) < 1.0);
      vec2 cookie_uv   = dir_ndc.xy * 0.5 + 0.5;

      // Roughness-blurred mip — same shape as IBL specular: roughness² × N.
      float spec_level = roughness * 16.0;

      vec3 cookie_refl = (ray_to_lens && xy_in_cone)
        ? _sample_color_cookie(light_tex_slice, spec_level, cookie_uv).xyz
        : vec3(0.0);

      // F0-weighted reflection. NdotV-based Fresnel (view-angle, like IBL
      // specular). Dielectrics → ~4% gray. Metals → albedo-tinted.
      vec3  V_unit = normalize(eyepos - pbd._wpos);
      float NdotV  = saturateF(dot(pbd._wnrm, V_unit));
      vec3  F      = fresnelSchlickRoughness(NdotV, F0, roughness);

      // ---- Diffuse: cookie at the SURFACE's UV is the spotlight's spatial
      // ---- intensity pattern. The selected diffuse BRDF with kS/kD energy
      // ---- split, modulated by lightcol (HDR intensity) and 1/dist² falloff.
      vec3  lightdir       = normalize(lightpos - pbd._wpos);
      float NdotL          = saturateF(dot(pbd._wnrm, lightdir));
      vec3  cookie_at_surf = _sample_color_cookie(light_tex_slice, 0, light_uv).xyz;
      vec3  kD             = (vec3(1.0) - F) * (1.0 - metallic);
      float Ldist          = length(lightpos - pbd._wpos);
      float atten          = 1.0 / (Ldist * Ldist);
      vec3  diffuse_contrib = diffuseBRDF(DiffuseBrdfModel, pbd._albedo, kD,
                                          roughness, pbd._wnrm, V_unit, lightdir)
                            * cookie_at_surf * lightcol * NdotL * atten;

      // ---- Specular: F-weighted cookie reflection, modulated by the
      // ---- spotlight's HDR intensity (lightcol) so it matches the
      // ---- diffuse term's brightness scale. Not distance-attenuated —
      // ---- this is "see the lens" behavior, not photons-on-surface.
      // ---- Faded by (1 - sqrt(roughness)): full at R=0, gone by R=1.
      // ---- (sqrt curves the falloff so most of the fade happens early
      // ---- in the roughness range, matching how reflections wash out
      // ---- visually on slightly-rough surfaces.)
      float refl_visibility = pow(1.0 - pow(roughness,0.5),1)*0.0003;
      vec3 specular_contrib = cookie_refl * F * lightcol * refl_visibility;
      // ---- Shadow gates only the diffuse term (occluders block direct
      // ---- light); the cookie reflection is the surface "mirroring the
      // ---- lens" — passes through regardless.
      // P3.B: keep channels split. specular passes through, diffuse
      // gated by shadow_factor.
      spot_lighting.specular += specular_contrib;
      spot_lighting.diffuse  += diffuse_contrib * shadow_factor;
    }
    /////////////////////////
    // directional sun (SKYLIGHT lane A) — cascade-shadowed, no attenuation.
    // Same GGX/Smith/Fresnel terms as plcalc_forward. has_sun gates ALL
    // work: sunless scenes add exact zeros (byte-identity contract).
    /////////////////////////
    ShadingResult sun_lighting;
    sun_lighting.specular = vec3(0);
    sun_lighting.diffuse  = vec3(0);
    // SKY OCCLUSION — what the sun's two shadow factors are allowed to take out
    // of the IMAGE-BASED term (see sun_shadow_ibl_weights in stdtools.i2). 1 =
    // env untouched, which is what a sunless frame and a weight of 0 both give,
    // so the shipped rig is byte-identical here.
    float sky_atten = 1.0;
    // The direct-sun factor (cascade x cookie), exported from the sun block for the
    // reduced-filter emission gate below. 1 with no sun: the DSL's has_sun gate
    // already zeroes sun-driven emission on sunless frames.
    float sun_visibility = 1.0;
    if (sun_dir.w > 0.5) {
      vec3 sun_L        = normalize(-sun_dir.xyz);
      vec3 sun_half     = normalize(plc._viewdir + sun_L);
      float sun_ggx     = computeGGX(plc._normal, sun_half, plc._roughness);
      float sun_geo     = geometrySmith(plc._normal, plc._viewdir, sun_L, plc._roughness);
      vec3 sun_fres     = fresnelSchlickRoughness(satdot(sun_half, plc._viewdir), plc._F0, plc._roughness);
      vec3 sun_kd       = (vec3(1) - sun_fres) * (1.0 - plc._metallic);
      vec3 sun_diff     = diffuseBRDF(DiffuseBrdfModel, pbd._albedo, sun_kd,
                                      plc._roughness, plc._normal, plc._viewdir, sun_L) * DiffuseLevel;
      vec3 sun_numer    = min(sun_ggx * sun_geo * SpecularLevel, 16) * sun_fres;
      float sun_denom   = 4 * satdot(plc._normal, plc._viewdir) * satdot(plc._normal, sun_L) + EPSILON;
      vec3 sun_spec     = sun_numer / max(0.0625, sun_denom);
      float sun_ndotl   = satdot(plc._normal, sun_L);
      // cascade occlusion (geometry) x cookie occlusion (cloud deck) — their
      // product is the DIRECT term's factor, always and in full.
      float sun_cascade = _sun_shadow_factorQ(pbd._wpos, sun_ndotl, shadow_fast);
      // CASCADE SHADOW FLOOR (sun_shadow_ibl_weights.z, a look number): shadowed
      // direct light keeps this fraction instead of going to zero — the one lever
      // that BRIGHTENS shadows past the stock look (the IBL weights only darken).
      // Applied to the cascade before the cookie product and before the ambient
      // slice below, so every consumer sees one consistent floored factor.
      sun_cascade = mix(clamp(sun_shadow_ibl_weights.z, 0.0, 1.0), 1.0, sun_cascade);
      vec2  cookie      = _sun_cookie_sample(pbd._wpos);
      float sun_cookie  = cookie.x;
      float sun_shadow  = sun_cascade * sun_cookie;
      // The IBL term takes a DECLARED FRACTION of each, and the two factors are
      // kept separate for exactly that: the cloud's weight is nonzero by default
      // (it occludes sky), the cascade's is zero (it occludes the disc).
      // The CLOUD leg rides COVERAGE (1 - a), not the beam transmittance: the
      // beam's exp(-tau*a) saturates near-binary past a~0.3, so a sky driven by
      // it snaps to 1-weight under any cloud worth seeing instead of grading
      // with the deck. The DISC keeps the transmittance above — a sun is
      // blocked or it is not; a sky is partly covered.
      // Reduced-filter materials (the grass carpet) carry their OWN cascade->IBL
      // weight (shadow_ambient, a live material param): ambient dominates a blade's
      // color, so the carpet needs a far bigger ambient bite than the scene-wide
      // sun dial — which stays terrain-tuned (owner look calls 2026-08-07: any
      // shared value was wrong for one of the two).
      float w_casc = (shadow_fast > 0.5) ? clamp(shadow_amb, 0.0, 1.0)
                                         : clamp(sun_shadow_ibl_weights.y, 0.0, 1.0);
      sky_atten = mix(1.0, 1.0 - cookie.y, clamp(sun_shadow_ibl_weights.x, 0.0, 1.0))
                * mix(1.0, sun_cascade,    w_casc);
      vec3 sun_LC       = sun_color.xyz * sun_color.w;
      sun_lighting.diffuse  = sun_diff * sun_ndotl * sun_LC * sun_shadow;
      sun_lighting.specular = sun_spec * sun_ndotl * sun_LC * sun_shadow;
      sun_visibility = sun_shadow;
    }
    // Reduced-filter materials (grass) declare their emission as TRANSMITTED
    // sunlight (the backlit glow), so it rides the same direct-sun factor as the
    // disc: a blade the sun does not reach — tree shadow or cloud deck — cannot
    // glow with light passing through it.
    if (shadow_fast > 0.5)
      emission *= sun_visibility;
    //
    /////////////////////////
    // Additive lobes (sheen / clearcoat / diff_trans / transmission /
    // volume) run AFTER env+point+spot. Each lobe routes to its own
    // channel of st._accumulator (P3.B).
    /////////////////////////
    st = eval_pbr_lobes_additive(st, surf, eyepos);
    // Energy chain: lobes that take energy from the base BRDF (sheen,
    // clearcoat, diffuse_transmission, transmission) debit
    // _weight_remaining; multiply the base contribution by it. P3.B
    // applies weight to BOTH channels equally (proper diffuse/spec
    // conservation refinement is deferred to P3.E).
    float base_weight = clamp(st._weight_remaining, 0.0, 1.0);
    /////////////////////////
    // P3.B — final composite split by channel. emission folded into
    // specular (self-emitted, NOT blurred by SSSS); light_maps folded
    // into diffuse (they're baked diffuse irradiance).
    /////////////////////////
    ShadingResult result;
    // sky_atten rides the ENV channels only (the direct terms already carry
    // their own full shadow factor); baked light_maps are authored irradiance
    // and are not the live sky, so they stay out of it.
    result.specular = ((env_lighting.specular * sky_atten + point_lighting.specular + spot_lighting.specular + sun_lighting.specular) * base_weight
                      + emission
                      + st._accumulator.specular) * modcolor;
    result.diffuse  = ((env_lighting.diffuse  * sky_atten + point_lighting.diffuse  + spot_lighting.diffuse  + sun_lighting.diffuse)  * base_weight
                      + light_maps
                      + st._accumulator.diffuse) * modcolor;
    /////////////////////////
    // AERIAL PERSPECTIVE — armed rides in the uniform (zero-buffer fail-safe:
    // a pipeline with no binder takes the untaken branch; the frame is
    // BYTE-identical). In-scatter lands in SPECULAR by the emission precedent
    // (airlight is not surface irradiance; SSSS must not blur it);
    // extinction multiplies BOTH channels.
    // Transparent pass: straight-alpha blending of two hazed layers is a convex
    // blend of the near and far ray's haze — monotone, no double count. Accepted
    // v1 approximation.
    /////////////////////////
    if (SkyHazeDensity.w > 0.5) {
      // SHADOWED-MARCH MODE, out of SkyHazeInscatterTint.w:
      //   0 = off       — no cascade taps; the plain unshadowed march.
      //   1 = inline    — the taps run HERE, per fragment, at full resolution:
      //                   8 march steps x 4 jittered sub-taps = 32 cascade
      //                   fetches, which is what the third mode exists to price.
      //   2 = quarter   — the shadow arm has ALREADY been marched, at quarter
      //                   resolution, into its own target, and a screen-space
      //                   pass subtracts it from this pass's output once the
      //                   opaque image is complete (fwdnode_impl_hazeshaft.cpp).
      //                   So this fragment marches UNSHADOWED and the taps are
      //                   skipped entirely — the whole point of the mode. The
      //                   subtraction is exact by construction; see
      //                   skyAerialPerspectiveShadowLoss.
      // Ranges, not equality: the value is a float that has been through a UBO.
      SunAirSteps hsh;
      hsh._s03 = vec4(1.0);
      hsh._s47 = vec4(1.0);
      if (SkyHazeInscatterTint.w > 0.5 && SkyHazeInscatterTint.w < 1.5) {
        hsh = _sun_air_shadow_steps(eyepos, pbd._wpos);
      }
      HazeResult hz = skyAerialPerspectiveShadowed(eyepos, pbd._wpos, normalize(SkySunDirection.xyz), hsh._s03, hsh._s47);
      result.specular = result.specular * hz._transmittance + hz._inscatter;
      result.diffuse  = result.diffuse  * hz._transmittance;
    }
    return result;
  }
  ShadingResult _forward_lightingQ(PbrData pbd, vec3 eyepos, vec3 emission, vec3 modcolor, float matAO, float shadow_fast, float shadow_amb) {
    return _forward_lightingQE(pbd, eyepos, emission, modcolor, matAO, shadow_fast, shadow_amb, 1.0); // full env specular
  }
  ShadingResult _forward_lightingX(PbrData pbd, vec3 eyepos, vec3 emission, vec3 modcolor, float matAO) {
    return _forward_lightingQ(pbd, eyepos, emission, modcolor, matAO, 0.0, 0.0); // full sun filter
  }
  ShadingResult _forward_lightingZQE(vec3 modcolor, vec3 albedo, vec3 ambrufmtl, vec3 emission, vec3 eyepos, vec3 normal, bool emissive, float shadow_fast, float shadow_amb, float envspec) {
    PbrData pbr;
    pbr._emissive  = emissive;
    pbr._albedo    = albedo;
    pbr._metallic  = ambrufmtl.z;
    pbr._roughness = ambrufmtl.y;
    pbr._wpos      = frg_wpos.xyz;
    pbr._wnrm      = normal;
    pbr._fogZ      = 0.0;
    pbr._atmos     = 0.0;
    pbr._alpha     = 1.0;
    return _forward_lightingQE(pbr, eyepos, emission, modcolor, ambrufmtl.x, shadow_fast, shadow_amb, envspec);  // ambrufmtl.x = material AO (ptex3d surface.ao)
  }
  ShadingResult _forward_lightingZQ(vec3 modcolor, vec3 albedo, vec3 ambrufmtl, vec3 emission, vec3 eyepos, vec3 normal, bool emissive, float shadow_fast, float shadow_amb) {
    return _forward_lightingZQE(modcolor, albedo, ambrufmtl, emission, eyepos, normal, emissive, shadow_fast, shadow_amb, 1.0);
  }
  ShadingResult _forward_lightingZ(vec3 modcolor, vec3 albedo, vec3 ambrufmtl, vec3 emission, vec3 eyepos, vec3 normal, bool emissive) {
    return _forward_lightingZQ(modcolor, albedo, ambrufmtl, emission, eyepos, normal, emissive, 0.0, 0.0);
  }
}

///////////////////////////////////////////////////////////////
libblock lib_fwd     //
    : lib_fwd_impl { //
  /////////////////////////////////////////////////////////

  // P3.B — all forward_lighting_* wrappers return ShadingResult so the
  // fragment-out stage can split spec→target0 and diffuse→target1.
  ShadingResult _forward_lighting(vec3 modcolor, vec3 eyepos) {
    vec2 uvinvy    = abs(frg_uv0.xy);
    // ModAlbedo is the per-material albedo multiplier (= mtl->_baseColor).
    // It modulates the textured albedo here, NOT post-output. This keeps
    // albedo out of the env-IBL specular path inside _forward_lightingX.
    vec3 albedo    = texture(CNMREA, vec3(uvinvy, 0)).xyz * ModAlbedo.xyz;
    vec3 TN        = texture(CNMREA, vec3(uvinvy, 1)).xyz;
    vec3 ambrufmtl = texture(CNMREA, vec3(uvinvy, 2)).xyz;
    vec3 emission  = texture(CNMREA, vec3(uvinvy, 3)).xyz;
    vec3 N         = TN * 2.0 - vec3(1, 1, 1);
    bool emissive  = length(TN) < 0.1;
    vec3 normal    = normalize(frg_tbn * N);
    if (!gl_FrontFacing) normal = -normal;
    // _forward_lightingZ already applies modcolor inside _forward_lightingX;
    // the historical extra `* modcolor` multiply here is preserved by
    // applying it to both channels.
    ShadingResult r = _forward_lightingZ(modcolor, albedo, ambrufmtl, emission, eyepos, normal, emissive);
    r.specular *= modcolor;
    r.diffuse  *= modcolor;
    return r;
  }

  ShadingResult forward_lighting_mono(vec3 modcolor) {
    return _forward_lighting(modcolor, EyePostion);
  }

  // Per-channel alpha variant. Caller uses (r.lit.diffuse + r.lit.specular)
  // for tonal output and the alpha separately. Struct lives in deftools.i2.
  ForwardAlphaResult forward_lighting_mono_alpha(vec3 modcolor) {
    vec2 uvinvy = abs(frg_uv0.xy);
    float alpha = texture(CNMREA, vec3(uvinvy, 0)).a;
    ForwardAlphaResult r;
    r.lit   = _forward_lighting(modcolor, EyePostion);
    r.alpha = alpha;
    return r;
  }

  ShadingResult forward_lighting_ntex(vec3 modcolor) {
    vec2 uvinvy    = abs(frg_uv0.xy);
    // No-texture path: vertex color and per-material ModAlbedo both feed
    // albedo as multiplicative factors, so mtl.baseColor tints all vertices
    // uniformly and the default white ModAlbedo leaves vertex color as-is.
    vec3 albedo    = ModAlbedo.xyz * modcolor;
    vec3 TN        = vec3(0.5,0.5,1);
    vec3 ambrufmtl = vec3(1, RoughnessFactor, MetallicFactor);
    vec3 emission  = vec3(0,0,0);
    vec3 N         = TN * 2.0 - vec3(1, 1, 1);
    bool emissive  = false;
    vec3 normal    = normalize(frg_tbn * N);
    if (!gl_FrontFacing) normal = -normal;
    return _forward_lightingZ(vec3(1), albedo, ambrufmtl, emission, EyePostion, normal, emissive);
  }
}
