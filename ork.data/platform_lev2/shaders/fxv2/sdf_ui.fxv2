///////////////////////////////////////////////////////////////
// SDF-based UI rendering with rounded corners
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default { glsl_version = "150"; }
///////////////////////////////////////////////////////////////
// Uniforms
///////////////////////////////////////////////////////////////

uniform_block sdf_params (descriptor_set 0) { //
  mat4 mvp;
  vec4 ModColor;
  vec4 fill_color;        // interior color
  vec4 border_color;      // outline color
  vec2 box_size;          // width, height in pixels
  vec2 box_pos;           // x, y position
  float corner_radius;    // corner rounding in pixels
  float border_width;     // outline thickness in pixels
}

///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////

vertex_interface vif_sdf_box : sdf_params {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv;
    vec2 frg_pixel_pos;
  }
}

fragment_interface fif_sdf_box : vif_sdf_box {
  outputs {
    vec4 out_clr;
  }
}

///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////

state_block sb_sdf_ui : default {
  BlendMode = ALPHA;
  CullTest  = OFF;
  DepthTest = OFF;
  DepthMask = OFF;
}

///////////////////////////////////////////////////////////////
// Shaders
///////////////////////////////////////////////////////////////

vertex_shader vs_sdf_box : vif_sdf_box {
  gl_Position = mvp * position;
  frg_uv = uv0;
  // Convert UV (0-1) to pixel coordinates centered at box center
  frg_pixel_pos = (uv0 - vec2(0.5, 0.5)) * box_size;
}

fragment_shader ps_sdf_box : fif_sdf_box {

  // Signed distance field for rounded box
  // Returns negative inside, positive outside, zero at edge
  vec2 half_size = box_size * 0.5;
  vec2 q = abs(frg_pixel_pos) - half_size + corner_radius;
  float dist = min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - corner_radius;

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float naa = aa*-1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width*-1.0;
    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }
  float out_alpha = final_color.a * edge_alpha;
  if(out_alpha<0.01){
    discard;
  }
  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

///////////////////////////////////////////////////////////////
// Techniques
///////////////////////////////////////////////////////////////

technique sdf_box {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_box;
    state_block     = sb_sdf_ui;
  }
}
