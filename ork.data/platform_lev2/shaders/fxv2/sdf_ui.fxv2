///////////////////////////////////////////////////////////////
// SDF-based UI rendering with rounded corners
///////////////////////////////////////////////////////////////
import "sdftools.i2";
fxconfig fxcfg_default { glsl_version = "150"; }
///////////////////////////////////////////////////////////////
// Uniforms
///////////////////////////////////////////////////////////////

uniform_block sdf_params (descriptor_set 0) { //
  mat4 mvp;
  vec4 ModColor;
  vec4 fill_color;        // interior color
  vec4 border_color;      // outline color
  vec4 corner_radii;      // per-corner radii: TL, TR, BR, BL
  vec2 box_size;          // width, height in pixels
  vec2 box_pos;           // x, y position
  float corner_radius;    // corner rounding in pixels (uniform)
  float border_width;     // outline thickness in pixels
  float shape_param;      // multipurpose: circle radius, capsule axis, etc.
}

///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////

vertex_interface vif_sdf_box : sdf_params {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv;
    vec2 frg_pixel_pos;
  }
}

fragment_interface fif_sdf_box : vif_sdf_box {
  outputs {
    vec4 out_clr;
  }
}

///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////

state_block sb_sdf_ui : default {
  BlendMode = ALPHA;
  CullTest  = OFF;
  DepthTest = OFF;
  DepthMask = OFF;
}

///////////////////////////////////////////////////////////////
// Shaders
///////////////////////////////////////////////////////////////

vertex_shader vs_sdf_box : vif_sdf_box {
  gl_Position = mvp * position;
  frg_uv = uv0;
  // Convert UV (0-1) to pixel coordinates centered at box center
  frg_pixel_pos = (uv0 - vec2(0.5, 0.5)) * box_size;
}

fragment_shader ps_sdf_box : fif_sdf_box {

  // Signed distance field for rounded box
  // Returns negative inside, positive outside, zero at edge
  vec2 half_size = box_size * 0.5;
  vec2 q = abs(frg_pixel_pos) - half_size + corner_radius;
  float dist = min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - corner_radius;

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float naa = aa*-1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width*-1.0;
    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }
  float out_alpha = final_color.a * edge_alpha;
  if(out_alpha<0.01){
    discard;
  }
  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

///////////////////////////////////////////////////////////////
// Techniques
///////////////////////////////////////////////////////////////

technique sdf_box {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_box;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Per-Corner Rounded Box (for tabs with different corner radii)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_box_per_corner : fif_sdf_box {

  // Per-corner rounded box SDF
  // corner_radii: x=TL, y=TR, z=BR, w=BL
  vec2 half_size = box_size * 0.5;
  vec2 p = frg_pixel_pos;

  // Select corner radius based on quadrant
  float r;
  if (p.x < 0.0 && p.y < 0.0) {
    r = corner_radii.x;  // Top-left
  } else if (p.x >= 0.0 && p.y < 0.0) {
    r = corner_radii.y;  // Top-right
  } else if (p.x >= 0.0 && p.y >= 0.0) {
    r = corner_radii.z;  // Bottom-right
  } else {
    r = corner_radii.w;  // Bottom-left
  }

  vec2 q = abs(p) - half_size + r;
  float dist = min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r;

  // Anti-aliasing and border (same as sdf_box)
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_box_per_corner {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_box_per_corner;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Circle (for buttons, indicators, dots)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_circle : fif_sdf_box {

  // Circle SDF - shape_param is the radius
  float radius = shape_param;
  float dist = length(frg_pixel_pos) - radius;

  // Anti-aliasing and border
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_circle {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_circle;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Equilateral Triangle (for arrows, indicators, patterns)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_triangle 
  : fif_sdf_box
  : lib_sdf2dtools {

  // Distance from center in pixel space for circles
  float dist = length(frg_pixel_pos);

  vec2 nspace = frg_uv * 2.0 - vec2(1.0,1.0);

  float radius = 0.85;
  float d = sdEquilateralTriangle(nspace, radius);
  float mask = d > 0.0 ? 0.0 : 1.0;
  out_clr = vec4(fill_color.xyz * mask, mask);
}

technique sdf_triangle {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_triangle;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Ring/Donut (for progress indicators, badges)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_ring : fif_sdf_box {

  // Ring SDF - shape_param is inner radius (outer is determined by box_size)
  float inner_radius = shape_param;
  float outer_radius = min(box_size.x, box_size.y) * 0.5;
  float dist_center = length(frg_pixel_pos);

  // Distance to ring (positive outside, negative inside ring band)
  float dist = abs(dist_center - (outer_radius + inner_radius) * 0.5) - (outer_radius - inner_radius) * 0.5;

  // Anti-aliasing and border
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_ring {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_ring;
    state_block     = sb_sdf_ui;
  }
}
