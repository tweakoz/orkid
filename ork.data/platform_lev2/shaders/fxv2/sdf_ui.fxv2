///////////////////////////////////////////////////////////////
// SDF-based UI rendering with rounded corners
///////////////////////////////////////////////////////////////
import "sdftools.i2";
fxconfig fxcfg_default { glsl_version = "150"; }
///////////////////////////////////////////////////////////////
// Uniforms
///////////////////////////////////////////////////////////////

uniform_block sdf_params (descriptor_set 0) { //
  mat4 mvp;
  vec4 ModColor;
  vec4 fill_color;        // interior color
  vec4 border_color;      // outline color
  vec4 corner_radii;      // per-corner radii: TL, TR, BR, BL
  vec2 box_size;          // width, height in pixels
  vec2 box_pos;           // x, y position
  float corner_radius;    // corner rounding in pixels (uniform)
  float border_width;     // outline thickness in pixels
  float shape_param;      // multipurpose: circle radius, capsule axis, etc.
}

///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////

vertex_interface vif_sdf_box : sdf_params {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv;
    vec2 frg_pixel_pos;
  }
}

fragment_interface fif_sdf_box : vif_sdf_box {
  outputs {
    vec4 out_clr;
  }
}

///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////

state_block sb_sdf_ui : default {
  BlendMode = ALPHA;
  CullTest  = OFF;
  DepthTest = OFF;
  DepthMask = OFF;
}

///////////////////////////////////////////////////////////////
// Shaders
///////////////////////////////////////////////////////////////

vertex_shader vs_sdf_box : vif_sdf_box {
  gl_Position = mvp * position;
  frg_uv = uv0;
  // Convert UV (0-1) to pixel coordinates centered at box center
  frg_pixel_pos = (uv0 - vec2(0.5, 0.5)) * box_size;
}

fragment_shader ps_sdf_box : fif_sdf_box {

  // Signed distance field for rounded box
  // Returns negative inside, positive outside, zero at edge
  vec2 half_size = box_size * 0.5;
  vec2 q = abs(frg_pixel_pos) - half_size + corner_radius;
  float dist = min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - corner_radius;

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float naa = aa*-1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width*-1.0;
    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }
  float out_alpha = final_color.a * edge_alpha;
  if(out_alpha<0.01){
    discard;
  }
  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

///////////////////////////////////////////////////////////////
// Techniques
///////////////////////////////////////////////////////////////

technique sdf_box {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_box;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Per-Corner Rounded Box (for tabs with different corner radii)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_box_per_corner : fif_sdf_box {

  // Per-corner rounded box SDF
  // corner_radii: x=TL, y=TR, z=BR, w=BL
  vec2 half_size = box_size * 0.5;
  vec2 p = frg_pixel_pos;

  // Select corner radius based on quadrant
  float r;
  if (p.x < 0.0 && p.y < 0.0) {
    r = corner_radii.x;  // Top-left
  } else if (p.x >= 0.0 && p.y < 0.0) {
    r = corner_radii.y;  // Top-right
  } else if (p.x >= 0.0 && p.y >= 0.0) {
    r = corner_radii.z;  // Bottom-right
  } else {
    r = corner_radii.w;  // Bottom-left
  }

  vec2 q = abs(p) - half_size + r;
  float dist = min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r;

  // Anti-aliasing and border (same as sdf_box)
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_box_per_corner {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_box_per_corner;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Circle (for buttons, indicators, dots)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_circle : fif_sdf_box {

  // Circle SDF - shape_param is the radius
  float radius = shape_param;
  float dist = length(frg_pixel_pos) - radius;

  // Anti-aliasing and border
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_circle {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_circle;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Equilateral Triangle (for arrows, indicators, patterns)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_triangle
  : fif_sdf_box
  : lib_sdf2dtools {

  // Convert to normalized space (-1 to 1)
  vec2 nspace = frg_uv * 2.0 - vec2(1.0, 1.0);

  // Apply rotation (shape_param is rotation angle in radians)
  float rotation = shape_param;
  float c = cos(rotation);
  float s = sin(rotation);
  vec2 rotated = vec2(
    nspace.x * c - nspace.y * s,
    nspace.x * s + nspace.y * c
  );

  // Calculate triangle SDF with radius 0.85 (fits well in unit square)
  float radius = 0.707;
  float dist = sdEquilateralTriangle(rotated, radius);

  // Apply corner rounding if requested
  if (corner_radius > 0.0) {
    // Convert corner_radius from pixels to normalized space
    vec2 half_size = box_size * 0.5;
    float min_size = min(half_size.x, half_size.y);
    float normalized_radius = (corner_radius / min_size) * radius;
    dist = dist - normalized_radius;
  }

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    // Convert border_width from pixels to normalized space
    vec2 half_size = box_size * 0.5;
    float min_size = min(half_size.x, half_size.y);
    float normalized_border = (border_width / min_size) * radius;
    float nborder = normalized_border * -1.0;

    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder + naa, nborder + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_triangle {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_triangle;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Ring/Donut (for progress indicators, badges)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_ring : fif_sdf_box {

  // Ring SDF - shape_param is inner radius (outer is determined by box_size)
  float inner_radius = shape_param;
  float outer_radius = min(box_size.x, box_size.y) * 0.5;
  float dist_center = length(frg_pixel_pos);

  // Distance to ring (positive outside, negative inside ring band)
  float dist = abs(dist_center - (outer_radius + inner_radius) * 0.5) - (outer_radius - inner_radius) * 0.5;

  // Anti-aliasing and border
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  vec4 final_color;
  if (border_width > 0.0) {
    float nborder_width = border_width * -1.0;
    float border_blend = smoothstep(nborder_width + naa, nborder_width + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_ring {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_ring;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Pause Icon (two vertical bars)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_pause
  : fif_sdf_box
  : lib_sdf2dtools {

  // Convert to normalized space (-1 to 1)
  vec2 nspace = frg_uv * 2.0 - vec2(1.0, 1.0);

  // shape_param is spacing between bars (default 0.3)
  float spacing = (shape_param > 0.0) ? shape_param : 0.3;

  // Enforce spacing constraints
  spacing = clamp(spacing, 0.1, 1.2);  // Min 10%, max 120% of width

  // Fixed bar width proportion
  float bar_width_prop = 0.25;  // 25% of total width per bar

  // Calculate margin from spacing
  // Total space: margin*2 + bar_width*2 + spacing = 2.0
  // Therefore: margin = (2.0 - bar_width*2 - spacing) / 2
  float margin = (2.0 - (bar_width_prop * 2.0) - spacing) * 0.5;

  // Enforce minimum margin
  margin = max(margin, 0.05);

  // Recalculate spacing if margin was clamped to ensure valid layout
  // spacing = 2.0 - margin*2 - bar_width*2
  float actual_spacing = 2.0 - (margin * 2.0) - (bar_width_prop * 2.0);

  // corner_radius from pixels to normalized space
  vec2 half_size = box_size * 0.5;
  float min_size = min(half_size.x, half_size.y);
  float norm_corner_radius = (corner_radius / min_size);

  // Left bar position (in normalized space -1 to 1)
  float left_bar_center = -1.0 + margin + bar_width_prop;
  // Right bar position
  float right_bar_center = 1.0 - margin - bar_width_prop;

  // Bar dimensions in normalized space
  vec2 bar_half_size = vec2(bar_width_prop, 0.8);  // 80% height

  // Left bar SDF (centered rounded rectangle)
  vec2 p_left = abs(nspace - vec2(left_bar_center, 0.0)) - bar_half_size;
  float dist_left = sdRoundedBox(nspace - vec2(left_bar_center, 0.0), bar_half_size, norm_corner_radius);

  // Right bar SDF (centered rounded rectangle)
  float dist_right = sdRoundedBox(nspace - vec2(right_bar_center, 0.0), bar_half_size, norm_corner_radius);

  // Combine both bars (minimum distance = union)
  float dist = min(dist_left, dist_right);

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float naa = aa * -1.0;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    // Convert border_width from pixels to normalized space
    float normalized_border = (border_width / min_size);
    float nborder = normalized_border * -1.0;

    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder + naa, nborder + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_pause {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_pause;
    state_block     = sb_sdf_ui;
  }
}

///////////////////////////////////////////////////////////////
// Star/Pentagram (for ratings, decorations)
///////////////////////////////////////////////////////////////

fragment_shader ps_sdf_star
  : fif_sdf_box
  : lib_sdf2dtools {

  // Convert to normalized space (-1 to 1)
  vec2 nspace = frg_uv * 2.0 - vec2(1.0, 1.0);

  // Apply rotation (shape_param is rotation angle in radians)
  float rotation = shape_param;
  float c = cos(rotation);
  float s = sin(rotation);
  vec2 rotated = vec2(
    nspace.x * c - nspace.y * s,
    nspace.x * s + nspace.y * c
  );

  // Calculate star SDF with radius that fits well in unit square
  float radius = 0.707;
  float dist = sdPentagram(rotated, radius);

  // Anti-aliasing using derivatives
  float aa = fwidth(dist) * 0.5;
  float neg1 = -1.0;
  //float naa = aa * -1.0;
  float naa = aa * neg1;
  float edge_alpha = 1.0 - smoothstep(naa, aa, dist);

  // Determine color with anti-aliased border transition
  vec4 final_color;
  if (border_width > 0.0) {
    // Convert border_width from pixels to normalized space
    vec2 half_size = box_size * 0.5;
    float min_size = min(half_size.x, half_size.y);
    float normalized_border = (border_width / min_size) * radius;
    float nborder = normalized_border * neg1;

    // Smoothly transition from fill to border at inner edge
    float border_blend = smoothstep(nborder + naa, nborder + aa, dist);
    final_color = mix(fill_color, border_color, border_blend);
  } else {
    // No border - just fill color
    final_color = fill_color;
  }

  float out_alpha = final_color.a * edge_alpha;
  if (out_alpha < 0.01) {
    discard;
  }

  // Apply modulation and edge anti-aliasing
  out_clr = final_color * ModColor;
  out_clr.a = out_alpha;
}

technique sdf_star {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sdf_box;
    fragment_shader = ps_sdf_star;
    state_block     = sb_sdf_ui;
  }
}
