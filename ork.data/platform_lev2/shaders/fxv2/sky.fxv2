///////////////////////////////////////////////////////////////
// Hillaire-2020 atmosphere LUT bakes (SKYLIGHT lane B).
//  Three fullscreen-quad passes, each writing one LUT:
//    sky_transmittance  256x64  — baked once / on param change
//    sky_multiscatter    32x32  — baked once / on param change (reads transmittance)
//    sky_skyview        192x108 — per frame, from the CENTER-EYE position (L4)
//  Driven by pbr::HillaireSky (sky_atmosphere.cpp). The math lives in
//  skytools.i2; this file is only the raster plumbing.
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "330";
  import "orkshader://mathtools.i2";
  import "orkshader://skytools.i2";
}
///////////////////////////////////////////////////////////////
fragment_interface fif_sky : vif_PT {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
// gl_Position comes straight from the DWI fullscreen quad (already NDC).
// All three fragment shaders derive their texel from gl_FragCoord rather
// than frg_uv0 so the LUTs are immune to the quad's UV-flip convention.
///////////////////////////////////////////////////////////////
vertex_shader vs_sky : vif_PT {
  gl_Position = position;
  frg_uv0     = uv0;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_sky_transmittance : fif_sky : lib_sky {
  vec2 uv        = gl_FragCoord.xy * SkyLutDims.zw;
  SkyLutCoord c  = skyTransmittanceLutParams(uv);
  out_clr        = vec4(skyComputeTransmittance(c._radius, c._cosine), 1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_sky_multiscatter : fif_sky : lib_sky {
  vec2 uv       = gl_FragCoord.xy * SkyLutDims.zw;
  SkyLutCoord c = skyMultiScatterLutParams(uv);
  out_clr       = vec4(skyComputeMultiScatter(c._radius, c._cosine), 1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_sky_skyview : fif_sky : lib_sky {
  vec2 uv = gl_FragCoord.xy * SkyLutDims.zw;

  float view_r = SkyRadii.x + max(SkyRadii.z, 0.0);
  SkyViewAngles a = skySkyViewLutParams(uv, view_r);

  // canonical LUT basis: up = +Z, sun in the +X half of the XZ plane.
  float vzs = sqrt(max(1.0 - a._viewZenithCos * a._viewZenithCos, 0.0));
  float lvs = sqrt(max(1.0 - a._lightViewCos * a._lightViewCos, 0.0));
  vec3 rd   = vec3(vzs * a._lightViewCos, vzs * lvs, a._viewZenithCos);
  vec3 ro   = vec3(0.0, 0.0, view_r);

  float sun_ct = clamp(SkySunDirection.y, -1.0, 1.0);
  vec3 sun_dir = vec3(sqrt(max(1.0 - sun_ct * sun_ct, 0.0)), 0.0, sun_ct);

  SkyScatterResult s = skyIntegrateScattered(ro, rd, sun_dir, 32, true, false);
  out_clr = vec4(s._luminance, 1.0);
}
///////////////////////////////////////////////////////////////
// IBL SNAPSHOT (slice B3) — the whole sky resampled into a persistent equirect
// texture, rendered ONLY when a refilter cycle begins (spec §2 snapshot law:
// the sliced prefilter's source must be immutable for the job's whole life).
// One texel = one direction, at the SAME exposure the visible sky presents.
//
// NO SUN DISC: at snapshot resolution the ~0.265 degree disc is sub-texel, so
// it would flicker across texel boundaries as the sun sweeps, and its energy is
// already delivered as DIRECT light by the enumerated directional sun — folding
// it in here would double-count the sun in specular. A disc term belongs
// exactly HERE, behind its own knob.
///////////////////////////////////////////////////////////////
fragment_shader ps_sky_equirect : fif_sky : lib_sky {
  vec2 uv = gl_FragCoord.xy * SkyLutDims.zw;

  // MIRRORED-U: the shared specular samplers (envtools env_equirectangular_spec*)
  // read an equirect at the bearing mirrored about the X axis, which the baked
  // .xir assets are authored for. The snapshot has to be written in the SAME
  // convention or a mirror ball reflects the sun on the wrong side of the sky.
  vec3 rd      = skyEquirectUV2Dir(uv);
  rd.x         = -rd.x;
  vec3 up      = vec3(0, 1, 0);
  vec3 sun_dir = normalize(SkySunDirection.xyz);
  float view_r = SkyRadii.x + max(SkyRadii.z, 0.0);

  out_clr = vec4(skySampleSkyView(rd, sun_dir, up, view_r) * SkySunDisc.w, 1.0);
}
///////////////////////////////////////////////////////////////
state_block sb_sky : default {
  BlendMode = OFF;
  DepthTest = OFF;
  DepthMask = false;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
technique sky_transmittance {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sky;
    fragment_shader = ps_sky_transmittance;
    state_block     = sb_sky;
  }
}
///////////////////////////////////////////////////////////////
technique sky_multiscatter {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sky;
    fragment_shader = ps_sky_multiscatter;
    state_block     = sb_sky;
  }
}
///////////////////////////////////////////////////////////////
technique sky_skyview {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sky;
    fragment_shader = ps_sky_skyview;
    state_block     = sb_sky;
  }
}
///////////////////////////////////////////////////////////////
technique sky_equirect_snapshot {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sky;
    fragment_shader = ps_sky_equirect;
    state_block     = sb_sky;
  }
}
///////////////////////////////////////////////////////////////
