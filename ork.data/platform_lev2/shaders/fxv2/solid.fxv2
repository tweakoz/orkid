///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "330";
  import "orkshader://stdtools.i2";
}
///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////
uniform_set ublock_vtx {
  mat4 MatMVP;
  mat4 MatMV;
  mat4 MatM;
  vec4 modcolor;
  float Time;
}
///////////////////////////////////////////////////////////////
uniform_block ublock_frg (descriptor_set 0) {
  vec4 modcolor;
  int downsampledim;
  float downsampleamp;
  vec2 ViewportDim;
}
sampler_set samplers(descriptor_set 0) {
  sampler2D ColorMap;
  // sampler2D ColorMap2;
  // sampler2D ColorMap3;
}
sampler_set samplers_pick(descriptor_set 0) {
  usampler2D PickIdMap;
}
///////////////////////////////////////////////////////////////
// SSBO for stacked area chart data
///////////////////////////////////////////////////////////////
storage_interface storage_stacked_chart (descriptor_set 0) {
  buffer layout(std430) ChartData {
    int sample_stride;
    float min_band_pixels;
    int _pad1;
    int _pad2;
    int num_series[4];
    int num_samples[4];
    float stack_min[4];
    float stack_max[4];
    vec4 series_colors[64];
    float samples[262144];
  };
}
///////////////////////////////////////////////////////////////
vertex_interface iface_vdefault {
  inputs {
    vec3 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec3 vtxnormal : NORMAL;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fdefault : iface_vdefault : ublock_frg : samplers {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fmt : ublock_frg : samplers {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
vertex_interface iface_vpick : ublock_vtx {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  //
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_nrmd;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fpick : ublock_frg {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
    vec4 frg_nrmd;
  }
  outputs {
    layout(location = 0) vec4 out_clr;
    layout(location = 1) vec4 out_nrmd;
  }
}
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
  DepthTest = LEQUALS;
  DepthMask = ON;
}
///////////////////////////////////////////////////////////////
state_block sb_lerpblend : sb_default {
  BlendMode = ALPHA;
}
///////////////////////////////////////////////////////////////
state_block sb_additive : sb_default {
  BlendMode = ADDITIVE;
}
///////////////////////////////////////////////////////////////
// shaders
///////////////////////////////////////////////////////////////
fragment_shader ps_texcolor : fif_min_T : samplers {
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = vec4(texc.xyz, 1);
}
fragment_shader ps_texcolor4 : fif_min_T : samplers {
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = texc;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_texcolor : vif_PT : ublock_vtx {
  gl_Position = MatMVP * position;
  frg_uv0     = uv0;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_vtxcolor : vif_PC : ublock_vtx {
  gl_Position = MatMVP * position;
  frg_clr     = vtxcolor;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_debuguv : vif_PT : ublock_vtx {
  gl_Position = MatMVP * position;
  frg_uv0     = uv0;
}
fragment_shader fs_debuguv : fif_min_T {
  out_clr = vec4(frg_uv0, 0.0, 1.0);
}
vertex_shader vs_wldnormal : iface_vdefault : ublock_vtx {
  gl_Position = MatMVP * vec4(position, 1);
  vec3 n      = vtxnormal + vec3(1, 1, 1);
  frg_clr     = vec4(n * 0.5, 1);
  frg_uv0     = uv0;
}
vertex_shader vs_objnormal : iface_vdefault : ublock_vtx {
  gl_Position = MatMVP * vec4(position, 1);

  vec3 n  = vtxnormal + vec3(1, 1, 1);
  frg_clr = vec4(n * 0.5, 1);
  frg_uv0 = uv0;
}
///////////////////////////////////////////////////////////////
libblock Lib1 {
  vec4 X(){
    return vec4(1, 0, 1, 1);
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_texvtxcolor : iface_fdefault {
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = vec4(texc.xyz * frg_clr.xyz, texc.r);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_texvtxcolor_noalpha : iface_fdefault {
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = vec4(texc.xyz * frg_clr.xyz, 1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_distortedfeedback : iface_fdefault {
  // vec2 uvl = texture( ColorMap2, frg_uv0 ).xy;
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = vec4(texc.xyz * frg_clr.xyz, texc.r);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_feedbackatten : iface_fdefault {
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr   = vec4(0, 0, 0, frg_clr.w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fragclr : fif_PC {
  out_clr = frg_clr;
}
///////////////////////////////////////////////////////////////
fragment_shader fs_lib1x : fif_PC : Lib1 {
  out_clr = X();
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modclr : iface_fmt {
  out_clr = modcolor;
}
///////////////////////////////////////////////////////////////
// pick
///////////////////////////////////////////////////////////////
vertex_shader vs_pick : iface_vpick {
  gl_Position = MatMVP * position;
  vec4 cpos   = MatMV * position;
  vec3 wnorm  = normalize(vec3(0, 1, 0));
  frg_clr     = vtxcolor;
  frg_uv0     = uv0;
  frg_nrmd    = vec4(wnorm, -cpos.z);
}
fragment_shader ps_pick : iface_fpick {
  out_clr  = modcolor;
  out_nrmd = frg_nrmd;
}
///////////////////////////////////////////////////////////////
// pick HUD display shaders
///////////////////////////////////////////////////////////////
fragment_interface iface_fpickhud : vif_PT : samplers_pick {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
fragment_shader ps_texcolorpik : iface_fpickhud {
  // Display RGBA32UI pick ID texture - convert to visible colors
  uvec4 pickdata = texture(PickIdMap, frg_uv0);
  // Use lower bits of each channel for visualization
  vec4 c = vec4(float(pickdata.x & 0xFFu) / 255.0,
                float(pickdata.y & 0xFFu) / 255.0,
                float(pickdata.z & 0xFFu) / 255.0,
                1.0);
  out_clr = c;
}
fragment_shader ps_texcolormod1 : fif_min_T : samplers {
  // Display position texture with modulation for visibility
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr = vec4(fract(texc.xyz * 10.0), 1.0);
}
fragment_shader ps_texcolornrm : fif_min_T : samplers {
  // Display normal texture - remap from [-1,1] to [0,1]
  vec4 texc = texture(ColorMap, frg_uv0);
  out_clr = vec4(texc.xyz * 0.5 + 0.5, 1.0);
}
///////////////////////////////////////////////////////////////
state_block sb_xxx : default {
  DepthTest = OFF;
  CullTest  = OFF;
  DepthMask = ON;
}
///////////////////////////////////////////////////////////////
state_block sb_nocull : default {
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
technique vtxcolor {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
// UI OVERLAY state: everything a 2D panel drawn last needs, and nothing a 3D surface
// wants. ALPHA because a runtime setBlendingMacro on a FreestyleMaterial never reaches a
// compiled pipeline (the pass's state_block is what the pipeline carries). CULL OFF
// because a screen-space quad's winding is whatever the caller's y-down UI space made it
// — a culled quad is the exact "drew nothing, said nothing" failure. DEPTH off both ways
// because an overlay is not in the scene's depth conversation.
state_block sb_uioverlay : sb_default {
  BlendMode = ALPHA;
  CullTest  = OFF;
  DepthTest = OFF;
  DepthMask = OFF;
}
///////////////////////////////////////////////////////////////
technique vtxcolor_alpha {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fragclr;
    state_block     = sb_uioverlay;
  }
}
technique debuguv {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_debuguv;
    fragment_shader = fs_debuguv;
    state_block     = sb_nocull;
  }
}
technique testlib1x {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_debuguv;
    fragment_shader = fs_lib1x;
    state_block     = sb_default;
  }
}
technique vtxmodcolor {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
// Minimal interface for 2D UI (no normals)
vertex_interface iface_minimal2D {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_minimal2D : iface_minimal2D : ublock_vtx {
  gl_Position = MatMVP * vec4(position.xyz, 1);
  frg_clr     = vtxcolor;
  frg_uv0     = uv0;
}
///////////////////////////////////////////////////////////////
technique mmodcolor {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_minimal2D;
    fragment_shader = ps_modclr;
    state_block     = sb_default;
  }
}
technique texcolor {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_texcolor;
    fragment_shader = ps_texcolor;
    state_block     = sb_xxx;
  }
}
technique texcolorpik {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_texcolor;
    fragment_shader = ps_texcolorpik;
    state_block     = sb_xxx;
  }
}
technique texcolormod1 {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_texcolor;
    fragment_shader = ps_texcolormod1;
    state_block     = sb_xxx;
  }
}
technique texcolornrm {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_texcolor;
    fragment_shader = ps_texcolornrm;
    state_block     = sb_xxx;
  }
}
technique tek_objnormal {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_objnormal;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
technique tek_wldnormal {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_wldnormal;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
technique texcolor4 {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_texcolor4;
    state_block     = sb_default;
  }
}
technique tek_pick {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_pick;
    fragment_shader = ps_pick;
    state_block     = sb_default;
  }
}
technique distortedfeedback {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_distortedfeedback;
    state_block     = sb_default;
  }
}
technique feedbackatten {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_feedbackatten;
    state_block     = sb_default;
  }
}

technique texvtxcolor {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_texvtxcolor;
    state_block     = sb_default;
  }
}
technique texvtxcolor_noalpha {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_texvtxcolor_noalpha;
    state_block     = sb_default;
  }
}
technique texcolorwrap {
}
technique texcolorralp {
}
technique knob {
}
technique texmodcolor {
}
technique textexmodcolor {
}
technique texmodcolorFB {
}
///////////////////////////////////////////////////////////////
vertex_shader vs_vtxcolor_uv : iface_vdefault : ublock_vtx {
  gl_Position = MatMVP * vec4(position, 1);
  frg_clr     = vtxcolor;
  frg_uv0     = uv0;
}
///////////////////////////////////////////////////////////////
// Single-quad stacked area chart with analytical AA
// Vertex interface includes storage for SSBO access in fragment
///////////////////////////////////////////////////////////////
vertex_interface iface_vtx_stacked
  : ublock_vtx
  : storage_stacked_chart {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
}
vertex_shader vs_stacked_chart : iface_vtx_stacked {
  gl_Position = MatMVP * vec4(position.xyz, 1);
  frg_clr     = vtxcolor;
  frg_uv0     = uv0;
}
fragment_interface iface_frag_stacked : iface_vtx_stacked {
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
fragment_shader ps_stacked_chart : iface_frag_stacked {
  const int MAX_SERIES = 16;

  int ch = int(frg_clr.x);
  float u = frg_uv0.x;
  float frag_data_y = frg_uv0.y;

  int ch_num_series = num_series[ch];
  int ch_num_samples = num_samples[ch];
  int color_base = ch * MAX_SERIES;
  int sample_base = ch * MAX_SERIES * sample_stride;

  // Map U to fractional sample index (linear interpolation — data is pre-smoothed)
  float sample_f = u * float(ch_num_samples - 1);
  int idx0 = int(floor(sample_f));
  int idx1 = min(idx0 + 1, ch_num_samples - 1);
  float t = fract(sample_f);

  float dy_per_pixel = abs(dFdy(frag_data_y));
  float min_band = min_band_pixels * dy_per_pixel;

  // Contiguous bands — no gaps, hard edges (AA via SSAA later)
  vec3 color = vec3(0);
  float total_alpha = 0.0;
  float cumulative = 0.0;

  for (int si = 0; si < ch_num_series; si++) {
    if (series_colors[color_base + si].a < 0.5) continue;  // hidden

    int row = sample_base + si * sample_stride;

    // Linear interpolation (data already low-pass filtered on CPU)
    float v0  = samples[row + idx0];
    float v1  = samples[row + idx1];
    float val = mix(v0, v1, t);
    val = max(val, min_band);

    float band_bottom = cumulative;
    float band_top = cumulative + val;

    // Hard coverage test — no per-fragment AA
    float band_cov = (frag_data_y >= band_bottom && frag_data_y < band_top) ? 1.0 : 0.0;

    color = mix(color, series_colors[color_base + si].rgb, band_cov);
    total_alpha = max(total_alpha, band_cov);

    cumulative = band_top;
  }

  out_clr = vec4(color, total_alpha);
}
technique stacked_chart {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_stacked_chart;
    fragment_shader = ps_stacked_chart;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
