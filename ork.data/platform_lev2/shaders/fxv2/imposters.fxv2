///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "330";
  import "orkshader://stdtools.i2";
}

///////////////////////////////////////////////////////////////
sampler_set imp_samplers(descriptor_set 0) {
  sampler2D ColorMap;
  sampler2D ImpDepthMap;
}
///////////////////////////////////////////////////////////////
uniform_block ublk_imp (descriptor_set 0) {
  vec4 modcolor;
  int downsampledim;
  float downsampleamp;
  vec2 ViewportDim;
  float ImpNear;
  float ImpFar;
  float ImpNear2;
  float ImpFar2;
  mat4 ImpIVP;
  float FilterRadius;
  vec2 ViewportSize;
  vec2 InvViewportSize;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_IMP    //
  : vif_PTT             //
  : ublk_std_matrices { //
  gl_Position = mvp * position;
  frg_uv0     = uv0;
  frg_uv1     = uv1;
}
///////////////////////////////////////////////////////////////
fragment_interface fif_IMP         //
                 : vif_PTT         //
                 : ublk_imp        //
                 : imp_samplers {  //
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_impblit //
  : fif_IMP              //
  {         //
  out_clr   = texture(ColorMap, frg_uv0);
  gl_FragDepth = textureLod(ImpDepthMap,frg_uv0,0).r;
}
state_block sb_imp : default {
  DepthTest = LEQUALS;
  DepthMask = ON;
  BlendMode = ADDITIVE;
}
///////////////////////////////////////////////////////////////
technique imposter_blit_bilinear {
  fxconfig = fxcfg_default;
  vf_pass = { vs_IMP, ps_impblit, sb_imp }
}
///////////////////////////////////////////////////////////////
technique imposter_blit_bicubic {
  fxconfig = fxcfg_default;
  vf_pass = { vs_IMP, ps_impblit, sb_imp }
}
///////////////////////////////////////////////////////////////
technique imposter_blit_lanczos {
  fxconfig = fxcfg_default;
  vf_pass = { vs_IMP, ps_impblit, sb_imp }
}