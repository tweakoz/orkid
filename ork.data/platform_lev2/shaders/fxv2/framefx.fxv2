///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  import "orkshader://stdtools.i2";
  import "orkshader://ssaotools.i2";
  import "orkshader://dithertools.i2";
}
///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////
vertex_interface vif_FFX {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
    //vec2 uv1 : TEXCOORD1;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_FFX : vif_FFX {
  //
  outputs { vec4 out_clr; }
}
///////////////////////////////////////////////////////////////
uniform_block ub_frg_FFX (descriptor_set 0) {
  vec4 ModColor;
  float time;
  float BlurFactor;
  int BlurFactorI;
  float MaskThreshold;
  int image_width;
  int image_height;
  float EffectAmount;

  float Hue;
  float Saturation;
  float Value;
  float Gamma;

  float Exposure;
}
///////////////////////////////////////////////////////////////
// PBR2 P3.D — SSSS depth-rejection params. Separate small UBO per
// [feedback_orkid_ubo_layout] (big shared UBO has alignment traps).
//   xy = (near, far)  for NDC→linear-eye depth conversion
//   z  = depth_reject_threshold (eye-space units; samples whose linear
//        depth differs from center pixel by more than this get zero
//        weight in the per-channel kernel sum)
//   w  = unused (vec4 padding)
uniform_block ublk_ssss_depth(descriptor_set 0) {
  vec4 SsssZndcThresh;
}
///////////////////////////////////////////////////////////////
// PBR2 P3.D — SSSS composite-pass params. Own UBO to bypass the
// ModColor-via-ub_frg_FFX failure mode in the composite shader.
//   rgb = subsurface_tint (the dominant SSS material's color)
//   a   = strength (gain on the tinted-blur contribution)
uniform_block ublk_ssss_composite(descriptor_set 0) {
  vec4 tint_color;
}
///////////////////////////////////////////////////////////////
sampler_set samplers_all (descriptor_set 0) {
  sampler2D MrtMap0;
  sampler2D MrtMap1;
  sampler2D MrtMap2;
  sampler2D MrtMap3;
  sampler2D AuxMap0;
  sampler2D AuxMap1;
  sampler2D NoiseMap;
}
///////////////////////////////////////////////////////////////
fragment_interface fif_FFX_greyscale {
  inputs { vec2 frg_uv; }
  //
  outputs { float out_value; }
}
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default_ffx : default {
  BlendMode = OFF;
  DepthTest = OFF;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
state_block sb_lerpblend : sb_default_ffx {
  BlendMode = ALPHA;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
state_block sb_additive : sb_default_ffx {
  BlendMode = ADDITIVE;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
// shaders
///////////////////////////////////////////////////////////////
vertex_shader vs_uitext //
  : vif_FFX             //
  : ublk_std_matrices { //
  gl_Position = mvp * position;
  frg_clr     = vtxcolor;
  frg_uv      = uv0;
}
///////////////////////////////////////////////////////////////
libblock color_tools {
  vec3 hsv2rgb(vec3 hsv) {

    vec3 rgb;
    if (hsv.y == 0.0) {
      // Grayscale
      rgb.r = rgb.g = rgb.b = hsv.z;
    } else {
      if (1.0 <= hsv.x)
        hsv.x -= 1.0;
      hsv.x *= 6.0;
      float i  = floor(hsv.x);
      float f  = hsv.x - i;
      float aa = hsv.z * (1 - hsv.y);
      float bb = hsv.z * (1 - (hsv.y * f));
      float cc = hsv.z * (1 - (hsv.y * (1 - f)));
      if (i < 1) {
        rgb.r = hsv.z;
        rgb.g = cc;
        rgb.b = aa;
      } else if (i < 2) {
        rgb.r = bb;
        rgb.g = hsv.z;
        rgb.b = aa;
      } else if (i < 3) {
        rgb.r = aa;
        rgb.g = hsv.z;
        rgb.b = cc;
      } else if (i < 4) {
        rgb.r = aa;
        rgb.g = bb;
        rgb.b = hsv.z;
      } else if (i < 5) {
        rgb.r = cc;
        rgb.g = aa;
        rgb.b = hsv.z;
      } else {
        rgb.r = hsv.z;
        rgb.g = aa;
        rgb.b = bb;
      }
    }

    return rgb;
  }

  vec3 rgb2hsv(vec3 rgb) {
    vec4 ret = vec4(0.0, 0.0, 0.0, 0.0); // vec4)0;
    vec3 hsv;

    // RGB 2 HSV
    float mmax  = max(rgb.r, max(rgb.g, rgb.b));
    float mmin  = min(rgb.r, min(rgb.g, rgb.b));
    float delta = mmax - mmin;

    hsv.z = mmax; // v
    if (mmax != 0.0) {
      hsv.y = delta / mmax; // s
    } else {
      hsv.y = 0.0; // s
    }

    if (rgb.r == mmax) {
      hsv.x = (rgb.g - rgb.b) / delta; // h
    } else if (rgb.g == mmax) {
      hsv.x = 2 + (rgb.b - rgb.r) / delta; // h
    } else {
      hsv.x = 4 + (rgb.r - rgb.g) / delta; // h
    }
    hsv.x /= 6.0;
    if (hsv.x < 0)
      hsv.x += 1.0;

    // hsv.x += fShift;                                // F'Š•â³
    // if (1.0 <= hsv.x) hsv.x -= 1.0;

    return hsv;
  }

  ////////////////////////////////////////////////////////////////////////////////

  vec3 quantize(vec3 rgbin, float fnumsteps) {
    float i = 1.0 / fnumsteps;
    float r = round(rgbin.r * fnumsteps) * i;
    float g = round(rgbin.g * fnumsteps) * i;
    float b = round(rgbin.b * fnumsteps) * i;
    return vec3(r, g, b);
  }

  ////////////////////////////////////////////////////////////////////////////////

  vec3 quantizeHSV(vec3 hsvin, float fnumsteps) {
    float i = 1.0 / fnumsteps;
    float h = round(hsvin.x * fnumsteps * 3.0) * (i / 3.0);
    float s = round(hsvin.y * fnumsteps) * i;
    float v = round(hsvin.z * fnumsteps) * i;
    return vec3(h, s, v);
  }
}
///////////////////////////////////////////////////////////////
libblock lib_cmn_funs {
  float fgr2(float fin) { return 0.0; }
  float fgr3(float fin) { return 1.0; }

  vec4 pointsampletex2d(sampler2D s, vec2 uv) {
    ivec2 ts = textureSize(s, 0);
    vec2 fts = vec2(float(ts.x) * uv.x, float(ts.y) * uv.y);
    ts.x     = int(fts.x);
    ts.y     = int(fts.y);
    vec4 r   = texelFetch(s, ts, 0);
    return r;
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_uitext //
  : fif_FFX               //
  : ub_frg_FFX            //
  : samplers_all {        //
  vec4 texc = texture(MrtMap0, frg_uv);
  if (texc.r == 0.0)
    discard;
  out_clr = vec4(texc.xyz * ModColor.xyz, texc.r);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_uitextured : fif_FFX : samplers_all {
  vec4 texc = texture(MrtMap0, frg_uv);
  out_clr   = vec4(texc.xyz, texc.w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_standard : fif_FFX : samplers_all {
  vec4 texc = texture(MrtMap0, frg_uv);
  out_clr   = vec4(texc.xyz, texc.w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_maskbright //
  : fif_FFX                   //
  : lib_cmn_funs              //
  : ub_frg_FFX                //
  : samplers_all {            //
  vec3 texc = texture(MrtMap0, frg_uv).xyz;
  if(texc.x>MaskThreshold || texc.y>MaskThreshold || texc.z>MaskThreshold){

  }
  else{
    texc = vec3(0,0,0);
  }
  out_clr = vec4(texc,1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_blurx 
  : fif_FFX 
  : lib_cmn_funs 
  : ub_frg_FFX
  : samplers_all {
  float stepval = (1.0 / image_width);
  vec3 PixOut   = vec3(0,0,0);

  for (int i = -BlurFactorI; i <=BlurFactorI; i++) {
    vec2 UvOffset = vec2(stepval*i, 0.0);
    vec3 inpix = texture(MrtMap0, frg_uv + UvOffset).xyz;
    float scale =  (BlurFactorI+1) - abs(i); 
    scale = scale / BlurFactorI;
    scale = pow(scale,0.5);
    PixOut += inpix * scale;
  }
  PixOut *= BlurFactor;
  out_clr = vec4(PixOut,1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_blury 
  : fif_FFX 
  : lib_cmn_funs 
  : ub_frg_FFX
  : samplers_all {
  float stepval = (1.0 / image_height);
  vec3 PixOut   = vec3(0,0,0);

  for (int i = -BlurFactorI; i <=BlurFactorI; i++) {
    vec2 UvOffset = vec2(0.0,stepval*i);
    vec3 inpix = texture(MrtMap0, frg_uv + UvOffset).xyz;
    float scale =  (BlurFactorI+1) - abs(i); 
    scale = scale / BlurFactorI;
    scale = pow(scale,0.5);
    PixOut += inpix * scale;
  }
  PixOut *= BlurFactor;
  out_clr = vec4(PixOut,1);

}
///////////////////////////////////////////////////////////////
fragment_shader ps_hdr_join // 
  : fif_FFX                 //
  : samplers_all            //
  : ub_ghost {              //
  vec4 glow = texture(MrtMap0, frg_uv);
  vec4 base = texture(MrtMap1, frg_uv);
  //vec3 full = mix(base.xyz, glow.xyz, EffectAmount).xyz;
  vec3 full = base.xyz+glow.xyz*EffectAmount;
  out_clr   = vec4(full.xyz, 1.0);
  //out_clr = vec4(glow.xyz,1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_hsvg //
  : fif_FFX             //
  : color_tools         //
  : lib_dither          //
  : ub_frg_FFX          //
  : samplers_all {      //
  // FLOOR AT ZERO before any conversion: a negative HDR pixel (e.g. an
  // additive-subtract composite gone below zero at a silhouette) turns to NaN
  // in the hue divide, and NaN then survives every later clamp — including the
  // tonemap stage's own floor (max(NaN,0) is implementation-defined). Kill the
  // negative at the first stage that sees it.
  vec4 inprgb = texture(MrtMap0, frg_uv);
  inprgb.xyz = max(inprgb.xyz, vec3(0.0));
  vec3 hsv   = rgb2hsv(inprgb.xyz);
  hsv.x      = mod(hsv.x + Hue + 1.0, 1.0);
  hsv.y      = clamp(hsv.y * Saturation,0,1);
  hsv.z      = clamp(hsv.z * Value,0,1);
  vec3 rgb   = hsv2rgb(hsv);
  float inv_gamma = 1.0/Gamma;
  float r = pow(rgb.r, inv_gamma);
  float g = pow(rgb.g, inv_gamma);
  float b = pow(rgb.b, inv_gamma);
  // grading is a display-encode too, and it is the LAST node of the usual
  // aces->hsvg chain. Salted apart from ps_aces so a chain carrying both adds
  // two INDEPENDENT dithers rather than the same offset twice.
  out_clr   = vec4(vec3(r,g,b) + outputDitherTPDF(gl_FragCoord.xy, 71.0), 1.0);
}
///////////////////////////////////////////////////////////////
sampler_set sset_frg_ssao_impl(descriptor_set 0) {
  sampler2D MapDepth;
  sampler2D MapLinearDepth;
  sampler2D SSAOPREV;
}
///////////////////////////////////////////////////////////////
uniform_set uset_frg_ssao_impl {
  vec2 texelSize;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_ssao_prepass //
  : fif_FFX_greyscale //
  : ublk_std_matrices
  : uset_std_viewport
  : uset_frg_ssao_impl //
  : lib_ssao
  : sset_frg_ssao_impl { 
  vec2 uv = gl_FragCoord.xy*InvViewportSize;
  float cur_ssao = ssao_nonlinear(uv);
  float prv_ssao = texture(SSAOPREV,uv).r;
  out_value = mix(prv_ssao,cur_ssao,SSAOFeedback); // Strong temporal filtering to reduce noise
}
///////////////////////////////////////////////////////////////
fragment_shader ps_linearize_depth //
  : fif_FFX_greyscale //
  : ublk_std_matrices
  : uset_std_viewport
  : uset_frg_ssao_impl //
  : uset_std_depth
  : lib_ssao
  : sset_frg_ssao_impl 
  : ublk_std_depth { 
  vec2 uv = gl_FragCoord.xy*InvViewportSize;
  float depthtex = texture(MapDepth,uv).r;
  float ndc = depthtex * 2.0 - 1.0; // Convert to NDC space [-1, 1]
  float near = Zndc2eye.x;
  float far = Zndc2eye.y;
  float linz = (1.0*near*far) / (far+near-ndc*(far-near));
  out_value   = 0.0;//linz; // linearize
}
///////////////////////////////////////////////////////////////
sampler_set sset_ghost(descriptor_set 0) {
  sampler2D MrtMap0; // Base color map
  sampler2D AuxMap1; // Glow map
}
uniform_set ub_ghost {
  float EffectAmount;
}
fragment_interface iface_hdr_join_ghost : ub_ghost : sset_ghost {
  outputs { vec4 out_clr; }
  //
  inputs { vec2 frg_uv; }
}
fragment_shader ps_hdr_join_ghost 
  : fif_FFX 
  : lib_cmn_funs 
  : ub_ghost
  : samplers_all {
  vec3 base  = pointsampletex2d(MrtMap0, frg_uv.xy).xyz;
  vec3 glow  = pointsampletex2d(AuxMap1, frg_uv.xy).xyz;
  float diff = distance(glow, base);
  float dist = pow(clamp(diff, 0.0, 1.0), 1.2);

  vec3 black = vec3(0.0, 0.0, 0.0);
  vec3 blue  = vec3(0.0, 0.0, 1.0);
  vec3 white = vec3(1.0, 1.0, 1.0);

  vec3 outc3 = mix(black, blue, dist);
  outc3      = mix(outc3, white, dist);

  outc3 = mix(base, outc3, EffectAmount);

  out_clr = vec4(outc3, 1.0);
}
////////////////////////////////////////////////////////////////////////////////

fragment_shader ps_comic 
  : fif_FFX 
  : color_tools
  : ub_frg_FFX
  : samplers_all {
  const float kdx          = 1.007 / 1024.0;
  const float kdy          = 1.007 / 768.0;
  const float kf           = 0.01;
  const float knumsteps    = 6.0;
  const float knumstepsHSV = 5.0;
  float fphase             = 6.283 * kf * time;

  /////////////////////////////////////////////////////////
  const float kaadim = 2.0;
  const float ksc    = (1.0 / (kaadim * kaadim)); // 9 16 25 49
  const float kfb    = -1.5;
  const float kfe    = -kfb;
  const float kfed   = (kfe - kfb) / kaadim;
  /////////////////////////////////////////////////////////
  vec2 Uv0    = vec2(frg_uv.x, frg_uv.y);
  vec3 PixOri = texture(MrtMap0, Uv0).rgb;
  vec3 HsvOri = rgb2hsv(PixOri);
  vec3 PixCtr = quantize(PixOri, knumsteps);
  vec3 HsvCtr = HsvOri;
  float fwt   = 0.0;
  float dist  = 0.0;
  /////////////////////////////////////////////////////////
  for (float fy = 0.0; fy < kaadim; fy += 1.0) {
    float fya = kfb + (fy * kfed);

    for (float fx = 0.0; fx < kaadim; fx += 1.0) {
      float fxa = kfb + (fx * kfed);
      fwt += 1.0;
      vec2 Uv      = Uv0 + vec2(kdx * fxa, kdy * fya);
      vec3 ThisRgb = texture(MrtMap0, Uv).rgb;
      vec3 ThisPix = quantize(ThisRgb, knumsteps);
      dist += distance(ThisPix, PixCtr);
    }
  }
  /////////////////////////////////////////////////////////
  float idist = 1.0 - clamp(dist, 0.0, 1.0);
  idist       = clamp(pow(idist, 2.0), 0.0, 1.0);
  /////////////////////////////////////////////////////////
  vec3 HsvOut = HsvOri;
  HsvOut.z    = HsvOri.z * idist;
  /////////////////////////////////////////////////////////
  HsvOut = quantizeHSV(HsvOut, knumstepsHSV);
  HsvOut = mix(HsvOri, HsvOut, EffectAmount);
  /////////////////////////////////////////////////////////
  out_clr = vec4(hsv2rgb(HsvOut), 1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fbout : fif_FFX : samplers_all { out_clr = texture(MrtMap0, frg_uv); }
///////////////////////////////////////////////////////////////
fragment_shader ps_fbin : fif_FFX : samplers_all { out_clr = texture(MrtMap0, frg_uv) * 0.1; }
///////////////////////////////////////////////////////////////
vertex_shader vs_vtxcolor //
  : vif_FFX               //
  : ublk_std_matrices {   //
  gl_Position = mvp * position;
  frg_clr     = vtxcolor;
  frg_uv      = uv0;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fragclr : fif_FFX {
  out_clr = frg_clr;
  // out_clr = vec4(1.0,0.0,1.0,1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modclr //
  : fif_FFX               //
  : ub_frg_FFX {          //
    out_clr = ModColor; 
  }
///////////////////////////////////////////////////////////////
technique frameeffect_standard {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_standard;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_fbout {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fbout;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_fbin {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fbin;
    state_block     = sb_default_ffx;
  }
}
technique framefx_glow_maskbright {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_maskbright;
    state_block     = sb_default_ffx;
  }
}
technique framefx_glow_blurx {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_blurx;
    state_block     = sb_default_ffx;
  }
}
technique framefx_glow_blury {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_blury;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_radialblur {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_uitextured;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_comic {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_comic;
    state_block     = sb_default_ffx;
  }
}
technique framefx_glow_join {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_hdr_join;
    state_block     = sb_default_ffx;
  }
}
technique framefx_hsvg {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_hsvg, sb_default_ffx }
}
///////////////////////////////////////////////////////////////
// Fade-to-color: lerp each sampled fragment toward a fixed color by
// FadeAmount. Used for scene transitions (fade-to-white, etc.). The
// uniforms live in a dedicated block so binding ub_frg_fade does not
// disturb the other framefx shaders that inherit ub_frg_FFX.
///////////////////////////////////////////////////////////////
uniform_block ub_frg_fade (descriptor_set 0) {
  vec4 FadeColor;
  float FadeAmount;
}
fragment_shader ps_fade_to_color //
  : fif_FFX                      //
  : ub_frg_fade                  //
  : samplers_all {               //
  vec4 src = texture(MrtMap0, frg_uv);
  out_clr  = vec4(mix(src.rgb, FadeColor.rgb, clamp(FadeAmount, 0.0, 1.0)), 1.0);
}
technique framefx_fade_to_color {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_fade_to_color, sb_default_ffx }
}
state_block sb_ssao : default {
  BlendMode = OFF;
  DepthTest = LESS;
  DepthMask = ON;
  CullTest  = PASS_FRONT;
}

technique framefx_ssao_prepass {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_ssao_prepass;
    state_block     = sb_ssao;
  }
}
technique framefx_linearize_depth {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_linearize_depth;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_ghost_join {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_hdr_join_ghost;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_afterlife_join {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_uitextured;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_dof_join {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_uitextured;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_debugdepth {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_uitextured;
    state_block     = sb_default_ffx;
  }
}
technique frameeffect_debugnormals {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_uitextured;
    state_block     = sb_default_ffx;
  }
}
///////////////////////////////////////////////////////////////
// ACES Filmic Tone Mapping
// Based on the Narkowicz 2015 fit of the ACES curve
///////////////////////////////////////////////////////////////
libblock lib_aces {
  vec3 aces_filmic(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_aces //
  : fif_FFX              //
  : lib_aces             //
  : lib_dither           //
  : ub_frg_FFX           //
  : samplers_all {       //
  // FLOOR AT ZERO: negative HDR must clamp to black here, not enter the filmic
  // fit — the Narkowicz rational flips sign below x ~= -0.012 and races back to
  // WHITE (x=-1 evaluates ~1.25), so any upstream negative-radiance source
  // (e.g. an additive-subtract composite gone below zero at a silhouette)
  // renders as a bright flash instead of darkness without this.
  vec3 hdr = max(texture(MrtMap0, frg_uv).xyz, vec3(0.0));
  vec3 display = hdr;
  if (Exposure > 0.0) {
    vec3 exposed = hdr * Exposure;
    display = aces_filmic(exposed);
  }
  out_clr = vec4(display + outputDitherTPDF(gl_FragCoord.xy, 0.0), 1.0);
}
///////////////////////////////////////////////////////////////
technique framefx_aces {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_aces, sb_default_ffx }
}


///////////////////////////////////////////////////////////////
// PBR2 Phase 3 (P3.D) — Separable Subsurface Scattering.
//
// Pipeline (3 passes via PostFxNodeSSSS):
//   1. ps_ssss_blurx — read target1 (forward-pass diffuse + sss_mask in
//      .alpha), do horizontal Jimenez kernel sample. Mask early-out:
//      pixels with mask=0 pass through unchanged (no SSSS cost).
//   2. ps_ssss_blury — read blurx output, vertical Jimenez kernel.
//   3. ps_ssss_composite — read target0 (main lit), target1 (raw diffuse +
//      mask), v_blur output (blurred diffuse). Output:
//         final = target0 + mask * (blurred_diffuse - raw_diffuse)
//      i.e. replace the diffuse term in target0 with the blurred version,
//      gated by the per-pixel mask. Specular passes through untouched.
//
// Kernel: Jimenez 2015 11-tap skin preset. Per-channel weight (RGB) ×
// offset in "tap units" (.w). The sum of each channel's weights is ~1
// (energy-preserving). Offsets are scaled at sample time by:
//   step = BlurFactor / image_dim
// where BlurFactor (uniform) is the screen-space radius in pixels.
///////////////////////////////////////////////////////////////
// Jimenez 2015 skin kernel — hand-unrolled (fxv2 doesn't parse GLSL
// `const vec4 X[N] = vec4[N](...)` initializer syntax). Each tap is a
// vec3 weight × scalar offset. R bleeds farthest (heavy weights at far
// taps), B stays tight. Sum of each channel's weights ≈ 1 (energy-
// preserving). Center tap (offset 0) carries the most weight.
///////////////////////////////////////////////////////////////
fragment_shader ps_ssss_blurx
  : fif_FFX
  : ub_frg_FFX
  : ublk_ssss_depth
  : samplers_all {
  // P3.D — depth-aware separable SSSS blur. AuxMap0 = forward-pass depth.
  // Each sample's per-channel weight is multiplied by a depth-reject mask:
  // samples whose linear eye-depth differs from the center pixel's by
  // more than SsssZndcThresh.z get zero weight → BG (far-plane) samples
  // are rejected (no BG bleed into silhouette), cross-surface samples
  // are kept (preserves the natural spread that gives ear-bleed look).
  vec4 center = texture(MrtMap0, frg_uv);
  float near = SsssZndcThresh.x;
  float far  = SsssZndcThresh.y;
  float thr  = SsssZndcThresh.z;
  float c_d  = texture(AuxMap0, frg_uv).r;
  float c_ndc = c_d * 2.0 - 1.0;
  float c_z   = (near * far) / (far + near - c_ndc * (far - near));
  float step_x = BlurFactor / float(image_width);
  vec3 accum = vec3(0);
  vec3 wsum  = vec3(0);
  vec4 s;
  vec3 k;
  float d;
  float ndc;
  float z;
  float w;
  // center always counts
  k = vec3(0.560479, 0.669086, 0.784728);
  accum += k * center.rgb;  wsum += k;
  // helper macro inlined per tap (fxv2 has no preprocessor macros)
  s = texture(MrtMap0, frg_uv + vec2(-2.00 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2(-2.00 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.000874, 0.001717, 0.004640) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(-1.28 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2(-1.28 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.002567, 0.005012, 0.012730) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(-0.72 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2(-0.72 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.007807, 0.014800, 0.038550) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(-0.32 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2(-0.32 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.018960, 0.034910, 0.090140) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(-0.08 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2(-0.08 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.060140, 0.105110, 0.225750) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2( 0.08 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2( 0.08 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.060140, 0.105110, 0.225750) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2( 0.32 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2( 0.32 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.018960, 0.034910, 0.090140) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2( 0.72 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2( 0.72 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.007807, 0.014800, 0.038550) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2( 1.28 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2( 1.28 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.002567, 0.005012, 0.012730) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2( 2.00 * step_x, 0.0));
  d = texture(AuxMap0, frg_uv + vec2( 2.00 * step_x, 0.0)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.000874, 0.001717, 0.004640) * w;  accum += k * s.rgb;  wsum += k;
  accum /= max(wsum, vec3(1e-4));
  // Preserve mask in alpha for composite gate; mask now comes from
  // target1.alpha (which the forward shader still writes as
  // subsurface_factor for PBR materials, 0 for non-PBR).
  out_clr = vec4(accum, center.a);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_ssss_blury
  : fif_FFX
  : ub_frg_FFX
  : ublk_ssss_depth
  : samplers_all {
  // P3.D — vertical depth-aware blur. Matches blurx; only axis differs.
  vec4 center = texture(MrtMap0, frg_uv);
  float near = SsssZndcThresh.x;
  float far  = SsssZndcThresh.y;
  float thr  = SsssZndcThresh.z;
  float c_d  = texture(AuxMap0, frg_uv).r;
  float c_ndc = c_d * 2.0 - 1.0;
  float c_z   = (near * far) / (far + near - c_ndc * (far - near));
  float step_y = BlurFactor / float(image_height);
  vec3 accum = vec3(0);
  vec3 wsum  = vec3(0);
  vec4 s;
  vec3 k;
  float d;
  float ndc;
  float z;
  float w;
  k = vec3(0.560479, 0.669086, 0.784728);
  accum += k * center.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0, -2.00 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0, -2.00 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.000874, 0.001717, 0.004640) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0, -1.28 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0, -1.28 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.002567, 0.005012, 0.012730) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0, -0.72 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0, -0.72 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.007807, 0.014800, 0.038550) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0, -0.32 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0, -0.32 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.018960, 0.034910, 0.090140) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0, -0.08 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0, -0.08 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.060140, 0.105110, 0.225750) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0,  0.08 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0,  0.08 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.060140, 0.105110, 0.225750) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0,  0.32 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0,  0.32 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.018960, 0.034910, 0.090140) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0,  0.72 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0,  0.72 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.007807, 0.014800, 0.038550) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0,  1.28 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0,  1.28 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.002567, 0.005012, 0.012730) * w;  accum += k * s.rgb;  wsum += k;
  s = texture(MrtMap0, frg_uv + vec2(0.0,  2.00 * step_y));
  d = texture(AuxMap0, frg_uv + vec2(0.0,  2.00 * step_y)).r;
  ndc = d * 2.0 - 1.0;
  z = (near * far) / (far + near - ndc * (far - near));
  w = step(abs(z - c_z), thr);
  k = vec3(0.000874, 0.001717, 0.004640) * w;  accum += k * s.rgb;  wsum += k;
  accum /= max(wsum, vec3(1e-4));
  out_clr = vec4(accum, center.a);
}
///////////////////////////////////////////////////////////////
// Composite. MrtMap0 = main lit (target0). MrtMap1 = raw diffuse +
// mask (target1). MrtMap2 = v-blur output (blurred diffuse).
// ModColor.rgb = subsurface_tint, ModColor.a = strength (PostFxNodeSSSS).
fragment_shader ps_ssss_composite
  : fif_FFX
  : ub_frg_FFX
  : ublk_ssss_depth
  : ublk_ssss_composite
  : samplers_all {
  vec3 lit       = texture(MrtMap0, frg_uv).rgb;
  vec4 raw       = texture(MrtMap1, frg_uv);
  vec3 blurred   = texture(MrtMap2, frg_uv).rgb;
  float mask     = raw.a;
  // BlurFactorI is repurposed as debug mode selector (PostFxNodeSSSS._debug_mode).
  // 0 = normal; 1 = mask only; 2 = raw diffuse; 3 = blurred diffuse;
  // 4 = SSSS delta contribution (× strength, tinted, masked);
  // 5 = lit-only passthrough; 6 = linear depth (normalized to [0,1] across near..far).
  // P3.D — read from ublk_ssss_composite.tint_color instead of ub_frg_FFX.ModColor.
  // ModColor in the shared big UBO was reading as zero in this shader despite
  // C++ printf confirming the bind. Own-UBO bypasses that failure mode.
  vec4 MC = tint_color;
  vec3 tinted_blur = blurred * MC.rgb * MC.a;
  vec3 final;
  if (BlurFactorI == 1) {
    final = vec3(mask);                              // mask grayscale
  } else if (BlurFactorI == 2) {
    final = raw.rgb;                                 // raw diffuse
  } else if (BlurFactorI == 3) {
    final = blurred;                                 // blurred diffuse
  } else if (BlurFactorI == 4) {
    final = mask * (tinted_blur - raw.rgb);          // SSSS delta only
  } else if (BlurFactorI == 5) {
    final = lit;                                     // P3.D: lit-only passthrough
  } else if (BlurFactorI == 6) {
    // Raw depth_tex with multi-window contrast boost — uniforms-free.
    // R = stretch around 0.99–1.0 (very high precision near far plane)
    // G = stretch around 0.95–1.0 (medium)
    // B = stretch around 0.5–1.0  (broad)
    // Whichever channel "lights up" tells us the scene's depth range.
    float d_tex = texture(AuxMap0, frg_uv).r;
    float r = clamp((d_tex - 0.99) * 100.0, 0.0, 1.0);
    float g = clamp((d_tex - 0.95) *  20.0, 0.0, 1.0);
    float b = clamp((d_tex - 0.5)  *   2.0, 0.0, 1.0);
    final = vec3(r, g, b);
  } else if (BlurFactorI == 7) {
    // Sanity check — does the shader even run in debug modes?
    // Expected: entire frame solid green.
    final = vec3(0.0, 1.0, 0.0);
  } else if (BlurFactorI == 8) {
    // Uniform value visualization. R = near/100, G = far/100, B = threshold/10.
    // Expected for the saddle scene: R≈0.001 (near=0.1), G≈0.1 (far=10),
    // B≈0.1 (threshold=1). Mostly G channel visible. If solid black:
    // the uniform isn't being bound. If R≈G≈B all zero: same.
    final = vec3(SsssZndcThresh.x * 0.01,
                 SsssZndcThresh.y * 0.01,
                 SsssZndcThresh.z * 0.1);
  } else if (BlurFactorI == 10) {
    // Direct ModColor.rgb passthrough — solid color the entire frame.
    // Diagnostic: does the composite shader actually receive ModColor
    // from the C++ bind? Expected: solid (0.85, 0.4, 0.3) — pinkish-red.
    // If solid black: ModColor isn't reaching the shader (binding broken
    // despite C++ printout showing correct values).
    // If solid white or some other color: wrong value in shader.
    final = MC.rgb;
  } else if (BlurFactorI == 9) {
    // Linear eye-space depth as multi-scale color (uses real near/far uniforms).
    // R = linear depth / 1m   → visible for 0–1m  range (very close)
    // G = linear depth / 10m  → visible for 0–10m range (typical scene)
    // B = linear depth / 100m → visible for 0–100m range (broad)
    // If all channels black → linearization formula reduces to 0 (near or
    // far is zero, or NDC convention is wrong). If R-only → very close,
    // G-only → mid scene, RGB-white → very far. Spheres should show a
    // smooth color gradient, BG flat at far-plane color.
    float d_near = SsssZndcThresh.x;
    float d_far  = SsssZndcThresh.y;
    float d_tex  = texture(AuxMap0, frg_uv).r;
    float d_ndc  = d_tex * 2.0 - 1.0;
    float d_lin  = (d_near * d_far) / (d_far + d_near - d_ndc * (d_far - d_near));
    final = vec3(clamp(d_lin / 1.0,   0.0, 1.0),
                 clamp(d_lin / 10.0,  0.0, 1.0),
                 clamp(d_lin / 100.0, 0.0, 1.0));
  } else {
    final = lit + mask * (tinted_blur - raw.rgb);    // normal composite
  }
  out_clr = vec4(final, 1.0);
}
///////////////////////////////////////////////////////////////
technique framefx_ssss_blurx {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_ssss_blurx, sb_default_ffx }
}
technique framefx_ssss_blury {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_ssss_blury, sb_default_ffx }
}
technique framefx_ssss_composite {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_ssss_composite, sb_default_ffx }
}
