///////////////////////////////////////////////////////////////
// particle_comshader.i2 — the STOCK particle techniques over the SSBO
// vertex machinery (now in particle_ssbo.i2; import order matters —
// see particle.fxv2). Fragment shaders live in particle_common.i2.
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// Techniques for sprites
///////////////////////////////////////////////////////////////
technique tflatparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_flat;
    state_block     = sb_default;
  }
}

technique tgradparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_grad;
    state_block     = sb_default;
  }
}

technique tgradatlasparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_grad_atlas;
    state_block     = sb_default;
  }
}

technique ttexparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_modtexclr;
    state_block     = sb_default;
  }
}

technique ttexgridparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_modtexclr_grid;
    state_block     = sb_default;
  }
}

technique tfreestyleparticle_sprites {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_sprite_ssbo;
    fragment_shader = ps_freestyle_ptc;
    state_block     = sb_default;
  }
}

