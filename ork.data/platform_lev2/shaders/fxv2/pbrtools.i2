import "gbuftools.i2";
import "brdftools.i2";
import "deftools.i2";
import "fwdtools.i2";
import "skintools.i2";
import "stdtools.i2";
import "mathtools.i2";
import "ssaotools.i2";
import "envtools.i2";
///////////////////////////////////////////////////////////////
// Uniform Blocks and Sets
///////////////////////////////////////////////////////////////
uniform_block ub_frg_fwd (descriptor_set 0) {
  float DppZBias;
  vec4 ShadowParams;
}
///////////////////////////////////////////////////////////////
uniform_set us_frg : us_std_pbr {
  // Basic fragment data
}
///////////////////////////////////////////////////////////////
// Vertex Interfaces
///////////////////////////////////////////////////////////////

// Shared VS->FS outputs for forward rendering
// Fragment interfaces inherit from this to get their inputs
vertex_interface vif_forward_outputs {
  outputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
    vec4 frg_modcolor;
  }
}

vertex_interface vif_PNBT : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_wpos;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
  }
}
vertex_interface vif_PNBC : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec4 vtxcolor : COLOR0;
  }
  outputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
  }
}
///////////////////////////////////////////////////////////////
// Skeleton vertex interface - Position, Normal, Color (no binormal)
// Used with V12N12T8DU12C4 vertex format
vertex_interface vif_PNC : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec4 vtxcolor : COLOR0;
  }
  outputs {
    vec4 frg_clr;
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_PNBT_skinned : vif_PNBT : iface_skintools {
}
///////////////////////////////////////////////////////////////
// Fragment Interfaces
///////////////////////////////////////////////////////////////
fragment_interface iface_forward
  : ub_frg_fwd
  : ss_frg_fwd
  : storage_fwd_lighting {
  inputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
    vec4 frg_modcolor;
  }
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
// Simple fragment interface for skeleton rendering - only needs frg_clr
fragment_interface fif_skeleton {
  inputs {
    vec4 frg_clr;
  }
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fgbuffer : us_frg : ss_frg_fwd {
  inputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
  }
  outputs {
    layout(location = 0) uvec4 out_gbuf;
  }
}
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
	DepthTest=LESS;
	DepthMask=true;
	CullTest=PASS_FRONT;
	BlendMode = OFF;
}
///////////////////////////////////////////////////////////////
// Library Blocks
///////////////////////////////////////////////////////////////
libblock lib_pbr_vtx {
  void vs_common(vec4 pos, vec3 nrm, vec3 bin) {
    vec4 cpos       = mv * pos;
    vec3 wnormal    = normalize(mrot * nrm);
    vec3 wbitangent = normalize(mrot * bin); // technically binormal is a bitangent
    vec3 wtangent   = cross(wbitangent, wnormal);
    frg_wpos        = m * pos;
    frg_tbn         = mat3(wtangent, wbitangent, wnormal);
    frg_camz        = wnormal.xyz;
    frg_camdist     = -cpos.z;
  }
}
///////////////////////////////////////////////////////////////
libblock lib_pbr_frg : lib_gbuf_encode : sset_std_pbr
    : ublk_std_pbr
    {
  void ps_common_n(vec4 modc, vec3 N, vec2 UV) {
    vec3 normal    = normalize(frg_tbn * N);
    vec3 rufmtlamb = texture(CNMREA, vec3(UV,2)).xyz;
    float mtl      = rufmtlamb.z * MetallicFactor;
    float ruf      = rufmtlamb.y * RoughnessFactor;
    vec3 color     = (modc * frg_clr * texture(CNMREA, vec3(UV,0))).xyz;
    vec3 emission  = texture(CNMREA, vec3(UV,3)).xyz * modc.xyz;
    out_gbuf       = packGbuffer(color, emission, normal, ruf, mtl);
  }
  void ps_common_vizn(vec4 modc, vec3 N) {
    vec3 normal = normalize(frg_tbn * N);
    // vec3 rufmtlamb = texture(MtlRufMap,UV).zyx;
    float mtl = 0; // rufmtlamb.x * MetallicFactor;
    float ruf = 1; // rufmtlamb.y * RoughnessFactor;
    // vec3 color = (modc*frg_clr*texture(ColorMap,UV)).xyz;
    out_gbuf = packGbuffer(vec3(0, 0, 0), normal, vec3(0, 0, 0), ruf, mtl);
  }
} // lib_pbr_frg

///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
// DEFERRED
///////////////////////////////////////////////////////////////
// vs-non-instanced-rigid
///////////////////////////////////////////////////////////////
vertex_shader vs_rigid_gbuffer : vif_PNBT : lib_pbr_vtx : ublk_std_matrices {
  vs_common(position, normal, binormal);
    frg_uv0         = uv0 * vec2(1, -1);
  gl_Position = mvp * position;
}
///////////////////////////////////////////////////////////////
// vs-non-instanced-skinned
///////////////////////////////////////////////////////////////
vertex_shader vs_skinned_gbuffer : vif_PNBT_skinned : lib_skin_tools : lib_pbr_vtx : ublk_std_matrices {
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec3 skn_nrm = SkinNormal(normal);
  vec3 skn_bit = SkinNormal(binormal); // // technically binormal is a bitangent
  vs_common(skn_pos, skn_nrm, skn_bit);
    frg_uv0         = uv0 * vec2(1, -1);
  gl_Position = mvp * skn_pos;
}
///////////////////////////////////////////////////////////////
// fragment shaders
///////////////////////////////////////////////////////////////
fragment_shader ps_gbuffer : iface_fgbuffer : lib_pbr_frg {
  ps_common_n(ModColor, vec3(0, 0, 1), frg_uv0);
}
///////////////////////////////////////////////////////////////
// vs-non-instanced-rigid
///////////////////////////////////////////////////////////////
vertex_shader vs_rigid_gbuffer_vtxcolor : vif_PNBC : lib_pbr_vtx : ublk_std_matrices {
  frg_clr     = vtxcolor;
  gl_Position = mvp * position;
}
vertex_shader vs_forward_rigid_vtxcolor : vif_PNBC : ublk_std_matrices {
  frg_clr     = vec4(1,1,1,1);//vtxcolor;
  gl_Position = mvp * position;
}
///////////////////////////////////////////////////////////////
// Skeleton vertex shader - uses vif_PNC (no binormal required)
vertex_shader vs_forward_skeleton : vif_PNC : ublk_std_matrices {
  frg_clr     = vtxcolor;
  gl_Position = mvp * position;
}
fragment_shader ps_forward_skeleton : fif_skeleton {
  out_color = frg_clr;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_gbuffer_vtxcolor : iface_fgbuffer : lib_pbr_frg {
  out_gbuf = packGbuffer(vec3(0), frg_clr.xyz, vec3(0,0,1), 1, 0);
  //out_gbuf = packGbuffer(vec3(0,1,0), vec3(1,1,0), vec3(0,0,1), 1, 0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_forward_frgcolor : iface_forward {
  out_color = frg_clr;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_rigid_gbuffer_font : vif_PNBT : lib_pbr_vtx : ublk_std_matrices {
  vs_common(position, normal, binormal);
  //frg_clr     = vtxcolor;
  frg_uv0     = uv0;
  gl_Position = mvp * position;
}
sampler_set sset_font (descriptor_set 0){
  sampler2D ColorMap;
}
fragment_shader ps_gbuffer_font : iface_fgbuffer : lib_pbr_frg : sset_font {
  vec4 s     = texture(ColorMap, frg_uv0.xy);
  float texa = pow(s.a * s.r, 0.75);
  if (s.r < 0.001)
    discard;
  // vec3 color = s.rrr;
  out_gbuf = packGbufferA(1, s.a * s.r);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_gbuffer_vizn : iface_fgbuffer : lib_pbr_frg {
  ps_common_vizn(ModColor, vec3(0, 0, 1));
}
///////////////////////////////////////////////////////////////
fragment_shader ps_gbuffer_n // normalmap
    : iface_fgbuffer 
    : lib_pbr_frg
    : lib_gbuf_encode
     {
  vec3 TN = texture(CNMREA, vec3(frg_uv0,1)).xyz;
  TN      = mix(TN, vec3(0.5, 1, 0.5), 0.0);
  vec3 N  = normalize(TN * 2.0 - vec3(1, 1, 1));
  ps_common_n(ModColor, N, frg_uv0);
}
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
// FORWARD
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////

vertex_interface vif_DPP {
  inputs {
    vec4 position : POSITION;
  }
  outputs {
    float frg_depth;
  }
}
vertex_interface vif_DPP_skinned : ub_std_vtx : iface_skintools {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
  }
  outputs {
    float frg_depth;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_DPP 
  : vif_DPP
  : ub_frg_fwd {
  outputs {
    layout(location = 0) float gl_FragDepth;
  }
}

///////////////////////////////////////////////////////////////
// Forward Depth Prepass
///////////////////////////////////////////////////////////////
uniform_block ublk_dpp (descriptor_set 0) {
  mat4 mvp_dpp;
}

vertex_shader vs_forward_depthprepass_mono //
  : vif_DPP                        //
  : ublk_std_matrices {                    //
  vec4 hpos    = mvp * position;
  gl_Position  = hpos;
  frg_depth =  (hpos.z/hpos.w);
}
vertex_shader vs_forward_depthprepass_skinned_mono //
  : vif_DPP_skinned //
  : lib_skin_tools //
  : ublk_std_matrices { //
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec4 hpos    = mvp * skn_pos;
  gl_Position  = hpos;
  frg_depth = (hpos.z) / (hpos.w);
}
fragment_shader ps_forward_depthprepass_mono // 
  : fif_DPP { //
  //gl_FragDepth = frg_depth;
  gl_FragDepth = gl_FragCoord.z + DppZBias;
}
///////////////////////////////////////////////////////////////
// Forward pbr
///////////////////////////////////////////////////////////////

// Non-skinned forward vertex interface
vertex_interface vif_FWDTEST : vif_forward_outputs : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec2 uv0 : TEXCOORD0;
  }
}
// Skinned forward vertex interface - same outputs, adds bone inputs
// Inputs are explicitly ordered: standard vertex attrs first, then bone attrs
vertex_interface vif_FWDTEST_SKINNED : vif_forward_outputs : ub_vtx_boneblock : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec2 uv0 : TEXCOORD0;
    uvec4 boneindices : BONEINDICES;
    vec4 boneweights : BONEWEIGHTS;
  }
}
// Fragment interface - inherits outputs from vif_forward_outputs
fragment_interface fif_FWDTEST
  : vif_forward_outputs
  : ub_frg_fwd
  : storage_fwd_lighting
  : ss_frg_fwd {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_test 
  : vif_FWDTEST 
  : lib_pbr_vtx 
  : ublk_std_matrices {

  // frg_wpos, frg_tbn, frg_camz, frg_camdist
  vs_common(position, normal, binormal); 

  gl_Position = mvp * position;
  frg_uv0         = vec2(1,1)+ (uv0 * vec2(1, -1));
  //frg_uv0         = uv0;
  frg_clr         = vec4(1,1,1,1); //vtxcolor
  frg_modcolor    = vec4(1,1,1,1); //modcolor
}
///////////////////////////////////////////////////////////////
vertex_interface vif_FWDTESTVC : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec4 vtxcolor : COLOR0;
  }
  outputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
    vec4 frg_modcolor;
  }
}
fragment_interface fif_FWDTESTVC
  : vif_FWDTESTVC
  : ub_frg_fwd 
  : storage_fwd_lighting 
  : ss_frg_fwd {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
vertex_shader vs_forward_test_vtxcol 
  : vif_FWDTESTVC 
  : lib_pbr_vtx 
  : ublk_std_matrices {

  // frg_wpos, frg_tbn, frg_camz, frg_camdist
  vs_common(position, normal, binormal); 

  gl_Position = mvp * position;
  frg_uv0         = vec2(1,1);
  frg_clr         = vtxcolor;
  frg_modcolor    = vec4(1,1,1,1); //modcolor
}
//////////////////////////////////////
fragment_shader ps_forward_test_vtxcol //
    : fif_FWDTESTVC             //
    : lib_math                  //
    : lib_brdf                  //
    : lib_def                   //
    : lib_fwd
    : std_forward_all {
  out_color = vec4(forward_lighting_ntex(frg_clr.xyz) * ModColor.rgb, frg_clr.a * ModColor.a);
}
//////////////////////////////////////
fragment_shader ps_forward_test_vtxcol_alpha //
    : fif_FWDTESTVC             //
    : lib_math                  //
    : lib_brdf                  //
    : lib_def                   //
    : lib_fwd
    : std_forward_all {
  vec3 lit = forward_lighting_ntex(frg_clr.xyz) * ModColor.rgb;
  float vtx_alpha = frg_clr.a;
  float lum = dot(lit, vec3(0.2126, 0.7152, 0.0722));
  float boosted = clamp(vtx_alpha + lum * (1.0 - vtx_alpha), vtx_alpha, 1.0);
  out_color = vec4(lit, boosted * ModColor.a);
}
//////////////////////////////////////
fragment_shader ps_forward_instanced_vtxcol_alpha //
    : fif_FWDTESTVC             //
    : lib_math                  //
    : lib_brdf                  //
    : lib_def                   //
    : lib_fwd
    : std_forward_all {
  vec3 lit = forward_lighting_ntex(frg_clr.xyz);
  out_color = vec4(lit, frg_clr.a);
}
//////////////////////////////////////
fragment_shader ps_forward_test //
    : fif_FWDTEST             //
    : lib_math                  //
    : lib_brdf                  //
    : lib_def                   //
    : lib_fwd
    : std_forward_all {
  vec4 lit = forward_lighting_mono_alpha(frg_clr.xyz*ModColor.xyz);
  if (AlphaCutoff > 0.0 && lit.a < AlphaCutoff)
    discard;
  out_color = vec4(lit.rgb, 1.0);
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_instanced
  : vif_FWDTEST
  : storage_instancing
  : lib_pbr_vtx_instanced {
  mat4 instancemtx = _instance_matrices[gl_InstanceIndex];
  vec4 instanced_pos = instancemtx * position;
  vs_instanced(position, normal, binormal);
  gl_Position = mvp * instanced_pos;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_instanced_vc
  : vif_FWDTESTVC
  : storage_instancing
  : lib_pbr_vtx_instanced_vc {
  mat4 instancemtx = _instance_matrices[gl_InstanceIndex];
  vec4 instanced_pos = instancemtx * position;
  vs_instanced_vc(position, normal, binormal, vtxcolor);
  gl_Position = mvp * instanced_pos;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_test_vtxcolor : vif_PNBC : lib_pbr_vtx : ublk_std_matrices {
  vs_common(position, normal, binormal);
  gl_Position = mvp * position;
  frg_clr = vtxcolor;
}
vertex_shader vs_forward_skinned_mono : vif_FWDTEST_SKINNED : lib_skin_tools : lib_pbr_vtx : ublk_std_matrices {
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec3 skn_nrm = SkinNormal(normal);
  vec3 skn_bit = SkinNormal(binormal); // technically binormal is a bitangent
  vs_common(skn_pos, skn_nrm, skn_bit);
  ////////////////////////////////
  gl_Position = mvp * skn_pos;
  frg_uv0 = uv0 * vec2(1, -1);
  frg_clr = vec4(1,1,1,1);
  frg_modcolor = vec4(1,1,1,1);
}
//////////////////////////////////////
fragment_shader ps_forward_test_fragcolor //
    : iface_forward             //
    : lib_math                  //
    : lib_brdf                  //
    : lib_def                   //
    : lib_fwd
    : std_forward_all {                 //
  vec4 lit = forward_lighting_mono_alpha(frg_clr.xyz*ModColor.xyz);
  if (AlphaCutoff > 0.0 && lit.a < AlphaCutoff)
    discard;
  out_color = lit;
}

///////////////////////////////////////////////////////////////
// Forward SkyBox
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_skybox_mono : vif_PC {
  gl_Position = position; // screen space quad
  frg_clr     = position;
}
///////////////////////////////////////////////////////////////
libblock std_forward_all 
    : ublk_std_lighting
    : uset_std_viewport
    : ublk_std_pbr 
    : ublk_std_matrices
    : sset_std_lighting 
    : sset_std_pbr
    : sset_std_ssao
  {
  }
///////////////////////////////////////////////////////////////
fragment_shader ps_forward_skybox_mono //
    : fif_PC                    //
    : lib_envmapping
    : std_forward_all
     { //

  ///////////////////////
  // compute view normal vector
  ///////////////////////

  vec2 uvn = frg_clr.xy;

  vec4 xyzw = vec4(uvn, 0, 1);
  xyzw      = inv_vp * xyzw;
  xyzw.xyz *= (1.0 / xyzw.w);
  vec3 posA = xyzw.xyz;
  xyzw      = vec4(uvn, 1, 1);
  xyzw      = inv_vp * xyzw;
  xyzw.xyz *= (1.0 / xyzw.w);
  vec3 posB = xyzw.xyz;
  vec3 VN   = normalize(posA - posB);

  ///////////////////////
  // environment map
  ///////////////////////

  vec3 VN_transformed = vec3(VN.x, VN.y, -VN.z);

  // Sample environment
  vec2 uv = env_equirectangularN2UVa(VN_transformed);
  vec3 rgb  = textureLod(MapSpecularEnv, vec3(uv.x, 1.0-uv.y,0.0),0).xyz * SkyboxLevel;

  out_clr = vec4(rgb, 1);

  ///////////////////////
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_unlit : vif_PNBT : ublk_std_matrices {
  gl_Position = mvp * position; // screen space quad
  frg_uv0     = uv0;
}
fragment_shader ps_forward_unlit : iface_forward : sset_std_pbr : ublk_std_pbr {
  vec3 rgb = texture(CNMREA, vec3(frg_uv0,0)).xyz;
  rgb *= ModColor.xyz;
  out_color = vec4(ModColor.xyz, 1);
}
///////////////////////////////////////////////////////////////
// picking
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
vertex_interface iface_vtx_pick_skinned //
    : iface_skintools {                 //
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec3 frg_wpos;
    vec3 frg_wnrm;
    vec2 frg_uv;
    flat uvec3 frg_pickSUBID;
  }
}
///////////////////////////////////////////////////////////////
// Simple rigid pick interface - standard vertex format (no sub-ID input)
///////////////////////////////////////////////////////////////
vertex_interface iface_vtx_pick_rigid_simple {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
  }
  outputs {
    vec3 frg_wpos;
    vec3 frg_wnrm;
    vec2 frg_uv;
    flat uvec3 frg_pickSUBID;
  }
}
///////////////////////////////////////////////////////////////
// Original rigid pick interface (requires uvec3 pickSUBID in vertex data)
///////////////////////////////////////////////////////////////
vertex_interface iface_vtx_pick_rigid {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    uvec3 pickSUBID : TEXCOORD1;
  }
  outputs {
    vec3 frg_wpos;
    vec3 frg_wnrm;
    vec2 frg_uv;
    flat uvec3 frg_pickSUBID;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_frg_pick : ub_frg_fwd {
  inputs {
    vec3 frg_wpos;
    vec3 frg_wnrm;
    vec2 frg_uv;
    flat uvec3 frg_pickSUBID;
  }
  outputs {
    layout(location = 0) uvec4 out_pickID;
    layout(location = 1) vec4 out_wpos;
    layout(location = 2) vec4 out_wnrm;
    layout(location = 3) vec4 out_uv;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_pick_skinned_mono : iface_vtx_pick_skinned : lib_skin_tools : ub_std_vtx : ublk_std_matrices {
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec3 skn_nrm = SkinNormal(normal);
  gl_Position  = mvp * skn_pos;
  frg_wpos     = (m * skn_pos).xyz;
  frg_wnrm     = normalize(mrot * skn_nrm);
  frg_uv      = uv0;
  // Use primary bone index as sub-ID for skinned picking
  frg_pickSUBID  = uvec3(boneindices.x, 0, 0);
}
///////////////////////////////////////////////////////////////
// Simple rigid pick shader - works with standard vertex formats
///////////////////////////////////////////////////////////////
vertex_shader vs_pick_rigid_simple_mono : iface_vtx_pick_rigid_simple : ub_std_vtx : ublk_std_matrices {
  gl_Position    = mvp * position;
  frg_wpos       = (m * position).xyz;
  frg_wnrm       = normalize(mrot * normal);
  frg_uv         = vec2(0,0);
  frg_pickSUBID  = uvec3(0,0,0);  // No sub-ID for simple rigid picking
}
///////////////////////////////////////////////////////////////
// Original rigid pick shader (requires uvec3 pickSUBID in vertex data)
///////////////////////////////////////////////////////////////
vertex_shader vs_pick_rigid_mono : iface_vtx_pick_rigid : ub_std_vtx : ublk_std_matrices {
  gl_Position = mvp * position;
  frg_wpos    = (m * position).xyz;
  frg_wnrm    = normalize(mrot * normal);
  frg_uv      = vec2(0,0);
  frg_pickSUBID  = pickSUBID;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_pick : iface_frg_pick : uset_std_pick {
  out_pickID = uvec4(obj_pickID, frg_pickSUBID.x, frg_pickSUBID.y, frg_pickSUBID.z);
  out_wpos   = vec4(frg_wpos, 0);
  out_wnrm   = vec4(normalize(frg_wnrm), 0);
  out_uv     = vec4(frg_uv, 0, 0);
}
///////////////////////////////////////////////////////////////
// Skeleton pick interface - Position, Normal, Color, UserData (bone ID for picking)
///////////////////////////////////////////////////////////////
vertex_interface iface_vtx_pick_skeleton : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec4 vtxcolor : COLOR0;
    uvec3 pickSUBID : USERDATA;  // _data[0] = bone ID
  }
  outputs {
    vec3 frg_wpos;
    vec3 frg_wnrm;
    vec2 frg_uv;
    flat uvec3 frg_pickSUBID;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_pick_skeleton : iface_vtx_pick_skeleton : ublk_std_matrices {
  gl_Position   = mvp * position;
  frg_wpos      = (m * position).xyz;
  frg_wnrm      = normalize(mrot * normal);
  frg_uv        = vec2(0, 0);
  frg_pickSUBID = pickSUBID;  // Pass bone ID from vertex data
}
///////////////////////////////////////////////////////////////
