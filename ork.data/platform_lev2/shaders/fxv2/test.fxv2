///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
import "orkshader://stdtools.i2";
fxconfig fxcfg_default {
  glsl_version = "150";
}
///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////
vertex_interface iface_vdefault {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
    vec2 uv1 : TEXCOORD1;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv;
  }
  storage {
    storage_fwd_lighting
  }
}
storage_interface storage_xxx (descriptor_set 0) {
  buffer layout(std430) lights {
    vec4 _lightcolor[64];    // 1024 : 1024 
    vec4 _lightsizbias[64];  // 1024 : 2048
    vec4 _lightpos[64];      // 1024 : 3072
    mat4 _shadowmatrix[64];  // 4096 : 7168
    uint _lightTexSlice[64]; // 256  : 7424
  };
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fdefault : iface_vdefault {
  outputs { vec4 out_clr; }
}
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
  BlendMode = OFF;
  DepthTest = OFF;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_vtxcolor : iface_vdefault {
  gl_Position = mvp * position;
  frg_clr     = vtxcolor;
  frg_uv      = uv0;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fragclr : iface_fdefault {
  out_clr = frg_clr;
  // out_clr = vec4(1.0,0.0,1.0,1.0);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_modclr : iface_fmt { out_clr = ModColor; }
///////////////////////////////////////////////////////////////

technique T1 {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
technique T2 {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_fragclr, sb_default }
}
