///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
import "mathtools.i2";
import "misctools.i2";
import "envtools.i2";
// import "picktools.i2";
import "pbrtools.i2";
import "stdtools.i2";
import "ssaotools.i2";
}
///////////////////////////////////////////////////////////////
state_block sb_forward : default {
  // BlendMode = ALPHA;
  // DepthTest = LEQUALS;
  // DepthMask = true;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
state_block sb_forward_blend : default {
  BlendMode = ALPHA;
  // DepthTest = LEQUALS;
  // DepthMask = true;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
vertex_interface vif_FWDLIT : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    // vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_FWDLIT //
  : vif_FWDLIT                //
  : ub_frg_fwd                //
  : storage_fwd_lighting      //
  : ss_frg_fwd {              //
  outputs {
    layout(location = 0) vec4 out_clr;
    layout(location = 1) vec4 out_diffuse;   // P3.B
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_grid_forward_lit //
  : vif_FWDLIT                    //
  : lib_pbr_vtx                   //
  : ublk_std_matrices {           //
  gl_Position = mvp * position;
  frg_uv0     = uv0;
  frg_wpos    = m * position;
  frg_camdist = 0.0;
  frg_camz    = vec3(0, 0, 0);
  frg_clr     = vec4(1, 1, 1, 1);
}
///////////////////////////////////////////////////////////////
vertex_interface vif_DEPTHPP {
  inputs {
    vec4 position : POSITION;
  }
  outputs {
    float frg_camz;
  }
}
fragment_interface fif_DEPTHPP : vif_DEPTHPP {
  // inherits inputs from vif
  outputs {
    layout(location = 0) float out_z;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_grid_forward_depth_prepass //
  : vif_DEPTHPP                             //
  : ublk_std_matrices {                     //
  vec4 HPOS = mvp * position;
  gl_Position = HPOS;
  frg_camz     = HPOS.z/HPOS.w;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_grid_forward_depth_prepass //
 : fif_DEPTHPP {                              //
  out_z   = frg_camz;
}
///////////////////////////////////////////////////////////////
libblock lib_frg_grid {
  float grid(float coord, float size) {
    float halfsize = size * 0.5;
    float f        = abs(fract(coord / size - 0.5) - 0.5) / halfsize;
    return clamp(1.0 - f, 0.0, 1.0);
  }

  // Box filter (single line in 1D, returns coverage)
  float gridLine1D(float coord, float lineWidth, float filterWidth) {
    // Distance to nearest integer (grid line at integers)
    float dist = abs(fract(coord + 0.5) - 0.5);

    // Box filter: integral of line over pixel footprint
    // Line covers [-lineWidth/2, lineWidth/2] around grid line
    // Pixel covers [dist - filterWidth/2, dist + filterWidth/2]
    float halfLine = lineWidth * 0.5;
    float halfFilter = max(filterWidth * 0.5, 0.001);

    // Clamp-based box filter integration
    float lo = max(dist - halfFilter, 0.0);
    float hi = min(dist + halfFilter, halfLine);
    float overlap = max(hi - lo, 0.0);
    float coverage = overlap / (halfFilter * 2.0);

    // Boost close-up coverage with contrast curve
    coverage = smoothstep(0.0, 0.7, coverage);

    // When filter is very wide (beyond Nyquist), blend to boosted average
    float nyquistFade = smoothstep(0.4, 0.6, filterWidth);
    float boostedAvg = min(lineWidth * 4.0, 0.5);
    coverage = mix(coverage, boostedAvg, nyquistFade);

    return coverage;
  }
  float filteredGrid(vec2 coord, vec2 dx, vec2 dy, float lineWidth) {
    // Calculate the filter width based on screen-space derivatives
    vec2 fw = abs(dx) + abs(dy);

    // Grid coordinates
    vec2 grid_coord = fract(coord - 0.5);

    // Distance to nearest grid line
    vec2 dist = min(grid_coord, 1.0 - grid_coord);

    // Apply smoothstep with derivative-based width
    vec2 line = smoothstep(vec2(0.0), fw + vec2(lineWidth), dist);

    // Combine X and Y grid lines
    return 1.0 - min(line.x, line.y);
  }
  float filteredGridV2(vec2 coord, vec2 dx, vec2 dy, float lineWidth) {
    // Filter width per axis (length of gradient = pixels per unit)
    float fwX = length(vec2(dx.x, dy.x));
    float fwY = length(vec2(dx.y, dy.y));

    // Get line coverage for each axis
    float lineX = gridLine1D(coord.x, lineWidth, fwX);
    float lineY = gridLine1D(coord.y, lineWidth, fwY);

    // Union of X and Y grid lines
    return max(lineX, lineY);
  }
  float checkerboard_fixed(vec3 pos, float intensA, float intensB) {
    vec2 check_pos = pos.xz;
    vec2 fw        = fwidth(check_pos) * 1.3;

    // Use triangle wave instead of fract for continuity
    vec2 p            = check_pos * 0.5;
    vec2 triangleWave = abs(1.0 - 2.0 * abs(fract(p + 0.25) - 0.5));

    // Now smoothstep works on ALL boundaries
    vec2 check = smoothstep(0.5 - fw, 0.5 + fw, triangleWave);

    // XOR pattern
    float pattern = check.x * (1.0 - check.y) + (1.0 - check.x) * check.y;

    return mix(intensB, intensA, pattern);
  }
  vec4 grid_output(vec3 pos) {
    vec2 paramMajor = frg_uv0 + vec2(100.0, 100.0);
    vec2 dpdxMajor  = dFdx(paramMajor) * 2;
    vec2 dpdyMajor  = dFdy(paramMajor) * 2;

    vec2 paramMinor = paramMajor * 10.0;
    vec2 dpdxMinor  = dFdx(paramMinor);
    vec2 dpdyMinor  = dFdy(paramMinor);

    float gMajor = filteredGrid(paramMajor, dpdxMajor, dpdyMajor, 0.02);
    float gMinor = filteredGrid(paramMinor, dpdxMinor, dpdyMinor, 0.02);

    vec3 basecolor  = vec3(.48, .62, .90) * 0.95;
    vec3 majorcolor = basecolor * 1.1;
    vec3 minorcolor = basecolor * 1.05;

    vec3 color = mix(minorcolor, basecolor, gMinor);
    vec4 oc    = vec4(mix(majorcolor, color, gMajor), 1.0 - gMajor);

    return vec4(oc.xyz, 1);
  }
  vec4 grid_output_V3(vec3 pos) {

    float dXdx = dFdx(pos.x);
    float dXdy = dFdy(pos.x);
    float dZdx = dFdx(pos.z);
    float dZdy = dFdy(pos.z);

    // Major grid at integer world coordinates (0, 1, 2...) to align with checkerboard
    vec2 paramMajor = pos.xz;
    // Minor grid at 0.1 spacing
    vec2 paramMinor = pos.xz * 10.0;

    vec2 dpdxMajor = dFdx(paramMajor);
    vec2 dpdyMajor = dFdy(paramMajor);
    vec2 dpdxMinor = dFdx(paramMinor);
    vec2 dpdyMinor = dFdy(paramMinor);

    float widthMajor = 0.05;
    float widthMinor = 0.025;

    float gMajor = filteredGridV2(paramMajor, dpdxMajor, dpdyMajor, widthMajor);
    float gMinor = filteredGridV2(paramMinor, dpdxMinor, dpdyMinor, widthMinor);

    // X, Z axis lines with analytical AA
    float widthAxis = 0.04;
    float edgeWidthX = length(vec2(dXdx, dXdy));
    float edgeWidthZ = length(vec2(dZdx, dZdy));

    // Compute AA filter width: half-pixel in world space
    float filterX = edgeWidthX * 0.5;
    float filterZ = edgeWidthZ * 0.5;

    // Distance to axis lines
    float distX = abs(pos.x);
    float distZ = abs(pos.z);

    // Analytically antialiased axis coverage using smoothstep
    // smoothstep from (width - filter) to (width + filter) gives smooth falloff
    float axisX = 1.0 - smoothstep(widthAxis - filterX, widthAxis + filterX, distX);
    float axisZ = 1.0 - smoothstep(widthAxis - filterZ, widthAxis + filterZ, distZ);

    // Combine axis contributions (union)
    float axisCoverage = max(axisX, axisZ);

    // Axis colors with smooth AA
    vec3 tgt_x = mix(vec3(.5, 0, 0), vec3(1.5, 0, 0), float(pos.x > 0.0));
    vec3 tgt_z = mix(vec3(0, 0, .5), vec3(0, 0, 1.5), float(pos.z > 0.0));

    vec3 axisColor = tgt_x * axisZ + tgt_z * axisX;

    // Combine all elements into alpha with proper AA
    // Use screen-door style combination: 1 - (1-a)(1-b)(1-c)
    // This gives proper coverage for overlapping elements
    float alphaMajor = gMajor;
    // float alphaMinor = gMinor * 0.5;  // Minor grid is more subtle

    // Composite alpha: union of all grid elements
    // float alphaGrid = 1.0 - (1.0 - alphaMajor) * (1.0 - alphaMinor);
    float alphaGrid = alphaMajor;
    float alphaTotal = 1.0 - (1.0 - alphaGrid) * (1.0 - axisCoverage);

    // Clamp to valid range
    float m = clamp(alphaTotal, 0.0, 1.0);

    return vec4(axisColor, m);
  }
  vec4 grid_output_V4(vec3 pos) {

    float pos_shift_minor = 0.5 / 10.0;
    float pos_shift_major = 0.5;
    vec3 shifted_pos_minor = pos + vec3(pos_shift_minor, 0, pos_shift_minor);
    vec3 shifted_pos_major = pos + vec3(pos_shift_major, 0, pos_shift_major);

    float dXdx      = dFdx(shifted_pos_minor.x);
    float dXdy      = dFdy(shifted_pos_minor.x);
    float dZdx      = dFdx(shifted_pos_minor.z);
    float dZdy      = dFdy(shifted_pos_minor.z);

    vec2 paramMajor = shifted_pos_major.xz;
    vec2 paramMinor = shifted_pos_minor.xz * 10.0;


    vec2 dpdxMajor = dFdx(paramMajor);
    vec2 dpdyMajor = dFdy(paramMajor);
    vec2 dpdxMinor = dFdx(paramMinor);
    vec2 dpdyMinor = dFdy(paramMinor);

    float intensA = 1.0;
    float intensB = 0.75;
    float intensC = 0.75;
    float intensD = 0.75;
    float widthMajor = 0.02;  // Thinner lines for major grid
    float widthMinor = 0.01;  // Even thinner for minor grid

    float gMajor = filteredGrid(paramMajor, dpdxMajor, dpdyMajor, widthMajor);
    float gMinor = filteredGrid(paramMinor, dpdxMinor, dpdyMinor, widthMinor);

    // Default base color setup (might be overridden based on axis logic)
    vec3 basecolor = ModColor.xyz;

    // minor, major grid lines
    basecolor = mix(basecolor, basecolor * intensC, gMajor);
    basecolor = mix(basecolor, basecolor * intensD, gMinor);

    // checkerboard
    float C = checkerboard_fixed(pos, intensA, intensB);
    basecolor *= C;

    // X, Z axis lines
    float widthAxis = 0.04;  // Thinner lines for major grid
    float edgeWidthX     = length(vec2(dXdx, dXdy));
    float edgeWidthZ     = length(vec2(dZdx, dZdy));
    float adjustedWidthX = widthAxis + 0.5 * edgeWidthX;
    float adjustedWidthZ = widthAxis + 0.5 * edgeWidthZ;

    float clamo_x = clamp(abs(pos.x) / adjustedWidthX, 0.0, 1.0);
    float clamo_z = clamp(abs(pos.z) / adjustedWidthZ, 0.0, 1.0);

    float map_x = 1.0 - smoothstep(0.5, 1.0, clamo_x);
    float map_z = 1.0 - smoothstep(0.5, 1.0, clamo_z);

    vec3 tgt_x = mix(vec3(.5, 0, 0), vec3(1.5, 0, 0), float(pos.x > 0.0));
    vec3 tgt_z = mix(vec3(0, 0, .5), vec3(0, 0, 1.5), float(pos.z > 0.0));

    vec3 lerp_x = mix(vec3(1), tgt_x, map_z);
    vec3 lerp_z = mix(vec3(1), tgt_z, map_x);

    basecolor *= lerp_x;
    basecolor *= lerp_z;

    return vec4(basecolor, 1);
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_grid_forward_lit_mono : fif_FWDLIT : lib_math //
    : lib_brdf                                                   //
    : lib_def                                                    //
    : lib_fwd                                                    //
    : lib_frg_grid                                               //
    : std_forward_all {                                          //
  vec4 gout = grid_output(frg_wpos.xyz);
  ShadingResult sr = forward_lighting_mono(gout.xyz);
  out_clr     = vec4(sr.specular + sr.diffuse, 1);
  // P3.D — SSSS mask in alpha.
  float sss_mask = (has_subsurface != 0) ? subsurface_factor : 0.0;
  out_diffuse = vec4(sr.diffuse, sss_mask);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_grid_forward_lit_mono_V4                         //
    : fif_FWDLIT                                                    //
    : lib_math                                                      //
    : lib_brdf                                                      //
    : lib_def                                                       //
    : lib_fwd                                                       //
    : lib_frg_grid                                                  //
    : storage_fwd_lighting                                          //
    : std_forward_all {                                             //
  vec4 gout = grid_output_V4(frg_wpos.xyz);

  ShadingResult sr = _forward_lightingZ(
    vec3(1,1,1), // modcolor
    gout.xyz,    // albedo
    vec3(1,1,0), // ambrufmtl (x=AO; 1.0=unoccluded — AO now consumed by fwd lighting)
    vec3(0,0,0), // emission
    EyePostion,  // eye
    vec3(0,1,0), // normal
    false        // emissive toggle
  );
  out_clr     = vec4(sr.specular + sr.diffuse, 1);
  // P3.D — SSSS mask in alpha.
  float sss_mask = (has_subsurface != 0) ? subsurface_factor : 0.0;
  out_diffuse = vec4(sr.diffuse, sss_mask);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_grid_forward_lit_mono_V3                        //
    : fif_FWDLIT                                                    //
    : lib_math                                                      //
    : lib_brdf                                                      //
    : lib_def                                                       //
    : lib_fwd                                                       //
    : lib_frg_grid                                                  //
    : storage_fwd_lighting                                          //
    : std_forward_all {                                             //
  out_clr     = grid_output_V3(frg_wpos.xyz);
  out_diffuse = vec4(0);   // P3.B — V3 grid is unlit; no diffuse contribution
}
///////////////////////////////////////////////////////////////
technique FWD_CT_NM_RI_NI_MO {
  fxconfig = fxcfg_default;
  vf_pass = { vs_grid_forward_lit, ps_grid_forward_lit_mono_V4, sb_forward }
}
technique FWD_CT_NM_RI_NI_MO_V2 {
  fxconfig = fxcfg_default;
  vf_pass = { vs_grid_forward_lit, ps_grid_forward_lit_mono_V4, sb_forward }
}
technique FWD_CT_NM_RI_NI_MO_V3 {
  fxconfig = fxcfg_default;
  vf_pass = { vs_grid_forward_lit, ps_grid_forward_lit_mono_V3, sb_forward_blend }
}
technique FWD_CT_NM_RI_NI_MO_V4 {
  fxconfig = fxcfg_default;
  vf_pass = { vs_grid_forward_lit, ps_grid_forward_lit_mono_V4, sb_forward }
}
technique FWD_CT_NM_RI_NI_MO_V5 {
  fxconfig = fxcfg_default;
  vf_pass = { vs_grid_forward_lit, ps_grid_forward_lit_mono_V4, sb_forward }
}
///////////////////////////////////////////////////////////////
state_block sb_grid_dpp : default {
  // BlendMode = ALPHA;
  // DepthTest = LEQUALS;
  // DepthMask = true;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
technique FWD_DEPTHPREPASS_RI_NI_MO {
  fxconfig = fxcfg_default;
  vf_pass  = { vs_grid_forward_depth_prepass, ps_grid_forward_depth_prepass, sb_grid_dpp }
}
technique FWD_DEPTHPREPASS_RI_NI_MO_V2 {
  fxconfig = fxcfg_default;
  vf_pass  = { vs_grid_forward_depth_prepass, ps_grid_forward_depth_prepass, sb_grid_dpp }
}
technique FWD_DEPTHPREPASS_RI_NI_MO_V3 {
  fxconfig = fxcfg_default;
  vf_pass  = { vs_grid_forward_depth_prepass, ps_grid_forward_depth_prepass, sb_grid_dpp }
}
technique FWD_DEPTHPREPASS_RI_NI_MO_V4 {
  fxconfig = fxcfg_default;
  vf_pass  = { vs_grid_forward_depth_prepass, ps_grid_forward_depth_prepass, sb_grid_dpp }
}
technique FWD_DEPTHPREPASS_RI_NI_MO_V5 {
  fxconfig = fxcfg_default;
  vf_pass  = { vs_grid_forward_depth_prepass, ps_grid_forward_depth_prepass, sb_grid_dpp }
}