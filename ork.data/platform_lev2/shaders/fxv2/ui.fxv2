///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default { glsl_version = "150"; }
///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////

uniform_set push_constants { //
  mat4 mvp;
  mat4 mvp_l;
  mat4 mvp_r;
  vec4 ModColor;
}
sampler_set samplers (descriptor_set 0) {
  sampler2D ColorMap;
}

vertex_interface iface_vdefault : push_constants {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    //vec4 frg_clr;
    vec2 frg_uv;
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_DUALUV : push_constants {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
    vec2 uv1 : TEXCOORD1;
  }
  outputs {
    //vec4 frg_clr;
    vec2 frg_uv;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fdefault {
  inputs {
    //vec4 frg_clr;
    vec2 frg_uv;
  }
  outputs {
    vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fmt 
  : push_constants
  : samplers {
  inputs {
    vec2 frg_uv;
  }
  outputs {
    vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
  BlendMode = OFF;
  CullTest  = OFF;
  DepthTest = ALWAYS;
  DepthMask = OFF;
}
///////////////////////////////////////////////////////////////
state_block sb_lerpblend : sb_default {
  BlendMode = ALPHA;
  CullTest  = OFF;
  DepthTest = ALWAYS;
  DepthMask = OFF;
}
///////////////////////////////////////////////////////////////
// premultiplied-alpha OVER: (Src*1) + (Dst*(1-SrcAlpha)). For compositing a
// premultiplied RT (foreground rendered over a transparent clear) into a target
// without the straight-alpha double-darken / halo.
state_block sb_prema : sb_default {
  BlendMode = PREMA;
  CullTest  = OFF;
  DepthTest = ALWAYS;
  DepthMask = OFF;
}
///////////////////////////////////////////////////////////////
state_block sb_additive : sb_default {
  BlendMode = ADDITIVE;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
// shaders
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
vertex_interface vif_UITEXT : push_constants {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv;
  }
}
fragment_interface fif_UITEXT
  : vif_UITEXT {
  outputs {
    vec4 out_clr;
  }
}
vertex_shader vs_uitext : iface_vdefault {
  gl_Position = mvp * position;
  frg_uv      = uv0;  
}
fragment_shader ps_uitext : iface_fmt {
  vec4 s = textureLod(ColorMap, frg_uv,0);
  float texa = s.r; //pow(s.r,0.5);
  //out_clr = s; //vec4(texa,texa,texa,1);
  out_clr = vec4(ModColor.xyz, texa);
  //out_clr = vec4(ModColor.xyz, texa);
}
///////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////
fragment_shader ps_uitext_stereo : iface_fmt {
  vec4 s = texture(ColorMap, frg_uv);
  float texa = s.r; //ow(s.a*s.r,0.75);
  //out_clr = vec4(ModColor.xyz, texa);
  //if(texa < 0.005) discard;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_uitextured : iface_fmt {
  vec4 texc = texture(ColorMap, frg_uv);
  out_clr   = texc * ModColor;
}
///////////////////////////////////////////////////////////////
// Adaptive Lanczos-3 downsampling for high-quality texture display
// Optimized for extreme downsampling (8K → display resolution)
// Uses fixed sample grid scaled to footprint for consistent performance
///////////////////////////////////////////////////////////////
libblock lib_lanczos3 {

  // Fast sinc approximation using rational polynomial (accurate to ~0.001)
  // Avoids expensive sin() call
  float sinc_fast(float x) {
    float ax = abs(x);
    if (ax < 0.0001) return 1.0;
    if (ax > 3.0) return 0.0;

    // Pade approximation for sin(pi*x)/(pi*x)
    float x2 = x * x;
    float num = 1.0 - x2 * (1.6449 - x2 * (0.8117 - x2 * 0.1517));
    float den = 1.0 + x2 * (0.0379 + x2 * 0.0015);
    return num / den;
  }

  // Original sinc for reference
  float sinc(float x) {
    if (abs(x) < 0.0001) return 1.0;
    float pix = PI * x;
    return sin(pix) / pix;
  }

  // Lanczos-3 kernel using fast sinc
  float lanczos3_fast(float x) {
    if (abs(x) >= 3.0) return 0.0;
    return sinc_fast(x) * sinc_fast(x / 3.0);
  }

  // Lanczos-3 kernel (a=3 gives excellent sharpness with minimal ringing)
  float lanczos3(float x) {
    if (abs(x) >= 3.0) return 0.0;
    return sinc(x) * sinc(x / 3.0);
  }

  // 2D Lanczos-3 weight (separable)
  float lanczos3_2D(vec2 offset) {
    return lanczos3(offset.x) * lanczos3(offset.y);
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_uitextured_aa
  : iface_fmt
  : lib_lanczos3 {

  // Get texture dimensions
  vec2 texSize = vec2(textureSize(ColorMap, 0));
  vec2 texelSize = 1.0 / texSize;

  // Calculate anisotropic footprint using screen-space derivatives
  vec2 duvdx = dFdx(frg_uv) * texSize;
  vec2 duvdy = dFdy(frg_uv) * texSize;

  // Anisotropic footprint: major and minor axes
  float footprintX = max(abs(duvdx.x), abs(duvdy.x));
  float footprintY = max(abs(duvdx.y), abs(duvdy.y));
  float maxFootprint = max(footprintX, footprintY);

  // If minimal downsampling, use hardware filtering
  if (maxFootprint <= 1.5) {
    vec4 texc = texture(ColorMap, frg_uv);
    out_clr = vec4(texc.xyz * ModColor.xyz, texc.w * ModColor.w);
  } else {
    // Standard Lanczos-3: 16x16 grid = 256 samples
    const int GRID_SIZE = 16;
    const float HALF_GRID = 8.0;

    vec2 footprint = vec2(footprintX, footprintY);
    vec2 centerTexel = frg_uv * texSize;

    vec4 colorSum = vec4(0.0);
    float weightSum = 0.0;

    for (int iy = 0; iy < GRID_SIZE; iy++) {
      float fy = (float(iy) - HALF_GRID + 0.5) / HALF_GRID * 3.0;

      for (int ix = 0; ix < GRID_SIZE; ix++) {
        float fx = (float(ix) - HALF_GRID + 0.5) / HALF_GRID * 3.0;

        float weight = lanczos3(fx) * lanczos3(fy);

        vec2 sampleOffset = vec2(fx, fy) * footprint;
        vec2 sampleUV = (centerTexel + sampleOffset) * texelSize;

        colorSum += texture(ColorMap, sampleUV) * weight;
        weightSum += weight;
      }
    }

    vec4 texc = colorSum / max(weightSum, 0.0001);
    out_clr = vec4(texc.xyz * ModColor.xyz, texc.w * ModColor.w);
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_VTXCOL : push_constants {
  inputs {
    vec4 position : POSITION;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
    vec2 uv1 : TEXCOORD1;
  }
  outputs {
    vec4 frg_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_VTXCOL 
  : vif_VTXCOL {
  outputs {
    vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_vtxcolor : vif_VTXCOL {
  gl_Position = mvp * position;
  frg_clr     = vec4(uv0,0,1);
  //frg_uv      = uv0;
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fragclr : fif_VTXCOL {
  out_clr = frg_clr;
}
///////////////////////////////////////////////////////////////
technique uitext {
  fxconfig = fxcfg_default;
  pass p0A {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_uitext;
    state_block     = sb_lerpblend;
  }
}
///////////////////////////////////////////////////////////////
technique uitextured {
  fxconfig = fxcfg_default;
  pass p0C {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_uitextured;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
// Same as uitextured but with the ALPHA state_block BAKED IN. On Vulkan the blend
// enable/factors are pipeline-baked from the resolved rasterstate and the pass
// state_block wins the resolution — a runtime setBlendingMacro(ALPHA) on a
// FreestyleMaterial (whose _rasterstate is never pushed on the FXI stack) cannot
// override sb_default's BlendMode=OFF. So a translucent textured quad MUST select a
// technique whose state_block is already ALPHA (the pattern FontMan's uitext uses).
technique uitextured_alpha {
  fxconfig = fxcfg_default;
  pass p0C {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_uitextured;
    state_block     = sb_lerpblend;
  }
}
///////////////////////////////////////////////////////////////
// Composite a PREMULTIPLIED textured quad (e.g. a HUD RT rendered over a transparent
// clear) — no straight-alpha halo/double-darken. Sample the texture AS-IS (already
// premultiplied) and blend PREMA. The overlay panel uses this for its text layer.
technique uitextured_prema {
  fxconfig = fxcfg_default;
  pass p0C {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_uitextured;
    state_block     = sb_prema;
  }
}
///////////////////////////////////////////////////////////////
technique uitextured_aa {
  fxconfig = fxcfg_default;
  pass p0C {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_uitextured_aa;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
technique ui_vtx {
  fxconfig = fxcfg_default;
  pass p0D {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_fragclr;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
technique ui_imgview {
  fxconfig = fxcfg_default;
  vf_pass = { vs_vtxcolor, ps_fragclr, sb_default }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_modcolor : vif_VTXCOL {
  gl_Position = mvp * position;
  frg_clr     = vec4(uv0,0,1);
  //frg_uv      = uv0;
}
fragment_shader ps_modclr : fif_VTXCOL { out_clr = ModColor; }
technique uidev_modcolor {
  fxconfig = fxcfg_default;
  pass p0E {
    vertex_shader   = vs_vtxcolor;
    fragment_shader = ps_modclr;
    state_block     = sb_default;
  }
}
///////////////////////////////////////////////////////////////
// Flat ModColor quad, ALPHA-blended — a solid translucent slate (e.g. the HUD panel's
// dark backing drawn straight over the scene before the premultiplied text layer).
// Uses vs_uitext (position/color0/uv0 — matches the V16T16C16 vertex format the HUD
// panel draws; vs_modcolor's vif_VTXCOL demands a TEXCOORD1 that format lacks) and a
// texture-free fragment that just emits ModColor.
fragment_interface iface_fmodc : push_constants {
  inputs { vec2 frg_uv; }
  outputs { vec4 out_clr; }
}
fragment_shader ps_modonly : iface_fmodc { out_clr = ModColor; }
technique uidev_modcolor_alpha {
  fxconfig = fxcfg_default;
  pass p0E {
    vertex_shader   = vs_uitext;
    fragment_shader = ps_modonly;
    state_block     = sb_lerpblend;
  }
}
///////////////////////////////////////////////////////////////

