import "orkshader://mathtools.i2";

libblock lib_brdf : lib_math {

  vec3 importanceSampleGGX(vec2 e, float roughness) {
    float rufsq         = roughness * roughness;
    float rufp4         = rufsq * rufsq;
    float phi           = PI2 * e.x;
    float cosThetaSqNum = (1.0 - e.y);
    float cosThetaSqDiv = (1.0 + (rufp4 - 1.0) * e.y);
    float cosThetaSq    = cosThetaSqNum / cosThetaSqDiv;
    float cosTheta      = sqrt(cosThetaSq);
    float sinTheta      = sqrt(1.0 - cosThetaSq);
    return sphericalToNormal(phi, cosTheta, sinTheta);
  }
  vec3 importanceSampleGGXN(vec2 e, vec3 n, float roughness) {
    vec3 h = importanceSampleGGX(e,roughness);
    vec3 up        = abs(n.z) < 0.999
                   ? vec3(0.0, 0.0, 1.0)
                   : vec3(1.0, 0.0, 0.0);
    vec3 tangent   = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    vec3 result    = tangent*h.x
                   + bitangent*h.y
                   + n*h.z;
    return normalize(result);
  }
  // Geometry term for Image-Based Lighting (IBL)
  float geometrySchlickGGX_IBL(vec3 normal, vec3 dir, float roughness) {
    float k       = roughness * roughness * 0.5;
    float numer   = saturateF(dot(normal,dir));
    float divisor = numer * (1.0 - k) + k;
    return numer / divisor;
  }

  // Geometry term for Direct Lighting (glTF 2.0 / UE4 compliant)
  float geometrySchlickGGX_Direct(vec3 normal, vec3 dir, float roughness) {
    float r       = roughness + 1.0;
    float k       = (r * r) / 8.0;
    float numer   = saturateF(dot(normal,dir));
    float divisor = numer * (1.0 - k) + k;
    return numer / divisor;
  }

  // Legacy function for backward compatibility (uses IBL version)
  float geometrySchlickGGX(vec3 normal, vec3 dir, float roughness) {
    return geometrySchlickGGX_IBL(normal, dir, roughness);
  }

  // Smith visibility term for Direct Lighting
  float geometrySmith_Direct(vec3 normal, vec3 viewdir, vec3 lightdir, float roughness) {
    return geometrySchlickGGX_Direct(normal, viewdir, roughness) * geometrySchlickGGX_Direct(normal, lightdir, roughness);
  }

  // Smith visibility term for IBL
  float geometrySmith_IBL(vec3 normal, vec3 viewdir, vec3 lightdir, float roughness) {
    return geometrySchlickGGX_IBL(normal, viewdir, roughness) * geometrySchlickGGX_IBL(normal, lightdir, roughness);
  }

  // Legacy function for backward compatibility (uses direct lighting version)
  float geometrySmith(vec3 normal, vec3 viewdir, vec3 lightdir, float roughness) {
    return geometrySmith_Direct(normal, viewdir, lightdir, roughness);
  }

  vec3 fresnelSchlick(vec3 normal, vec3 viewdir, vec3 F0) {
    float ndotv_sat = saturateF(dot(normal,viewdir));
    return F0 + (vec3(1, 1, 1) - F0) * pow(1.0 - ndotv_sat, 5.0);
  }
  vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
	{
		return F0+(max(vec3(1)*(1-roughness),F0)-F0) * pow(1.0-cosTheta,5.0);
	}

  vec2 integrateGGX(float n_dot_v, float roughness) {
    int numsamples = 1024;
    n_dot_v = saturateF(n_dot_v);
    float vx = sqrt(1.0 - n_dot_v * n_dot_v);
    vec3 v = vec3(vx, 0, n_dot_v);
    float accum_scale = 0.0;
    float accum_bias  = 0.0;
    for (int i = 0; i < numsamples; i++) {
      vec2 e            = hammersley(i, numsamples);
      vec3 h            = importanceSampleGGX(e, roughness);
      float v_dot_h     = dot(v,h);
      vec3 l            = normalize((h * 2.0 * v_dot_h) - v);
      float n_dot_h_sat = saturateF(h.z);
      float v_dot_h_sat = saturateF(v_dot_h);
      if (l.z > 0.0) {
        float gsmith = geometrySmith_IBL(vec3(0, 0, 1), v, l, roughness);
        float gvis   = (gsmith * v_dot_h) / (n_dot_h_sat * n_dot_v);
        float fc     = pow(1.0 - v_dot_h_sat, 5.0);
        accum_scale += (1.0 - fc) * gvis;
        accum_bias += fc * gvis;
      }
    }
    return vec2(accum_scale / float(numsamples), accum_bias / float(numsamples));
  }

float computeGGX(vec3 normal, vec3 halfdir, float roughness) {
    float a = roughness*roughness;
    float a2 = a*a;
    float ndoth = satdot(normal, halfdir);
    float ndothsq = ndoth*ndoth;
    float denominatorsqrt = (ndothsq * (a2 - 1.0) + 1.0);
    // FIXED: Use a2 instead of a*a for consistency (mathematically equivalent)
    return a2*INV_PI / (denominatorsqrt*denominatorsqrt);
}

  //////////////////////////////////////////////////////////////////////////////
  // DIRECT DIFFUSE — the one evaluation site for every analytic diffuse term in
  // the engine (forward point / spot cookie / sun, and the deferred pair). It
  // returns the BRDF already multiplied by the energy split kD and the base
  // color, with 1/pi folded in. NdotL, light color and distance attenuation stay
  // with the caller: each site attenuates differently and always has.
  //
  // `model` is a UNIFORM, so this is a uniform branch — one pipeline, no shader
  // permutation, and a live editor row can move it between frames.
  //
  // It is a small ORDINAL, not the crc id the scene DSL and the editor traffic
  // in: the crc identity lives on the C++ side (pbr::DiffuseBrdfModel) and is
  // mapped to this index at bind time, so no hash literal is ever baked into
  // shader text.
  //   0 = LAMBERT, 1 = OREN_NAYAR, 2 = BURLEY
  // Anything else falls through to LAMBERT; the binder is what refuses an
  // unknown name, out loud, long before a fragment sees it.
  //////////////////////////////////////////////////////////////////////////////
  vec3 diffuseBRDF(int model, vec3 albedo, vec3 kD, float roughness, vec3 N, vec3 V, vec3 L) {
    vec3 lambert = kD * albedo * INV_PI;
    if (model == 1) {
      // OREN-NAYAR, qualitative A/B form. sigma is the slope-angle deviation of
      // the microfacet distribution, in radians, and it is derived from the SAME
      // roughness the GGX lobe uses — alpha = roughness^2, sigma = alpha/sqrt(2)
      // (the Beckmann RMS-slope correspondence) — so a shading point never
      // carries two disagreeing roughnesses. sigma=0 gives A=1, B=0, which is
      // the lambert above exactly.
      float alpha = roughness * roughness;
      float sigma = alpha * 0.70710678;
      float vari  = sigma * sigma;
      float A     = 1.0 - 0.5 * vari / (vari + 0.33);
      float B     = 0.45 * vari / (vari + 0.09);
      float ndotl = saturateF(dot(N, L));
      float ndotv = saturateF(dot(N, V));
      // trig-free azimuth term: s/t == cos(phi_i - phi_r) * sin(alpha) * tan(beta).
      // s < 0 divides by 1 rather than by max(NdotL,NdotV) — that is the form's
      // own definition, not a guard; A - B is still positive for every sigma.
      float s = dot(L, V) - ndotl * ndotv;
      float t = (s <= 0.0) ? 1.0 : max(max(ndotl, ndotv), 1e-4);
      return lambert * (A + B * (s / t));
    } else if (model == 2) {
      // BURLEY (Disney) — Schlick-weighted grazing retro-reflection. f90 rides
      // the LINEAR roughness (alpha), matching the GGX lobe's convention rather
      // than Disney's own perceptual one.
      float alpha = roughness * roughness;
      vec3  H     = normalize(V + L);
      float ldoth = saturateF(dot(L, H));
      float ndotl = saturateF(dot(N, L));
      float ndotv = saturateF(dot(N, V));
      float f90   = 0.5 + 2.0 * alpha * ldoth * ldoth;
      float fl    = 1.0 + (f90 - 1.0) * pow(1.0 - ndotl, 5.0);
      float fv    = 1.0 + (f90 - 1.0) * pow(1.0 - ndotv, 5.0);
      return lambert * (fl * fv);
    }
    return lambert;
  }

}
