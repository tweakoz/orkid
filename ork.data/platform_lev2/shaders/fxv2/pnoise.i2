////////////////////////////////////////////////////////////////////////////////
// pnoise.i2 — pure-ALU value noise (sampler-free), the ONE canonical noise basis
// shared by ptex3d (fragment raster) AND the terrain compute bake (ExprModule).
//
// The function bodies are copied VERBATIM from lib_mmnoise (misctools.i2:30-86),
// so a P.fbm / P.noise expression is byte-identical across rasterization and
// compute — the unified-substrate alignment contract (see
// .claude/skills/hypersyn/UNIFIED_SUBSTRATE.md §4). What is intentionally left
// behind in lib_mmnoise: the `typ_mmnoise` typeblock and the texture-based
// `octavenoise(sampler3D,...)` — neither is used by P.fbm/P.noise, and the
// sampler is what made lib_mmnoise awkward to inherit into a compute interface.
// lib_pnoise has NO typeblock dependency and NO sampler — safe to inherit
// (`compute_shader cs : iface : lib_pnoise`) or import into a compute shader.
////////////////////////////////////////////////////////////////////////////////
libblock lib_pnoise {

  float hash(float n) {
    return fract(sin(n) * 1e4);
  }
  float hash(vec2 p) {
    return fract(1e4 * sin(17.0 * p.x + p.y * 0.1) * (0.1 + abs(sin(p.y * 13.0 + p.x))));
  }

  float noise(float x) {
    float i = floor(x);
    float f = fract(x);
    float u = f * f * (3.0 - 2.0 * f);
    return mix(hash(i), hash(i + 1.0), u);
  }

  float noise(vec2 x) {
    vec2 i = floor(x);
    vec2 f = fract(x);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
  }

  float noise(vec3 x) {
    const vec3 step = vec3(110, 241, 171);
    vec3 i = floor(x);
    vec3 f = fract(x);
    float n = dot(i, step);
    vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(hash(n + dot(step, vec3(0, 0, 0))), hash(n + dot(step, vec3(1, 0, 0))), u.x),
            mix(hash(n + dot(step, vec3(0, 1, 0))), hash(n + dot(step, vec3(1, 1, 0))), u.x),
            u.y),
        mix(mix(hash(n + dot(step, vec3(0, 0, 1))), hash(n + dot(step, vec3(1, 0, 1))), u.x),
            mix(hash(n + dot(step, vec3(0, 1, 1))), hash(n + dot(step, vec3(1, 1, 1))), u.x),
            u.y),
        u.z);
  }

} // libblock lib_pnoise
