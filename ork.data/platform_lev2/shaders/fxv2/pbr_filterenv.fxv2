///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "130";
  import "mathtools.i2";
  import "misctools.i2";
  import "envtools.i2";
  import "brdftools.i2";
}
///////////////////////////////////////////////////////////////
// Interfaces
///////////////////////////////////////////////////////////////
uniform_set ub_vtx {
  mat4 mv;              // off: 0 siz: 64
  mat4 mvp;             // off: 64 siz: 64
  vec2 InvViewportSize; // off: 128 siz: 8
} // total siz: 136
///////////////////////////////////////////////////////////////
sampler_set ss_frg (descriptor_set 0) {
  sampler2D prefiltmap;
}
///////////////////////////////////////////////////////////////
uniform_block ub_frg (descriptor_set 0) {
  vec2 imgdim;               // off: 0 siz: 8
  float roughness;           // off: 8 siz: 4
  uint numsamples;           // off: 12 siz: 4
  vec2 ViewportSize;         // off: 16 siz: 8
  vec2 InvViewportSizeFrg;   // off: 24 siz: 8
  uint sampleoffset;         // off: 32 siz: 4
  uint totalsamples;         // off: 36 siz: 4
} // total siz: 40
// 136+56 = 192 
///////////////////////////////////////////////////////////////
// StateBlocks
///////////////////////////////////////////////////////////////
state_block sb_default : default {
}
///////////////////////////////////////////////////////////////
// shaders
///////////////////////////////////////////////////////////////
vertex_interface iface_vyo : ub_vtx {
  inputs {
    vec4 position : POSITION;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_yo : iface_vyo {
  gl_Position = mvp * position;
  frg_clr     = vec4(1.0, 1.0, 1.0, 1.0);
  frg_uv0     = uv0; //*vec2(1,-1);
}
///////////////////////////////////////////////////////////////
fragment_interface iface_fyo : ub_frg {
  inputs {
    vec4 frg_clr;
    vec2 frg_uv0;
  }
  outputs {
    layout(location = 0) vec4 out_clr;
  }
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterSpecularEnvMapSTD : iface_fyo : lib_math : lib_envmapping : lib_brdf : ss_frg : ublk_std_pbr {

  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1)); // Normalize coordinates

  // Assuming 'n' is the normal in world space for the fragment
  vec3 n  = vec3(0, 1, 0); // Define this function based on your application
  vec3 r  = n;
  vec3 v  = r;
  vec3 o  = vec3(0, 0, 0);
  float w = 0;
  for (uint i = 0; i < numsamples; i++) {
    vec2 e = hammersley(i, numsamples);
    // Roughness affects the spread of the texture coordinate sampling
    float perturbScale = roughness * 0.5; // Control the scale of perturbation
    vec2 perturb       = vec2(rand(e) * perturbScale, rand(e.yx) * perturbScale);
    vec2 luv           = fcoord + perturb;
    luv                = clamp(luv, 0, 1); // Ensure UVs are still within bounds

    vec3 sampledColor = textureLod(prefiltmap, luv, 0).rgb;
    float weight      = 1.0 / float(numsamples); // Uniform weight for each sample
    o += sampledColor * weight;
    w += weight;
  }
  //////////////////////////////////
  o       = o / w; // Normalize the output color by the total weight
  out_clr = vec4(o, 1);
  //out_clr = vec4(fcoord,0,1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterSpecularEnvMapEQUI 
 : iface_fyo 
 : lib_math 
 : lib_envmapping 
 : lib_brdf 
 : ss_frg 
 : ublk_std_pbr {

  // Bicubic interpolation weight function

  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1)); // a
  vec3 n  = env_equirectangularUV2Na(fcoord);
  vec3 r  = n;
  vec3 v  = r;
  vec3 o  = vec3(0, 0, 0);
  float w = 0;

  // Check if bicubic upsampling is needed
  vec2 prefiltmapSize = textureSize(prefiltmap, 0);
  bool useBicubic = (prefiltmapSize.x < imgdim.x || prefiltmapSize.y < imgdim.y);

  vec2 blueNoiseOffset = fract(vec2(rand(fcoord), rand(fcoord.yx)) * 1000.0);

  for (uint i = 0; i < numsamples; i++) {
    uint sqrtSamples = uint(sqrt(numsamples));
    uint ix          = i % sqrtSamples;
    uint iy          = i / sqrtSamples;

    // Stratified coordinates with jitter
    vec2 stratifiedPos = vec2(float(ix) + 0.5, float(iy) + 0.5) / float(sqrtSamples);
    vec2 jitter        = vec2(rand(stratifiedPos + blueNoiseOffset), rand(stratifiedPos.yx + blueNoiseOffset)) * 0.9;

    vec2 e = stratifiedPos + jitter * vec2(1.0 / float(sqrtSamples));

    // Modified sampling approach
    vec3 h      = importanceSampleGGXN(e, n, roughness);
    vec3 l      = normalize(2.0 * dot(v, h) * h - v);
    float ndotl = satdot(n, l);

    if (ndotl > 0.0) {
      // FIXED: Fresnel uses V·H angle, not N·L (glTF 2.0 compliant)
      float VdotH = saturateF(dot(v, h));
      float F     = 0.04 + 0.96 * pow(1.0 - VdotH, 5.0);

      // Adjust weight to account for multiple scattering
      float msWeight = mix(1.0, 1.0 / (1.0 - F), roughness * roughness);

      vec2 luv = env_equirectangularN2UVa(l);
      // Allow U to wrap (for ±180° seam), clamp V only (for poles)
      luv.y = clamp(luv.y, 0, 1);
      
      // Use bicubic sampling if input is lower resolution, otherwise use regular sampling
      vec3 sampleColor;
      if (useBicubic) {
        sampleColor = textureBicubic(prefiltmap, luv).rgb;
      } else {
        sampleColor = textureLod(prefiltmap, luv, 0).rgb;
      }
      
      o += sampleColor * ndotl * msWeight;
      w += ndotl * msWeight;
    }
  }
  //////////////////////////////////
  o        = o / w;
  vec2 luv = env_equirectangularN2UVa(n);
  // o = textureLod(prefiltmap, frg_uv0,0).rgb;

  out_clr = vec4(o, 1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterDiffuseEnvMapSTD 
 : iface_fyo 
 : lib_math 
 : lib_envmapping 
 : lib_brdf 
 : ss_frg 
 : ublk_std_pbr {
  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1)); // Normalize coordinates

  // Assuming 'n' is the normal in world space for the fragment
  vec3 n    = vec3(0, 1, 0); // Define this function based on your application
  vec3 r    = n;
  vec3 v    = r;
  vec3 o    = vec3(0, 0, 0);
  float w   = 0;
  float RUF = 1;
  for (uint i = 0; i < numsamples; i++) {
    vec2 e = hammersley(i, numsamples);

    // Roughness affects the spread of the texture coordinate sampling
    float perturbScale = RUF * 0.5; // Control the scale of perturbation
    vec2 perturb       = vec2(rand(e) * perturbScale, rand(e.yx) * perturbScale);
    vec2 luv           = fcoord + perturb;
    luv                = clamp(luv, 0, 1); // Ensure UVs are still within bounds

    vec3 sampledColor = textureLod(prefiltmap, luv, 0).rgb;
    float weight      = 1.0 / float(numsamples); // Uniform weight for each sample
    o += sampledColor * weight;
    w += weight;
  }
  //////////////////////////////////
  o       = o / w; // Normalize the output color by the total weight
  out_clr = vec4(o, 1);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterDiffuseEnvMapEQUI : iface_fyo : lib_math : lib_envmapping : lib_brdf : ss_frg : ublk_std_pbr {
  //////////////////////////////////
  vec3 n     = env_equirectangularUV2N(frg_uv0 * vec2(1, -1));
  n          = n * vec3(-1, -1, 1);
  vec3 up    = vec3(0.0, 0.0, 1.0);
  vec3 right = cross(up, n);
  up         = cross(n, right);
  //////////////////////////////////
  vec3 o     = vec3(0);
  float w    = 0.0;
  float incr = 0.01;
  //////////////////////////////////
  for (uint i = 0; i < numsamples; i++) {
    vec2 e   = hammersley(i, numsamples);
    vec3 h   = importanceSampleGGXN(e, n, 2);
    vec2 luv = env_equirectangularN2UV(normalize(n + h * 2));
    vec2 xuv = env_equirectangularN2UV(normalize(n - h * 2));
    o += textureLod(prefiltmap, luv, 0).rgb;
    o += textureLod(prefiltmap, xuv, 0).rgb;
    w += 2;
  }
  //////////////////////////////////
  o = o / w;

  out_clr = vec4(o, 1);
  //out_clr = textureLod(prefiltmap, frg_uv0,0);
  //out_clr = vec4(1,0,1,1);
}
///////////////////////////////////////////////////////////////
// Accumulation variants — render subsets of samples across multiple passes
///////////////////////////////////////////////////////////////
fragment_shader ps_filterSpecularEnvMapEQUI_accum
 : iface_fyo
 : lib_math
 : lib_envmapping
 : lib_brdf
 : ss_frg
 : ublk_std_pbr {

  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1));
  vec3 n  = env_equirectangularUV2Na(fcoord);
  vec3 r  = n;
  vec3 v  = r;
  vec3 o  = vec3(0, 0, 0);
  float w = 0;

  vec2 prefiltmapSize = textureSize(prefiltmap, 0);
  bool useBicubic = (prefiltmapSize.x < imgdim.x || prefiltmapSize.y < imgdim.y);

  // Use totalsamples for stratification grid, but only iterate numsamples starting at sampleoffset
  uint sqrtTotal = uint(sqrt(float(totalsamples)));
  vec2 blueNoiseOffset = fract(vec2(rand(fcoord), rand(fcoord.yx)) * 1000.0);

  for (uint i = 0; i < numsamples; i++) {
    uint gi = sampleoffset + i;  // global sample index
    uint ix = gi % sqrtTotal;
    uint iy = gi / sqrtTotal;

    vec2 stratifiedPos = vec2(float(ix) + 0.5, float(iy) + 0.5) / float(sqrtTotal);
    vec2 jitter        = vec2(rand(stratifiedPos + blueNoiseOffset), rand(stratifiedPos.yx + blueNoiseOffset)) * 0.9;
    vec2 e = stratifiedPos + jitter * vec2(1.0 / float(sqrtTotal));

    vec3 h      = importanceSampleGGXN(e, n, roughness);
    vec3 l      = normalize(2.0 * dot(v, h) * h - v);
    float ndotl = satdot(n, l);

    if (ndotl > 0.0) {
      float VdotH = saturateF(dot(v, h));
      float F     = 0.04 + 0.96 * pow(1.0 - VdotH, 5.0);
      float msWeight = mix(1.0, 1.0 / (1.0 - F), roughness * roughness);

      vec2 luv = env_equirectangularN2UVa(l);
      luv.y = clamp(luv.y, 0, 1);

      vec3 sampleColor;
      if (useBicubic) {
        sampleColor = textureBicubic(prefiltmap, luv).rgb;
      } else {
        sampleColor = textureLod(prefiltmap, luv, 0).rgb;
      }

      o += sampleColor * ndotl * msWeight;
      w += ndotl * msWeight;
    }
  }
  // Output weighted sum (NOT normalized) — Python will sum passes and divide by total weight
  out_clr = vec4(o, w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterSpecularEnvMapSTD_accum : iface_fyo : lib_math : lib_envmapping : lib_brdf : ss_frg : ublk_std_pbr {

  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1));
  vec3 n  = vec3(0, 1, 0);
  vec3 r  = n;
  vec3 v  = r;
  vec3 o  = vec3(0, 0, 0);
  float w = 0;
  for (uint i = 0; i < numsamples; i++) {
    uint gi = sampleoffset + i;
    vec2 e = hammersley(gi, totalsamples);
    float perturbScale = roughness * 0.5;
    vec2 perturb       = vec2(rand(e) * perturbScale, rand(e.yx) * perturbScale);
    vec2 luv           = fcoord + perturb;
    luv                = clamp(luv, 0, 1);
    vec3 sampledColor = textureLod(prefiltmap, luv, 0).rgb;
    float weight      = 1.0;
    o += sampledColor * weight;
    w += weight;
  }
  out_clr = vec4(o, w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterDiffuseEnvMapEQUI_accum : iface_fyo : lib_math : lib_envmapping : lib_brdf : ss_frg : ublk_std_pbr {
  vec3 n     = env_equirectangularUV2N(frg_uv0 * vec2(1, -1));
  n          = n * vec3(-1, -1, 1);
  vec3 up    = vec3(0.0, 0.0, 1.0);
  vec3 right = cross(up, n);
  up         = cross(n, right);
  vec3 o     = vec3(0);
  float w    = 0.0;
  for (uint i = 0; i < numsamples; i++) {
    uint gi  = sampleoffset + i;
    vec2 e   = hammersley(gi, totalsamples);
    vec3 h   = importanceSampleGGXN(e, n, 2);
    vec2 luv = env_equirectangularN2UV(normalize(n + h * 2));
    vec2 xuv = env_equirectangularN2UV(normalize(n - h * 2));
    o += textureLod(prefiltmap, luv, 0).rgb;
    o += textureLod(prefiltmap, xuv, 0).rgb;
    w += 2;
  }
  out_clr = vec4(o, w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_filterDiffuseEnvMapSTD_accum : iface_fyo : lib_math : lib_envmapping : lib_brdf : ss_frg : ublk_std_pbr {
  vec2 fcoord = gl_FragCoord.xy;
  fcoord *= vec2(1.0 / (imgdim.x - 1), 1.0 / (imgdim.y - 1));
  vec3 n    = vec3(0, 1, 0);
  vec3 r    = n;
  vec3 v    = r;
  vec3 o    = vec3(0, 0, 0);
  float w   = 0;
  float RUF = 1;
  for (uint i = 0; i < numsamples; i++) {
    uint gi = sampleoffset + i;
    vec2 e = hammersley(gi, totalsamples);
    float perturbScale = RUF * 0.5;
    vec2 perturb       = vec2(rand(e) * perturbScale, rand(e.yx) * perturbScale);
    vec2 luv           = fcoord + perturb;
    luv                = clamp(luv, 0, 1);
    vec3 sampledColor = textureLod(prefiltmap, luv, 0).rgb;
    float weight      = 1.0;
    o += sampledColor * weight;
    w += weight;
  }
  out_clr = vec4(o, w);
}
///////////////////////////////////////////////////////////////
technique tek_filterSpecularMapEquirectangular_accum {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterSpecularEnvMapEQUI_accum;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterSpecularMapStandard_accum {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterSpecularEnvMapSTD_accum;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterDiffuseMapEquirectangular_accum {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterDiffuseEnvMapEQUI_accum;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterDiffuseMapStandard_accum {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterDiffuseEnvMapSTD_accum;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
state_block sb_filter : default {
  DepthTest = OFF;
  CullTest  = OFF;
}
///////////////////////////////////////////////////////////////
technique tek_filterSpecularMapStandard {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterSpecularEnvMapSTD;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterDiffuseMapStandard {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterDiffuseEnvMapSTD;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterSpecularMapEquirectangular {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_yo;
    fragment_shader = ps_filterSpecularEnvMapEQUI;
    state_block     = sb_filter;
  }
}
///////////////////////////////////////////////////////////////
technique tek_filterDiffuseMapEquirectangular {
  fxconfig = fxcfg_default;
  vf_pass = { vs_yo, ps_filterDiffuseEnvMapEQUI, sb_filter }
}
///////////////////////////////////////////////////////////////
