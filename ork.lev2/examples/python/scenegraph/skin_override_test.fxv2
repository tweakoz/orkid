///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  import "orkshader://pbrtools.i2";
  import "orkshader://misctools.i2";
}
///////////////////////////////////////////////////////////////
// FORWARD SKINNED RENDERING
///////////////////////////////////////////////////////////////
// Vertex interface for forward skinned - uses vif_FWDTEST_SKINNED
vertex_interface VIF_FWD : vif_FWDTEST_SKINNED {
}
///////////////////////////////////////////////////////////////
vertex_shader VS_FWD : VIF_FWD : lib_skin_tools : lib_pbr_vtx : ublk_std_matrices {
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec3 skn_nrm = SkinNormal(normal);
  vec3 skn_bit = SkinNormal(binormal); // technically binormal is a bitangent
  vs_common(skn_pos, skn_nrm, skn_bit);
  gl_Position = mvp * skn_pos;
  frg_uv0     = uv0 * vec2(1, -1);
  frg_clr     = vec4(skn_pos.xyz, 1); // pass position for noise
  frg_modcolor = vec4(1,1,1,1);
}
///////////////////////////////////////////////////////////////
fragment_shader FS_FWD
  : fif_FWDTEST
  : lib_math
  : lib_brdf
  : lib_def
  : lib_fwd
  : lib_cellnoise
  : std_forward_all {
  vec3 POS = frg_clr.xyz;
  float noise = cellnoise(POS*40.1);
  noise *= cellnoise(POS*37.7);
  noise *= cellnoise(POS*47.7);
  noise *= cellnoise(POS*54.7);
  noise = pow(noise, 0.02);
  vec3 lit = forward_lighting_mono(frg_clr.xyz * ModColor.xyz);
  out_color = vec4(lit * noise, 1);
}
///////////////////////////////////////////////////////////////
technique FWD_CT_NM_SK_NI_MO {
  fxconfig=fxcfg_default;
  vf_pass={VS_FWD,FS_FWD,sb_default}
}
///////////////////////////////////////////////////////////////
// DEFERRED/GBUFFER SKINNED RENDERING
///////////////////////////////////////////////////////////////
vertex_interface VIF_GBU : vif_PNBT_skinned {
  outputs {
    vec4 frg_clr;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader VS_GBU : VIF_GBU : lib_skin_tools : lib_pbr_vtx : ublk_std_matrices {
  vec4 skn_pos = vec4(SkinPosition(position.xyz), 1);
  vec3 skn_nrm = SkinNormal(normal);
  vec3 skn_bit = SkinNormal(binormal); // technically binormal is a bitangent
  vs_common(skn_pos, skn_nrm, skn_bit);
  frg_uv0     = uv0 * vec2(1, -1);
  frg_clr = vec4(skn_pos.xyz, 1);
  gl_Position = mvp * skn_pos;
}
///////////////////////////////////////////////////////////////
fragment_shader FS_GBU
  : iface_fgbuffer
  : lib_gbuf_encode
  : lib_pbr_frg
  : lib_cellnoise
  : ublk_std_pbr {
  vec3 TN        = texture(CNMREA, vec3(frg_uv0, 1)).xyz;
  TN            = mix(TN, vec3(0.5, 1, 0.5), 0.0);
  vec3 N        = normalize(TN * 2.0 - vec3(1, 1, 1));
  vec3 normal    = normalize(frg_tbn * N);
  vec3 rufmtlamb = texture(CNMREA, vec3(frg_uv0, 2)).xyz;
  float mtl      = rufmtlamb.z * MetallicFactor;
  float ruf      = rufmtlamb.y * RoughnessFactor;
  vec3 POS = frg_clr.xyz;
  float noise = cellnoise(POS*40.1);
  noise *= cellnoise(POS*37.7);
  noise *= cellnoise(POS*47.7);
  noise *= cellnoise(POS*54.7);
  noise = pow(noise, 0.02);
  vec3 color_tex = texture(CNMREA, vec3(frg_uv0,0)).xyz;
  vec3 color = (ModColor.xyz * color_tex).xyz * noise;
  out_gbuf   = packGbuffer(color, vec3(0), normal, ruf, mtl);
}
///////////////////////////////////////////////////////////////
technique GBU_CT_NM_SK_NI_MO {
  fxconfig=fxcfg_default;
  vf_pass={VS_GBU,FS_GBU,sb_default}
}
