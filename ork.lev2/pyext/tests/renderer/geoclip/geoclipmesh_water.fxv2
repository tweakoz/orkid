///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "450";
  import "orkshader://mathtools.i2";
  import "orkshader://pbrtools.i2";
  import "orkshader://envtools.i2";
  import "orkshader://misctools.i2";
  import "orkshader://stdtools.i2";
}
///////////////////////////////////////////////////////////////

uniform_block ub_frgX (descriptor_set 0) {
  float Time;
  float GroundColorPower;
  float plightamp;
  float BaseQuadSize; // for ClipMap seam removal
  vec3 BaseColor;
  float pad;
  vec2 bufinvdim;
}

sampler_set sset_water (descriptor_set 0) {
  sampler2D depth_map;
}

///////////////////////////////////////////////////////////////
typeblock typ_water {
  struct x_pos {
    vec4 true_wpos;
    vec4 new_pos;
    vec3 signal;
    float radius;
  };
}
///////////////////////////////////////////////////////////////
libblock lib_ground_vtx_base : ub_frgX : ublk_std_matrices : lib_mmnoise : typ_water {

  float radial_sinwave_fn(vec3 center, vec3 pos, float timeval, float frq, float baseamp, float rscale, float falloff) {
    frq          = frq * 0.00033;
    float radius = length(pos.xz - center.xz);
    float amp    = clamp(pow(1 / radius, falloff), 0, 1);
    amp *= clamp(radius * rscale, 0, 1);
    return sin(radius * frq - timeval) * baseamp * amp;
  }

  // Y-only gerstner contribution. Single source of truth for both the VS
  // displacement and the FS analytic normal (which finite-differences
  // get_wave_y below). Height-field approximation: ignores the
  // dir*sin(phase) horizontal sway from the original gerstner vec3
  // formulation — visually dropping the sway costs a tiny amount of
  // lateral particle motion that's invisible at typical viewing distance.
  float radial_gerstner_y(vec3 center, vec3 pos, float timeval, float frq, float baseamp, float rscale, float falloff) {
    float radius = length(pos.xz - center.xz);
    float amp    = clamp(pow(1 / radius, falloff), 0, 1);
    amp *= clamp(radius * rscale, 0, 1);
    float phase  = radius * frq - timeval;
    return -cos(phase) * baseamp * amp;
  }

  // Pure height-field query of the water surface at a given world XZ.
  // Single source of truth — called from both vs_compute_position (for
  // geometry displacement) and ps_fwd_ground_mono (for per-pixel analytic
  // normals via finite differencing).
  float get_wave_y(vec3 wpos) {
    float speed   = Time * 1.65;
    float baseamp = 32;
    float cdist   = 3000.0;
    float falloff = 0.09;

    float y_sum = 0.0;
    y_sum += radial_gerstner_y(vec3(-6, 0, -32) * cdist, wpos, speed * 0.9, 0.003131, baseamp * 0.3, 0.00013, falloff);
    y_sum += radial_gerstner_y(vec3( 6, 0,   5) * cdist, wpos, speed * 2.1, 0.0131,   baseamp * 0.3, 0.00013, falloff);
    y_sum += radial_gerstner_y(vec3(11, 0,  -6) * cdist, wpos, speed * 0.6, 0.0091,   baseamp * 0.3, 0.00013, falloff);
    y_sum += radial_gerstner_y(vec3(-11,0,   6) * cdist, wpos, speed * 0.3, 0.00111,  baseamp * 0.5, 0.00013, falloff);

    // Noise octaves with per-octave domain rotation for chaos. Each octave
    // samples along a different XZ axis, preventing the noise layers from
    // stacking into a preferred direction. Geometric frequency progression
    // (1.7x per octave) widens the scale range vs. arithmetic.
    // Noise is zero-centered so new octaves add variance without DC drift.
    //
    // 8 octaves covering wavelengths from ~1250m (big swells) down to ~31m
    // (fine ripples). Per-octave parameterization:
    //
    //   amp        — contribution strength; decays 1/(i+1) so fine detail
    //                adds texture without drowning out larger waves.
    //   frq        — spatial frequency; geometric (×1.7/octave).
    //   spd        — noise 3rd-axis time evolution rate. Grows faster now
    //                (5.0 + 1.1*i) so high-freq octaves churn energetically
    //                instead of just scrolling.
    //   drift_mul  — per-octave scale on the base drift. Higher octaves
    //                drift less (1/(1+0.35*i)) — fine ripples should look
    //                chaotic-in-place rather than wind-blown, while coarse
    //                octaves retain the wind drift that gives the overall
    //                pattern directional motion.
    //   drift_base — base drift rate in NOISE-DOMAIN units per second.
    //                Uniform units → same visual cadence across octaves.
    // 4 octaves targeting the med-to-fine wavelength band (~30m to ~300m)
    // that the long-wavelength gerstner swells above don't cover.
    //
    //   octave 0: 0.020 frq → ~314m wavelength (medium chop)
    //   octave 1: 0.042 frq → ~150m
    //   octave 2: 0.088 frq → ~71m
    //   octave 3: 0.185 frq → ~34m   (finest — still >16× eps=2.0, no alias)
    //
    // The 2.1× geometric step is steeper than before (was 1.7×) because
    // with only 4 octaves we need to span a wider range. Amplitudes are
    // the standard 1/(i+1) fBm-ish decay. Speed and drift_mul reshaped so
    // fine octaves churn harder but scroll less — chaotic in place rather
    // than wind-blown, while the coarsest octave still drifts nearly full.
    const float drift_base = 0.08;
    for (int i = 0; i < 4; i++) {
      float fi        = float(i);
      float amp       = 0.25 / (fi + 1.0);
      float frq       = 0.02  * pow(2.1, fi);
      float spd       = 1.0   + fi * 1.8;
      float drift_mul = 1.0 / (1.0 + fi * 0.55);
      float ang       = fi * 1.37;   // ~78° non-orthogonal rotation
      float c         = cos(ang);
      float s         = sin(ang);
      vec2  rot_xz    = vec2(c * wpos.x - s * wpos.z,
                             s * wpos.x + c * wpos.z);
      vec2  sample_xz = rot_xz * frq - vec2(c, s) * (Time * drift_base * drift_mul);
      float n         = noise(vec3(sample_xz, Time * spd)) - 0.5;
      y_sum += n * amp;
    }
    return y_sum;
  }

  x_pos vs_compute_position(vec3 pos) {
    x_pos _x;
    mat4 matO2W  = m;
    _x.true_wpos = matO2W * vec4(pos, 1);

    vec3 wave_pos = _x.true_wpos.xyz;
    float radius  = length(wave_pos.xz);

    // Height-field only: the single source of truth for the water
    // surface is get_wave_y(), which the fragment shader also queries
    // to build its analytic per-pixel normal. Horizontal gerstner sway
    // is dropped — see radial_gerstner_y's comment.
    vec3 disp = vec3(0.0, get_wave_y(wave_pos), 0.0);

    vec3 displaced = pos + disp;

    _x.signal  = disp;
    _x.new_pos = vec4(displaced, 1);
    _x.radius  = radius;
    return _x;
  }
}
///////////////////////////////////////////////////////////////
libblock lib_ground_vtx : ub_frgX : ublk_std_matrices : lib_ground_vtx_base {

  vec4 vs_common_mono(vec4 pos, vec3 nrm, vec2 uv) {
    x_pos _x = vs_compute_position(pos.xyz);

    // frg_wpos must be in WORLD space — vs_compute_position returns
    // new_pos in local/hybrid space (local XZ + wave Y), which mvp later
    // transforms correctly for gl_Position, but the FS reads frg_wpos
    // directly and expects world coordinates (for wave-function sampling
    // in the analytic normal, eye_delta / fog, skybox reflection, etc.).
    // Multiply by m here so FS math is in the right space.
    frg_wpos     = m * _x.new_pos;
    frg_tbn[0]   = _x.true_wpos.xyz;
    frg_uv0      = uv * vec2(1, -1);
    frg_camz     = _x.signal;
    frg_camdist  = 1;
    frg_clr      = vec4(1);
    frg_modcolor = vec4(1);
    return _x.new_pos;
  }
}

///////////////////////////////////////////////////////////////
// Clipmap uses SVtxV12N12T16 (position + normal + vec4 uv0, no binormal).
// Custom interface matches that layout; outputs mirror vif_PNBT so the
// fragment shader can read frg_wpos / frg_tbn / frg_uv0 / etc as usual.
///////////////////////////////////////////////////////////////
vertex_interface vif_PNt4 : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal   : NORMAL;
    vec4 uv0      : TEXCOORD0;
  }
  outputs {
    vec4  frg_wpos;
    vec4  frg_clr;
    vec2  frg_uv0;
    mat3  frg_tbn;
    float frg_camdist;
    vec3  frg_camz;
    vec4  frg_modcolor;
  }
}
vertex_shader vs_ground_mono
    : vif_PNt4
    : ublk_std_matrices
    : lib_ground_vtx {

  // LOD-seam elimination via vertex morphing.
  //
  // Each vertex is tagged with its ring level L (baked into uv0.z by
  // geoclipmap::Generator::generateClipmaps). As a vertex approaches the
  // outer edge of its ring, it morphs toward the coarse-grid position it
  // would occupy at level L+1 — so at the exact ring boundary, a fine
  // vertex lands on top of a coarse vertex. No T-junctions, no seams.
  //
  // Ring geometry facts (from generateRing):
  //   quad_size(L) = BaseQuadSize * 2^L
  //   outer extent = 64 * quad_size(L)   (DIM=128, DIMD2=64)
  //   inner hole    = 32 * quad_size(L)
  //   level L outer boundary == level L+1 inner boundary == 64*BQS*2^L
  float lod_level    = uv0.z;
  float quad_size    = BaseQuadSize * exp2(lod_level);
  float outer_extent = 64.0 * quad_size;
  float trans_band   = 8.0  * quad_size;   // morph band width; tune 4..16
  float max_dist     = max(abs(position.x), abs(position.z));
  float morph_w      = clamp((max_dist - (outer_extent - trans_band)) / trans_band, 0.0, 1.0);
  float snap_size    = quad_size * 2.0;    // next-coarser level's cell
  vec2  snapped_xz   = floor(position.xz / snap_size + 0.5) * snap_size;
  vec2  morphed_xz   = mix(position.xz, snapped_xz, morph_w);
  vec4  morphed_pos  = vec4(morphed_xz.x, position.y, morphed_xz.y, position.w);

  vec4 new_pos = vs_common_mono(morphed_pos, normal, uv0.xy);
  gl_Position  = mvp * new_pos;
}
///////////////////////////////////////////////////////////////
// Depth prepass VS also needs uv0 so it can apply the SAME LOD-morph
// as the color pass. If the prepass drew unmorphed positions and the
// color pass drew morphed ones, the depth test at each pixel would
// either hole out or Z-fight. They must agree per-vertex.
///////////////////////////////////////////////////////////////
vertex_interface iface_my_vdprepass : ublk_std_matrices {
  inputs {
    vec4 position : POSITION;
    vec4 uv0      : TEXCOORD0;
  }
  outputs {
    float frg_depth;
  }
}
///////////////////////////////////////////////////////////////
vertex_shader vs_my_forward_depthprepass_mono
    : iface_my_vdprepass
    : lib_ground_vtx_base {

  // LOD-morph: mirror of vs_ground_mono's block — must match exactly.
  float lod_level    = uv0.z;
  float quad_size    = BaseQuadSize * exp2(lod_level);
  float outer_extent = 64.0 * quad_size;
  float trans_band   = 8.0  * quad_size;
  float max_dist     = max(abs(position.x), abs(position.z));
  float morph_w      = clamp((max_dist - (outer_extent - trans_band)) / trans_band, 0.0, 1.0);
  float snap_size    = quad_size * 2.0;
  vec2  snapped_xz   = floor(position.xz / snap_size + 0.5) * snap_size;
  vec2  morphed_xz   = mix(position.xz, snapped_xz, morph_w);
  vec3  morphed_pos  = vec3(morphed_xz.x, position.y, morphed_xz.y);

  x_pos _x = vs_compute_position(morphed_pos);

  vec4 new_pos = _x.new_pos;
  vec4 hpos    = mvp * new_pos;
  gl_Position  = hpos;
  frg_depth    = (hpos.z) / (hpos.w - 0.05);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fwd_ground_mono
    : iface_forward
    : lib_math
    : lib_brdf
    : lib_def
    : lib_fwd
    : lib_fwd_impl
    : lib_mmnoise
    : lib_ground_vtx_base
    : ub_frgX
    : sset_water
    : storage_fwd_lighting
    : std_forward_all {

  vec3 wpos = frg_tbn[0];

  float signalY  = frg_camz.y * 0.01;
  signalY        = pow(signalY, 2);
  float peak_mix = clamp(signalY * 10.0, 0, 1);

  float foam = 0.0;
  for (int i = 0; i < 4; i++) {
    float amp    = 2.0 / (4 - i);
    float frq    = 3 + i * 1.007;
    float spd    = 3.1 + i * 1.1;
    float n      = noise(wpos.xyz * frq + vec3(0, 1, 0) * Time * spd);
    float scalar = pow(peak_mix * 5.0, 2.5);
    foam += n * amp * scalar;
  }
  foam = clamp(foam * 10, 0, 1);

  vec2 uv     = gl_FragCoord.xy * bufinvdim;
  float depth = textureLod(depth_map, uv, 0).r;
  float ndc_z = depth * 2.0 - 1.0;
  float ndc_x = (uv.x * 2.0 - 1.0);
  float ndc_y = (uv.y * 2.0 - 1.0);
  vec4 clip   = vec4(ndc_x, ndc_y, ndc_z, 1.0);
  vec4 wld    = inv_vp * clip;
  wld /= wld.w;
  float D = clamp(length(wpos.xyz - wld.xyz) * 0.01, 0, 1);
  D       = pow(D, 0.1125);

  // Per-pixel analytic surface normal from the wave height field.
  // Replaces dFdx/dFdy on frg_wpos which produced a single flat normal
  // per triangle (the faceted look) — this gives pixel-rate smooth
  // specular because the wave function is sampled at the fragment's
  // actual world position plus small offsets, not averaged over the tri.
  // eps is in world meters; tune to the finest wave feature we care
  // about. Too small → noise amplifies, too large → details lost.
  float eps   = 2.0;
  float h0    = get_wave_y(frg_wpos.xyz);
  float hx    = get_wave_y(frg_wpos.xyz + vec3(eps, 0.0, 0.0));
  float hz    = get_wave_y(frg_wpos.xyz + vec3(0.0, 0.0, eps));
  vec3  dx    = vec3(eps, hx - h0, 0.0);
  vec3  dz    = vec3(0.0, hz - h0, eps);
  vec3 normal = normalize(cross(dz, dx));

  vec3 eye_delta   = frg_wpos.xyz - EyePostion;
  vec3 eye_dir     = normalize(eye_delta);
  vec3 skybox_n    = vec3(eye_dir.x, eye_dir.y, eye_dir.z) * -1;
  vec3 skyboxColor = env_equirectangular_skybox(skybox_n, MapSpecularEnv, EnvironmentMipBias) * SkyboxLevel;

  float fogZ   = length(eye_delta);
  float radius = 0.0;

  float depth_fogval      = 1.0 - clamp(pow(fogZ / DepthFogDistance, DepthFogPower), 0, 1);
  vec3 skybox_refract_n   = reflect(skybox_n * -1.0, normal * -1.0);
  vec3 skyboxRefractColor = (vec3(1) - env_equirectangular_skybox(skybox_refract_n, MapSpecularEnv, 0.8)) * 1.5;
  skyboxRefractColor.x    = pow(skyboxRefractColor.x, 0.65);
  skyboxRefractColor.y    = pow(skyboxRefractColor.y, 0.55);
  skyboxRefractColor.z    = pow(skyboxRefractColor.z, 0.45);
  float F                 = fresnelSchlick(eye_dir * -1.0, normal, vec3(0.004)).x;
  //F                       = 0.5;
  vec3 albedo             = BaseColor;

  PbrData pbd;
  pbd._emissive = false;
  pbd._metallic = 0.05;

  float ssy      = clamp(signalY, 0, 1);
  pbd._roughness = 0.25;
  pbd._albedo    = albedo;
  pbd._wpos      = frg_tbn[0].xyz;
  pbd._wnrm      = normal;
  pbd._fogZ      = 0.0;
  pbd._atmos     = 0.0;
  pbd._alpha     = 1.0;

  vec3 env_lighting = pbrEnvironmentLightingXXX(pbd, EyePostion);

  LightCtx plc        = lcalc_forward(wpos.xyz, pbd, EyePostion);
  vec3 point_lighting = vec3(0, 0, 0);
  for (int i = 0; i < point_light_count; i++) {
    plc._lightdel = _lightpos[i].xyz - wpos.xyz;
    vec3 LC       = _lightcolor[i].xyz * _lightcolor[i].w;
    vec4 LSB      = _lightsizbias[i];
    float LR      = LSB.x;
    point_lighting += plcalc_forward(plc, pbd, LR) * LC * plightamp;
  }

  vec3 spot_lighting  = vec3(0, 0, 0);
  float shadow_factor = 0.0;

  for (int i = 0; i < spot_light_count; i++) {
    int j = i + point_light_count;

    int LCI_STD = i * 2 + 0;
    int LCI_DEP = i * 2 + 1;

    vec4 LSB = _lightsizbias[j];

    mat4 shmtx           = _shadowmatrix[j];
    vec3 lightpos        = _lightpos[j].xyz;
    float lightrange     = LSB.x;
    vec4 light_hpos      = (shmtx)*vec4(wpos, 1);
    vec3 light_ndc       = (light_hpos.xyz / light_hpos.w);
    float lightz         = light_ndc.z;
    vec2 diffuse_lightuv = light_ndc.xy * 0.5 + vec2(0.5);

    bool mask = bool(light_ndc.x >= -1 && light_ndc.x < 1) && bool(light_ndc.y >= -1 && light_ndc.y < 1) &&
                bool(light_ndc.z >= 0.0 && light_ndc.z <= 1);

    vec3 viewDir = normalize(EyePostion - wpos);
    vec3 reflectDir = reflect(-viewDir, normal);
    vec3 nearPlanePos = lightpos - reflectDir * 3.0;
    vec4 nearPlaneClip = (shmtx)*vec4(nearPlanePos, 1.0);
    vec3 nearPlaneNDC = nearPlaneClip.xyz / nearPlaneClip.w;
    vec2 specular_lightuv = nearPlaneNDC.xy * 0.5 + vec2(0.5);
    bool within_frustum = nearPlaneNDC.x >= -1 && nearPlaneNDC.x < 1 && nearPlaneNDC.y >= -1 && nearPlaneNDC.y < 1;
    bool specular_mask = within_frustum;

    vec3 lightdel = lightpos - wpos;
    plc._lightdel = lightdel;
    vec3 LC       = _lightcolor[i].xyz * _lightcolor[i].w;
    float LR      = 50;
    vec3 pl_c     = plcalc_forward(plc, pbd, LR) * LC;
    pl_c          = mix(pl_c, vec3(1), 0.25);

    uint light_tex_slice = _lightTexSlice[i];

    vec4 shadow_hpos = (shmtx)*vec4(wpos, 1);
    vec3 shadow_ndc  = (shadow_hpos.xyz / shadow_hpos.w);
    vec2 shadow_uv   = shadow_ndc.xy * 0.5 + vec2(0.5);
    bool shadow_mask = shadow_ndc.x >= -1 && shadow_ndc.x < 1 && shadow_ndc.y >= -1 && shadow_ndc.y < 1;
    if (!shadow_mask) {
      shadow_factor = 1.0;
    } else {
      float bias             = LSB.y;
      float far              = lightrange;
      float near             = lightrange * 0.001;
      float shadow_depth_ndc = _sample_depth_cookie(light_tex_slice, shadow_uv) * 2.0 - 1.0;

      int pcf_width         = 1;
      float pcf_filter_size = 1.0 / LSB.z;

      for (int x = -pcf_width; x <= pcf_width; x++) {
        for (int y = -pcf_width; y <= pcf_width; y++) {
          vec2 pcf_uv     = shadow_uv + vec2(x, y) * pcf_filter_size;
          float pcf_depth = _sample_depth_cookie(light_tex_slice, pcf_uv) * 2.0 - 1.0;
          shadow_factor += (pcf_depth + bias) >= lightz ? 1.0 : 0.0;
        }
      }

      shadow_factor /= float((pcf_width * 2 + 1) * (pcf_width * 2 + 1));
    }

    vec3 lightcol          = _lightcolor[j].xyz;
    float level            = pbd._roughness * 4;
    vec3 diffuse_lighttex  = textureLod(light_cookie_colors, vec3(diffuse_lightuv, light_tex_slice), 0).xyz;
    vec3 specular_lighttex = vec3(0);

    diffuse_lighttex *= plc._F0 * pl_c;

    vec3 LN     = normalize(lightdel);
    float Ldist = length(lightdel);
    float NdotL = max(0.0, dot(normal, LN));

    float spec_mix = 1.0 - pow(pbd._roughness, 1.0);
    vec3 diffuse   = pbd._albedo * diffuse_lighttex * NdotL;
    vec3 lighttex  = diffuse * 0;
    lighttex += pbd._albedo * specular_lighttex * NdotL;
    spot_lighting += lightcol * diffuse_lighttex / pow(Ldist, 2) * float(mask) * shadow_factor;
    spot_lighting += vec3(reflectDir) * 0.03 * float(mask) * shadow_factor;
  }

  vec3 L  = env_lighting + point_lighting + spot_lighting;
  vec3 OC = L;
  OC += env_lighting * foam * 0.1;
  D = 1.0;
  out_color = vec4(OC, D);
}
///////////////////////////////////////////////////////////////
technique FWD_DEPTHPREPASS_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_my_forward_depthprepass_mono;
    fragment_shader = ps_forward_depthprepass_mono;
    state_block = sb_default;
  }
}
///////////////////////////////////////////////////////////////
state_block X : default {
  BlendMode = ALPHA;
}
///////////////////////////////////////////////////////////////
technique FWD_CT_NM_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_ground_mono;
    fragment_shader = ps_fwd_ground_mono;
    state_block = X;
  }
}
