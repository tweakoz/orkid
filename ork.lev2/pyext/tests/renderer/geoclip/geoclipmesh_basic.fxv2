///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "450";
  import "orkshader://pbrtools.i2";
  import "orkshader://misctools.i2";
}
///////////////////////////////////////////////////////////////
state_block sb_geoclipmesh : sb_default {
  CullTest = OFF;
  BlendMode = ALPHA;
}

uniform_block ub_terrain (descriptor_set 0) {
  float terrainFadeNear;
  float terrainFadeFar;
  float BaseQuadSize;
}
///////////////////////////////////////////////////////////////
// Vertex interface for geoclipmesh (V12N12T16 format)
// No binormal in this format - UV is vec4
///////////////////////////////////////////////////////////////
vertex_interface vif_geoclipmesh {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec4 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_wpos;
    vec4 frg_clr;
    vec2 frg_uv0;
    mat3 frg_tbn;
    float frg_camdist;
    vec3 frg_camz;
    vec4 frg_modcolor;
  }
}
///////////////////////////////////////////////////////////////
// Depth prepass vertex interface (V12N12T16 format)
///////////////////////////////////////////////////////////////
vertex_interface vif_geoclipmesh_dpp {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec4 uv0 : TEXCOORD0;
  }
  outputs {
    float frg_depth;
  }
}
///////////////////////////////////////////////////////////////
// Fragment interface - matches fif_FWDTEST pattern
///////////////////////////////////////////////////////////////
fragment_interface fif_geoclipmesh
  : vif_geoclipmesh {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
typeblock typ_geoclipmesh_basic {
  struct x_pos {
    vec4 true_wpos;
    vec4 new_pos;
    vec3 signal;
    float radius;
  };
}
///////////////////////////////////////////////////////////////
libblock lib_ground_vtx_base
 : lib_mmnoise
 : typ_geoclipmesh_basic {

  float terrain_height(vec2 xz) {
    float mtn_wave = sin(xz.x * 0.005 + 0.3)
                   * cos(xz.y * 0.005 * 0.8 + 0.7)
                   + sin(xz.x * 0.005 * 1.3 - xz.y * 0.005 * 0.4) * 0.5;
    float large_wave = sin(xz.x * 0.015)
                     * cos(xz.y * 0.015 * 0.7)
                     + cos(xz.x * 0.015 * 0.6 + xz.y * 0.015) * 0.6;
    float med_wave = sin(xz.x * 0.04 + xz.y * 0.04 * 0.5)
                   * cos(xz.y * 0.04 * 1.3);
    float small_wave = sin(xz.x * 0.12 * 1.1)
                     * sin(xz.y * 0.12 * 0.9);
    float fine_wave = sin(xz.x * 0.3 * 1.2 + xz.y * 0.3 * 0.7)
                    * cos(xz.y * 0.3 * 1.1);
    return mtn_wave * 80.0
         + large_wave * 30.0
         + med_wave * 12.0
         + small_wave * 4.0
         + fine_wave * 1.5;
  }

  x_pos vs_compute_position(vec3 pos) {
    x_pos _x;
    _x.true_wpos = m * vec4(pos, 1);
    vec3 wave_pos = _x.true_wpos.xyz;
    float radius  = length(wave_pos.xz);
    float displacement = terrain_height(wave_pos.xz);
    wave_pos.y += displacement;
    _x.signal  = vec3(displacement, 0, 0);
    _x.new_pos = vec4(wave_pos, 1);
    _x.radius  = radius;
    return _x;
  }
}
///////////////////////////////////////////////////////////////
libblock lib_ground_vtx : lib_ground_vtx_base {

  vec4 vs_common_mono(vec4 pos, vec3 nrm) {
    x_pos _x = vs_compute_position(pos.xyz);

    // _x.new_pos is now in WORLD space
    // Use v (view matrix) to go from world to view space
    vec4 cpos       = v * _x.new_pos;
    vec3 wnormal    = normalize(mrot * nrm);
    // No binormal in V12N12T16 format - construct tangent from normal
    vec3 wtangent   = normalize(cross(wnormal, vec3(0, 1, 0)));
    vec3 wbitangent = cross(wnormal, wtangent);

    // _x.new_pos is already in world space
    frg_wpos    = _x.new_pos;
    frg_tbn     = mat3(wtangent, wbitangent, wnormal);
    frg_camz    = wnormal.xyz;
    frg_camdist = -cpos.z;

    frg_uv0 = uv0.xy * vec2(1, -1);
    frg_clr = vec4(1, 1, 1, 1);
    frg_modcolor = vec4(1, 1, 1, 1);

    return _x.new_pos;
  }
}

///////////////////////////////////////////////////////////////
vertex_shader vs_ground_mono
    : vif_geoclipmesh
    : ublk_std_matrices
    : ub_terrain
    : lib_ground_vtx {
  vec4 new_pos = vs_common_mono(position, normal);
  gl_Position  = vp * new_pos;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_forward_depthprepass_mono
    : vif_geoclipmesh_dpp
    : ublk_std_matrices
    : ub_terrain
    : lib_ground_vtx_base {
  x_pos _x = vs_compute_position(position.xyz);
  vec4 hpos    = vp * _x.new_pos;
  gl_Position  = hpos;
  frg_depth    = (hpos.z) / (hpos.w);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fwd_ground_mono
    : fif_geoclipmesh
    : lib_math
    : lib_brdf
    //: lib_def
    : lib_fwd
    : std_forward_all
    : ub_frg_fwd
    : ss_frg_fwd
    : storage_fwd_lighting
    : ub_terrain {

  // World-space tile grid with analytical antialiasing
  float tile_size = 10.0;
  float line_width = 0.05;
  vec2 wpos_xz = frg_wpos.xz;
  vec2 tile_pos = mod(wpos_xz, tile_size);
  vec2 fw = fwidth(wpos_xz);
  vec2 dist_to_line = min(tile_pos, tile_size - tile_pos);
  vec2 aa_grid = 1.0 - smoothstep(line_width - fw, line_width + fw, dist_to_line);
  float grid = clamp(aa_grid.x + aa_grid.y, 0.0, 1.0);

  // Checkerboard pattern with AA at tile edges
  vec2 tile_id = floor(wpos_xz / tile_size);
  float checker = mod(tile_id.x + tile_id.y, 2.0);

  // Base color from lighting with checkerboard tint
  vec3 lit_color = forward_lighting_mono(frg_clr.xyz * ModColor.xyz);
  vec3 tile_color = mix(lit_color * 0.8, lit_color * 1.0, checker);

  // Grid lines in dark color
  vec3 grid_color = vec3(0.1, 0.1, 0.1);
  vec3 final_color = mix(tile_color, grid_color, grid);

  float fade_alpha = 1.0 - smoothstep(terrainFadeNear, terrainFadeFar, frg_camdist);
  if (fade_alpha <= 0.001) discard;
  out_color = vec4(final_color, fade_alpha);
}
///////////////////////////////////////////////////////////////
technique FWD_DEPTHPREPASS_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_forward_depthprepass_mono;
    fragment_shader = ps_forward_depthprepass_mono;
    state_block = sb_dpp;
  }
}
///////////////////////////////////////////////////////////////
technique FWD_CT_NM_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_ground_mono;
    fragment_shader = ps_fwd_ground_mono;
    state_block = sb_geoclipmesh;
  }
}
