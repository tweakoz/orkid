///////////////////////////////////////////////////////////////
// FxConfigs
///////////////////////////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "450";
  import "orkshader://mathtools.i2";
  import "orkshader://pbrtools.i2";
}
///////////////////////////////////////////////////////////////

uniform_block ub_frgX (descriptor_set 0) {
  float Time;
}

///////////////////////////////////////////////////////////////
vertex_interface vif_my_depthprepass : ublk_std_matrices {
  inputs {
    vec4 position : POSITION;
  }
  outputs {
    float frg_depth;
  }
}
///////////////////////////////////////////////////////////////
vertex_interface vif_terrain : ublk_std_matrices {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec3 binormal : BINORMAL;
    vec4 vtxcolor : COLOR0;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_wpos;
    vec3 frg_mesh_bary;
    vec3 frg_displacement;
  }
}
///////////////////////////////////////////////////////////////
fragment_interface fif_terrain : ublk_frg_fwd_lighting {
  inputs {
    vec4 frg_wpos;
    vec3 frg_mesh_bary;
    vec3 frg_displacement;
  }
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
///////////////////////////////////////////////////////////////
typeblock typ_terrain_test {
  struct TerrainData {
    vec4 true_wpos;
    vec4 new_pos;
    vec3 signal;
    float radius;
  };
}
///////////////////////////////////////////////////////////////
libblock lib_ground_vtx_base : ub_frgX : typ_terrain_test {

  TerrainData vs_compute_position(vec3 pos) {
    TerrainData TD;
    mat4 matO2W   = inv_v * m;
    vec4 wave_pos = matO2W * vec4(pos, 1);
    float radius  = length(wave_pos.xz);

    TD.signal    = vec3(0);
    TD.true_wpos = wave_pos;
    TD.new_pos   = vec4(pos, 1);
    TD.radius    = radius;
    return TD;
  }
}

///////////////////////////////////////////////////////////////
vertex_shader vs_ground_mono
    : vif_terrain
    : lib_ground_vtx_base {
  vec4 cpos = v * position;

  TerrainData TD = vs_compute_position(position.xyz);

  frg_wpos         = TD.new_pos;
  frg_mesh_bary    = normal;
  frg_displacement = vec3(0);

  vec3 wnormal    = normalize(mrot * normal);
  vec3 wbitangent = normalize(mrot * binormal);
  vec3 wtangent   = cross(wbitangent, wnormal);

  gl_Position = mvp * TD.new_pos;
}
///////////////////////////////////////////////////////////////
vertex_shader vs_my_forward_depthprepass_mono
    : vif_my_depthprepass
    : lib_ground_vtx_base {
  TerrainData TD = vs_compute_position(position.xyz);
  vec4 new_pos   = TD.new_pos;
  vec4 hpos      = mvp * new_pos;
  gl_Position    = hpos;
  frg_depth      = (hpos.z) / (hpos.w - 0.05);
}
///////////////////////////////////////////////////////////////
fragment_shader ps_fwd_ground_mono : fif_terrain : ub_frgX {
  vec3 bary = frg_mesh_bary;
  out_color = vec4(bary, 1);
}
///////////////////////////////////////////////////////////////
technique FWD_DEPTHPREPASS_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_my_forward_depthprepass_mono;
    fragment_shader = ps_forward_depthprepass_mono;
    state_block = sb_default;
  }
}
///////////////////////////////////////////////////////////////
technique FWD_CT_NM_RI_NI_MO {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader = vs_ground_mono;
    fragment_shader = ps_fwd_ground_mono;
    state_block = sb_default;
  }
}
