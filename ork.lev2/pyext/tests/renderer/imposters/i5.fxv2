import "orkshader://stdtools.i2";
//import "orkshader://pbrtools.i2";
//import "orkshader://mathtools.i2";
//import "orkshader://sdftools.i2";
//import "orkshader://misctools.i2";

////////////////////////////////////////
fxconfig fxcfg_default {
}
////////////////////////////////////////
sampler_set i5_samplers (descriptor_set 0) {
  sampler2D rtgtex;
  sampler2D depthtex;
}/*
////////////////////////////////////////
uniform_block ublk_frg_i4 (descriptor_set 0) { //
  float time;
  vec3 raydir;
}*/
vertex_interface vif_I5 : ub_std_vtx {
  inputs {
    vec4 position : POSITION;
    vec3 normal : NORMAL;
    vec2 uv0 : TEXCOORD0;
  }
  outputs {
    vec4 frg_wpos;
    vec2 frg_uv0;
  }
}
////////////////////////////////////////
fragment_interface fif_I5 : vif_I5 {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
////////////////////////////////////////
vertex_shader vs_I5    //
  : vif_I5            //
  : ublk_std_matrices { //
  frg_wpos    = (m * position);
  frg_uv0     = uv0;
  gl_Position = mvp * position;
}
