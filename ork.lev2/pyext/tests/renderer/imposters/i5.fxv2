////////////////////////////////////////
state_block sb_i5 : default {
  BlendMode = ADDITIVE;
}
////////////////////////////////////////
technique tek_imp {
  fxconfig = fxcfg_default;
  vf_pass = { vs_I5, ps_I5, sb_i5 }
}
