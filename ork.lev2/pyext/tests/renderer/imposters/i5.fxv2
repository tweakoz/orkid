////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "410";
  import "orkshader://stdtools.i2";
}
///////////////////////////////////////////////////////////////
vertex_interface vif_PNT {
  inputs {
    vec4 position : POSITION;
    vec3 normal   : NORMAL;
    vec2 uv0      : TEXCOORD0;
  }
  outputs {
    vec2 frg_uv0;
    vec3 frg_opos;
    vec3 frg_wpos;
    vec3 frg_clr;
  }
}
////////////////////////////////////////
fragment_interface fif_PNT : vif_PNT {
  outputs {
    layout(location = 0) vec4 out_color;
  }
}
////////////////////////////////////////
uniform_set uset_frg_i4    //
    : uset_std_viewport    //
    : uset_std_filtering { //
  float time;
  vec3 raydir;
}
////////////////////////////////////////
sampler_set ss_frg_i5(descriptor_set 0) {
  sampler2D rtgtex;
  sampler2D depthtex;
}
////////////////////////////////////////
vertex_shader vs_imp 
  : vif_PNT
  : ublk_std_matrices {
  frg_clr     = vec3(normalize(normal));
  //frg_opos    = position.xyz;
  //frg_uv0     = uv0;
  //frg_wpos    = (m*position).xyz;
  //gl_Position = mvp * position;
}
////////////////////////////////////////
libblock lib_X {       //

  float X(vec3 p) {
    return 1.0;
  }

}

////////////////////////////////////////
fragment_shader ps_imp      //
  : fif_PNT                 //
  : lib_X                   //
{                           //
  //gl_FragDepth = depthAtWpos(frg_wpos.xyz, vp);
  out_color = vec4(1,0,0,1);
}
////////////////////////////////////////
technique tek_imp {
  fxconfig = fxcfg_default;
  vf_pass={vs_imp, ps_imp, sb_default}
}

