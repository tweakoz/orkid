////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "410";
import "orkshader://fwdtools.i";
import "orkshader://sdftools.i";
import "orkshader://misctools.i";
}
////////////////////////////////////////
uniform_set uset_vtx : uset_std_matrices {
}
////////////////////////////////////////
uniform_set uset_frg_i4    //
    : uset_std_viewport    //
    : uset_std_filtering { //
  sampler2D rtgtex;
  sampler2D depthtex;
  float time;
  vec3 raydir;
}
////////////////////////////////////////
vertex_shader vs_imp : vif_PNT {
  frg_clr     = vec4(normalize(normal), 1); //+vec3(1))*0.5;
  frg_opos    = position.xyz;
  frg_uv0     = uv0;
  frg_wpos    = (m*position);
  gl_Position = mvp * position;
}
libblock lib_X        //
    : lib_sdftools    //
    : lib_mmnoise     //
    : lib_cellnoise { //

  float myWorldSDF(vec3 p) {
    float radius = sin(time*1.0) * 0.1 + 0.65; // oscillating radius
    vec3 sphere_center = m[3].xyz; // center of the sphere @ node position
    float sphere_dist = length(p - sphere_center) - radius;
    float angleXY = atan(p.y - sphere_center.y, p.x - sphere_center.x);
    float angleYZ = atan(p.y - sphere_center.y, p.z - sphere_center.z);
    float displacement = 0.0;
    displacement += sin(angleXY*10.0 + time * 1.5) * 0.1; // oscillating displacement
    displacement += -cos(angleYZ*3.0 + time * 2.7) * 0.1; // oscillating displacement
    sphere_dist += displacement; // apply displacement to the sphere distance
    return sphere_dist;
  }
  vec3 myWorldNormal(vec3 p) {
    // compute normal of myWorldSDF at point p
    float eps = 0.0001;
    vec3 n;
    n.x = myWorldSDF(vec3(p.x + eps, p.y, p.z)) - myWorldSDF(vec3(p.x - eps, p.y, p.z));
    n.y = myWorldSDF(vec3(p.x, p.y + eps, p.z)) - myWorldSDF(vec3(p.x, p.y - eps, p.z));
    n.z = myWorldSDF(vec3(p.x, p.y, p.z + eps)) - myWorldSDF(vec3(p.x, p.y, p.z - eps));
    return normalize(n);
  }
}
////////////////////////////////////////
fragment_shader ps_imp      //
    : fif_forward_min       //
    : lib_brdf              //
    : lib_def               //
    : lib_sdftools          //
    : lib_fwd_impl          //
    : uset_frg_fwd          //
    : ublk_frg_fwd_lighting //
    : uset_frg_i4           //
    : lib_X               { //

  float radius = sin(time*1.0) * 0.1 + 0.65; // oscillating radius
  vec3 sphere_center = m[3].xyz; // center of the sphere @ node position

  // raymarch sphere of radius 0.75

  vec3 rayori = frg_wpos.xyz; // surface of imposter sphere
  const float maxdist = 2.5;
  const float _EPSILON = 0.0005;
  const int MAX_STEPS = 500;
  float distance_travelled = 0.0;
  bool hit = false;

  vec3 p = rayori;
  for (int i = 0; i < MAX_STEPS; i++) {
    float sdf_distance = myWorldSDF(p);
    if (sdf_distance < _EPSILON) {
      hit = true;
      break;
    }
    if (distance_travelled > maxdist) {
      break;
    }
    float D = sdf_distance*0.01;
    p += raydir * D; 
    distance_travelled += D;    
  }
  if (!hit) {
    discard;
  }
  vec3 n = myWorldNormal(p); // normal at the surface
  float NN = 1.0+cellnoise(p*7)*0.5;

  PbrData pbr;
  pbr._emissive = false;
  pbr._albedo = n*0.05+vec3(0.95)*NN;
  pbr._metallic = 1.0;
  pbr._roughness = pow(n.y*0.5+0.5,2); // oscillating roughness
  pbr._wpos = p;
  pbr._wnrm = n;
  vec3 C = pbrEnvironmentLightingXXX(pbr, EyePostion);
  out_color = vec4(C*float(int(hit)), 1); // debug color
  gl_FragDepth = depthAtWpos(frg_wpos.xyz, vp);
}
////////////////////////////////////////
technique tek_imp {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_imp;
    fragment_shader = ps_imp;
    state_block     = default;
  }
}
