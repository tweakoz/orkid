////////////////////////////////////////
fxconfig fxcfg_default {
  glsl_version = "410";
import "orkshader://fwdtools.i";
import "orkshader://sdftools.i";
import "orkshader://misctools.i";
}
////////////////////////////////////////
uniform_set uset_vtx : uset_std_matrices {
}
////////////////////////////////////////
uniform_set uset_frg_i2    //
    : uset_std_viewport    //
    : uset_std_filtering { //
  sampler2D rtgtex;
  sampler2D fbtex;
  sampler2D depthtex;
  float time;
  vec3 raydir;
}
////////////////////////////////////////
vertex_shader vs_imp : vif_PNT {
  frg_clr     = vec4(normalize(normal), 1); //+vec3(1))*0.5;
  frg_opos    = position.xyz;
  frg_uv0     = uv0;
  frg_wpos    = (m*position);
  gl_Position = mvp * position;
}
////////////////////////////////////////
libblock lib_X        //
    : lib_sdftools    //
    : lib_mmnoise     //
    : lib_cellnoise { //

  float sampleNoise(vec3 p) {
    return 1;
  }

  vec3 calculateNormal(vec3 p) {
    const float h = 0.001;
    const vec2 k  = vec2(1, -1);
    return normalize(
        k.xyy * sampleNoise(p + k.xyy * h) + //
        k.yyx * sampleNoise(p + k.yyx * h) + //
        k.yxy * sampleNoise(p + k.yxy * h) + //
        k.xxx * sampleNoise(p + k.xxx * h));
  }
}
////////////////////////////////////////
fragment_shader ps_imp      //
    : fif_forward_min       //
    : lib_X                 //
    : lib_brdf              //
    : lib_def               //
    : lib_fwd_impl          //
    : uset_frg_fwd          //
    : ublk_frg_fwd_lighting //
    : uset_frg_i2 {         //

  vec3 rayori = frg_wpos.xyz;

  // analytical intersection with sphere
  vec3 sphere_center = vec3(0, 0, 0);
  float sphere_radius = sin(time*20.0) * 0.15 + 0.65; // oscillating radius
  vec3 oc = rayori - sphere_center;
  float a = dot(raydir, raydir);
  float b = 2.0 * dot(oc, raydir);
  float c = dot(oc, oc) - sphere_radius * sphere_radius;
  float discriminant = b * b - 4.0 * a * c;
  if (discriminant < 0.0) {
    //discard; // no intersection
  }
  float t = (-b - sqrt(discriminant)) / (2.0 * a);
  if (t < 0.0) {
    //discard; // intersection behind the ray origin
  }
  /////////////////
  vec3 intersection = rayori + t * raydir;
  out_color = vec4(normalize(intersection), 1); // debug color
  gl_FragDepth = depthAtWpos(frg_wpos.xyz, vp);

}
////////////////////////////////////////
vertex_shader vs_upass : vif_PNT {
  frg_clr     = vec3(1, 0, 0);
  frg_pos     = pos.xyz;
  frg_uv0     = uv0;
  gl_Position = mvp * pos;
}
fragment_shader ps_upass : fif_forward_min {
  float Z = texture(depthtex, frg_uv0).r;
  if (Z > 0.9999)
    discard;
  vec2 warp_uv = ((frg_uv0 - vec2(0.5)) * 0.985) + vec2(0.5);
  vec3 rgb     = texture(rtgtex, frg_uv0).bgr * 0.05 + texture(fbtex, warp_uv).xyz * 0.9999999;
  float alp    = texture(rtgtex, frg_uv0).w;
  out_color    = vec4(rgb, alp);
  gl_FragDepth = Z;
}
////////////////////////////////////////
technique tek_imp {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_imp;
    fragment_shader = ps_imp;
    state_block     = default;
  }
}
////////////////////////////////////////
technique tek_upass {
  fxconfig = fxcfg_default;
  pass p0 {
    vertex_shader   = vs_upass;
    fragment_shader = ps_upass;
    state_block     = default;
  }
}