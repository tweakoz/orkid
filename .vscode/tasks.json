{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gdb-attach-reminder",
            "type": "shell",
            "command": "echo 'NOTE: GDB attach requires one-time setup:'; echo '  sudo setcap cap_sys_ptrace=eip /usr/bin/gdb'; echo '  echo \"set debuginfod enabled off\" >> ~/.gdbinit'",
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": false },
            "problemMatcher": []
        },
        {
            "label": "run-script",
            "type": "shell",
            "command": "ork.python ${input:scriptPath}",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.",
                    "endsPattern": "^."
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "scriptPath",
            "type": "promptString",
            "description": "Python script to run (relative to workspace)",
            "default": "ork.lev2/pyext/tests/renderer/lighting/probe.py"
        }
    ]
}