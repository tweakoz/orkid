{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) debug python script",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:OBT_SUBSPACE_BIN_DIR}/ork.python",
            "args": ["${input:scriptPath}"],
            "preLaunchTask": "gdb-attach-reminder",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "miDebuggerArgs": "--init-eval-command=\"set debuginfod enabled off\"",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                { "name": "PYTHONPATH", "value": "${env:OBT_STAGE}/pyvenv/lib/python3.12/site-packages:${env:PYTHONPATH}" },
                { "name": "LD_LIBRARY_PATH", "value": "${env:LD_LIBRARY_PATH}" },
                { "name": "OBT_STAGE", "value": "${env:OBT_STAGE}" },
                { "name": "PATH", "value": "${env:PATH}" },
                { "name": "DEBUGINFOD_URLS", "value": "" }
            ],
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set debuginfod enabled off\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set debug-file-directory \\\"\\\"\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set print thread-events off\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set follow-exec-mode same\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"source ${workspaceFolder}/obt.project/scripts/ork/ix_gdb_extensions.py\"", "ignoreFailures": false },
                { "text": "-interpreter-exec console \"source /usr/share/gcc/python/libstdcxx/v6/printers.py\"", "ignoreFailures": true }
            ]
        },
        {
            "name": "(gdb) debug orkid exe",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:OBT_SUBSPACE_BIN_DIR}/${input:exeName}",
            "args": [],
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                { "name": "ORKID_GRAPHICS_API", "value": "VULKAN" },
                { "name": "DISPLAY", "value": "${env:DISPLAY}" },
                { "name": "VULKAN_SDK", "value": "${env:VULKAN_SDK}" },
                { "name": "VK_LAYER_PATH", "value": "${env:VK_LAYER_PATH}" },
                { "name": "LD_LIBRARY_PATH", "value": "${env:LD_LIBRARY_PATH}" },
                { "name": "OBT_STAGE", "value": "${env:OBT_STAGE}" },
                { "name": "PATH", "value": "${env:PATH}" },
                { "name": "DEBUGINFOD_URLS", "value": "" }
            ],
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set debuginfod enabled off\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set debug-file-directory \\\"\\\"\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set print thread-events off\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set follow-exec-mode same\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"source ${workspaceFolder}/obt.project/scripts/ork/ix_gdb_extensions.py\"", "ignoreFailures": false },
                { "text": "-interpreter-exec console \"source /usr/share/gcc/python/libstdcxx/v6/printers.py\"", "ignoreFailures": true }
            ]
        },
        // One-time setup required for attach to work without sudo:
        //   sudo setcap cap_sys_ptrace=eip /usr/bin/gdb
        // Also ensure ~/.gdbinit contains: set debuginfod enabled off
        {
            "name": "(gdb) attach python script",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "${env:OBT_SUBSPACE_BIN_DIR}/ork.python",
            "preLaunchTask": "gdb-attach-reminder",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-nodebuginfod.sh",
            "miDebuggerArgs": "--init-eval-command=\"set debuginfod enabled off\"",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set debuginfod enabled off\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set fork-follow-mode child\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"set follow-exec-mode new\"", "ignoreFailures": true },
                { "text": "-interpreter-exec console \"source ${workspaceFolder}/obt.project/scripts/ork/ix_gdb_extensions.py\"", "ignoreFailures": false },
                { "text": "-interpreter-exec console \"source /usr/share/gcc/python/libstdcxx/v6/printers.py\"", "ignoreFailures": true }
            ]
        },
    ],
    "inputs": [
        {
            "id": "scriptPath",
            "type": "promptString",
            "description": "Python script to run (relative to workspace)",
            "default": "ork.lev2/pyext/tests/renderer/lighting/probe.py"
        },
        {
            "id": "exeName",
            "type": "promptString",
            "description": "Orkid executable name (in OBT_SUBSPACE_BIN_DIR)",
            "default": "ork.example.lev2.gfx.minimal3D.exe"
        }
    ]
}